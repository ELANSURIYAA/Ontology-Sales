  </owl:Class>

  <owl:Class rdf:about="http://example.org/ontology/sales#SalesRepresentative">
    <rdfs:label>Sales Representative</rdfs:label>
    <rdfs:comment>Stores sales representative attributes used to analyze bookings by seller identity, role, team, and covered segment.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/ontology/sales#Dimension"/>
    <sales:businessDefinition>Stores sales representative attributes used to analyze bookings by seller identity, role, team, and covered segment.</sales:businessDefinition>
    <sales:businessDomain>Sales</sales:businessDomain>
    <sales:sourceEntity>Sales Representative Dimension</sales:sourceEntity>
    <sales:sourceTable>quotetobooking.dim_sales_rep</sales:sourceTable>
