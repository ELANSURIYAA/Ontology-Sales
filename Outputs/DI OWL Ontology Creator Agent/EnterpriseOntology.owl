  <owl:ObjectProperty rdf:about="http://example.org/ontology/sales#hasCustomer">
    <rdfs:label>has customer</rdfs:label>
    <rdfs:comment>Associates a booking with the customer dimension referenced by the customer key.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology/sales#Booking"/>
    <rdfs:range rdf:resource="http://example.org/ontology/sales#Customer"/>
    <owl:inverseOf rdf:resource="http://example.org/ontology/sales#isCustomerForBooking"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <sales:businessDefinition>Foreign-key relationship linking a booking transaction to a customer.</sales:businessDefinition>
    <sales:sourceRelationship>fact_bookings.customer_key -&gt; dim_customer.customer_key</sales:sourceRelationship>
    <sales:sourceTable>quotetobooking.fact_bookings</sales:sourceTable>
    <sales:sourceEntity>Bookings Fact</sales:sourceEntity>
    <sales:sourceBusinessProcessDocument>Unavailable; derived from glossary foreign key semantics.</sales:sourceBusinessProcessDocument>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.org/ontology/sales#isCustomerForBooking">
    <rdfs:label>is customer for booking</rdfs:label>
    <rdfs:comment>Inverse relationship from customer to booking.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology/sales#Customer"/>
    <rdfs:range rdf:resource="http://example.org/ontology/sales#Booking"/>
    <sales:businessDefinition>Inverse of has customer.</sales:businessDefinition>
  </owl:ObjectProperty>

