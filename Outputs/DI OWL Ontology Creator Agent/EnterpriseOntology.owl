    <!-- Restrictions -->
    <owl:Class rdf:about="http://example.com/ontology/enterprise-sales-bookings#BookingTransaction">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.com/ontology/enterprise-sales-bookings#hasCustomer"/>
