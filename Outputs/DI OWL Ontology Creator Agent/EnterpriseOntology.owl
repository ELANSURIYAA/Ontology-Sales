  <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales#productId"><rdfs:label>product identifier</rdfs:label><rdfs:comment>Business identifier or SKU assigned to the product or offer.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontology/sales#Product"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><sourceTable xmlns="http://example.org/ontology/sales#">quotetobooking.dim_product</sourceTable><sourceColumn xmlns="http://example.org/ontology/sales#">product_id</sourceColumn><sourceAttribute xmlns="http://example.org/ontology/sales#">Product Identifier</sourceAttribute><businessDefinition xmlns="http://example.org/ontology/sales#">Business identifier or SKU assigned to the product or offer.</businessDefinition><businessDomain xmlns="http://example.org/ontology/sales#">Products</businessDomain></owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales#productName"><rdfs:label>product name</rdfs:label><rdfs:comment>Descriptive name of the product or solution being booked.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontology/sales#Product"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><sourceTable xmlns="http://example.org/ontology/sales#">quotetobooking.dim_product</sourceTable><sourceColumn xmlns="http://example.org/ontology/sales#">product_name</sourceColumn><sourceAttribute xmlns="http://example.org/ontology/sales#">Product Name</sourceAttribute><businessDefinition xmlns="http://example.org/ontology/sales#">Descriptive name of the product or solution being booked.</businessDefinition><businessDomain xmlns="http://example.org/ontology/sales#">Products</businessDomain></owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales#productFamily"><rdfs:label>product family</rdfs:label><rdfs:comment>Higher-level grouping of related products within the portfolio.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontology/sales#Product"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><sourceTable xmlns="http://example.org/ontology/sales#">quotetobooking.dim_product</sourceTable><sourceColumn xmlns="http://example.org/ontology/sales#">product_family</sourceColumn><sourceAttribute xmlns="http://example.org/ontology/sales#">Product Family</sourceAttribute><businessDefinition xmlns="http://example.org/ontology/sales#">Higher-level grouping of related products within the portfolio.</businessDefinition><businessDomain xmlns="http://example.org/ontology/sales#">Products</businessDomain></owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales#technologyDomain"><rdfs:label>technology domain</rdfs:label><rdfs:comment>Technology area or solution domain to which the product belongs.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontology/sales#Product"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><sourceTable xmlns="http://example.org/ontology/sales#">quotetobooking.dim_product</sourceTable><sourceColumn xmlns="http://example.org/ontology/sales#">technology_domain</sourceColumn><sourceAttribute xmlns="http://example.org/ontology/sales#">Technology Domain</sourceAttribute><businessDefinition xmlns="http://example.org/ontology/sales#">Technology area or solution domain to which the product belongs.</businessDefinition><businessDomain xmlns="http://example.org/ontology/sales#">Products</businessDomain></owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales#offerType"><rdfs:label>offer type</rdfs:label><rdfs:comment>Commercial offer classification, such as hardware, SaaS subscription, or software subscription.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontology/sales#Product"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><sourceTable xmlns="http://example.org/ontology/sales#">quotetobooking.dim_product</sourceTable><sourceColumn xmlns="http://example.org/ontology/sales#">offer_type</sourceColumn><sourceAttribute xmlns="http://example.org/ontology/sales#">Offer Type</sourceAttribute><businessDefinition xmlns="http://example.org/ontology/sales#">Commercial offer classification, such as hardware, SaaS subscription, or software subscription.</businessDefinition><businessDomain xmlns="http://example.org/ontology/sales#">Products</businessDomain></owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales#businessEntityName"><rdfs:label>business entity</rdfs:label><rdfs:comment>Internal business unit or portfolio grouping responsible for the product.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontology/sales#Product"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><sourceTable xmlns="http://example.org/ontology/sales#">quotetobooking.dim_product</sourceTable><sourceColumn xmlns="http://example.org/ontology/sales#">business_entity</sourceColumn><sourceAttribute xmlns="http://example.org/ontology/sales#">Business Entity</sourceAttribute><businessDefinition xmlns="http://example.org/ontology/sales#">Internal business unit or portfolio grouping responsible for the product.</businessDefinition><businessDomain xmlns="http://example.org/ontology/sales#">Products</businessDomain></owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales#salesRepKey"><rdfs:label>sales representative key</rdfs:label><rdfs:comment>Unique surrogate key for the sales representative record used to join seller details to booking transactions.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontology/sales#SalesRepresentative"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/><sourceTable xmlns="http://example.org/ontology/sales#">quotetobooking.dim_sales_rep</sourceTable><sourceColumn xmlns="http://example.org/ontology/sales#">sales_rep_key</sourceColumn><sourceAttribute xmlns="http://example.org/ontology/sales#">Sales Representative Key</sourceAttribute><businessDefinition xmlns="http://example.org/ontology/sales#">Unique surrogate key for the sales representative record used to join seller details to booking transactions.</businessDefinition><businessDomain xmlns="http://example.org/ontology/sales#">Sales</businessDomain></owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales#repId"><rdfs:label>sales representative identifier</rdfs:label><rdfs:comment>Business identifier assigned to the sales representative.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontology/sales#SalesRepresentative"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><sourceTable xmlns="http://example.org/ontology/sales#">quotetobooking.dim_sales_rep</sourceTable><sourceColumn xmlns="http://example.org/ontology/sales#">rep_id</sourceColumn><sourceAttribute xmlns="http://example.org/ontology/sales#">Sales Representative Identifier</sourceAttribute><businessDefinition xmlns="http://example.org/ontology/sales#">Business identifier assigned to the sales representative.</businessDefinition><businessDomain xmlns="http://example.org/ontology/sales#">Sales</businessDomain></owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales#repName"><rdfs:label>sales representative name</rdfs:label><rdfs:comment>Full name of the sales representative associated with the booking.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontology/sales#SalesRepresentative"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><sourceTable xmlns="http://example.org/ontology/sales#">quotetobooking.dim_sales_rep</sourceTable><sourceColumn xmlns="http://example.org/ontology/sales#">rep_name</sourceColumn><sourceAttribute xmlns="http://example.org/ontology/sales#">Sales Representative Name</sourceAttribute><businessDefinition xmlns="http://example.org/ontology/sales#">Full name of the sales representative associated with the booking.</businessDefinition><businessDomain xmlns="http://example.org/ontology/sales#">Sales</businessDomain></owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales#salesRole"><rdfs:label>sales role</rdfs:label><rdfs:comment>Job role or selling responsibility of the sales representative.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontology/sales#SalesRepresentative"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><sourceTable xmlns="http://example.org/ontology/sales#">quotetobooking.dim_sales_rep</sourceTable><sourceColumn xmlns="http://example.org/ontology/sales#">sales_role</sourceColumn><sourceAttribute xmlns="http://example.org/ontology/sales#">Sales Role</sourceAttribute><businessDefinition xmlns="http://example.org/ontology/sales#">Job role or selling responsibility of the sales representative.</businessDefinition><businessDomain xmlns="http://example.org/ontology/sales#">Sales</businessDomain></owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales#salesTeam"><rdfs:label>sales team</rdfs:label><rdfs:comment>Sales team or organizational unit to which the sales representative belongs.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontology/sales#SalesRepresentative"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><sourceTable xmlns="http://example.org/ontology/sales#">quotetobooking.dim_sales_rep</sourceTable><sourceColumn xmlns="http://example.org/ontology/sales#">sales_team</sourceColumn><sourceAttribute xmlns="http://example.org/ontology/sales#">Sales Team</sourceAttribute><businessDefinition xmlns="http://example.org/ontology/sales#">Sales team or organizational unit to which the sales representative belongs.</businessDefinition><businessDomain xmlns="http://example.org/ontology/sales#">Sales</businessDomain></owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales#segmentCovered"><rdfs:label>covered segment</rdfs:label><rdfs:comment>Customer segment or market segment covered by the sales representative.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontology/sales#SalesRepresentative"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><sourceTable xmlns="http://example.org/ontology/sales#">quotetobooking.dim_sales_rep</sourceTable><sourceColumn xmlns="http://example.org/ontology/sales#">segment_covered</sourceColumn><sourceAttribute xmlns="http://example.org/ontology/sales#">Covered Segment</sourceAttribute><businessDefinition xmlns="http://example.org/ontology/sales#">Customer segment or market segment covered by the sales representative.</businessDefinition><businessDomain xmlns="http://example.org/ontology/sales#">Sales</businessDomain></owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales#bookingId"><rdfs:label>booking identifier</rdfs:label><rdfs:comment>Unique identifier for the booking transaction record.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontology/sales#Booking"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/><sourceTable xmlns="http://example.org/ontology/sales#">quotetobooking.fact_bookings</sourceTable><sourceColumn xmlns="http://example.org/ontology/sales#">booking_id</sourceColumn><sourceAttribute xmlns="http://example.org/ontology/sales#">Booking Identifier</sourceAttribute><businessDefinition xmlns="http://example.org/ontology/sales#">Unique identifier for the booking transaction record.</businessDefinition><businessDomain xmlns="http://example.org/ontology/sales#">Sales Transactions</businessDomain></owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales#orderNumber"><rdfs:label>order number</rdfs:label><rdfs:comment>Business order number associated with the booking transaction.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontology/sales#Booking"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><sourceTable xmlns="http://example.org/ontology/sales#">quotetobooking.fact_bookings</sourceTable><sourceColumn xmlns="http://example.org/ontology/sales#">order_number</sourceColumn><sourceAttribute xmlns="http://example.org/ontology/sales#">Order Number</sourceAttribute><businessDefinition xmlns="http://example.org/ontology/sales#">Business order number associated with the booking transaction.</businessDefinition><businessDomain xmlns="http://example.org/ontology/sales#">Sales Transactions</businessDomain></owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales#orderLineNumber"><rdfs:label>order line number</rdfs:label><rdfs:comment>Line number within the order identifying the specific booked item or service.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontology/sales#Booking"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/><sourceTable xmlns="http://example.org/ontology/sales#">quotetobooking.fact_bookings</sourceTable><sourceColumn xmlns="http://example.org/ontology/sales#">order_line_number</sourceColumn><sourceAttribute xmlns="http://example.org/ontology/sales#">Order Line Number</sourceAttribute><businessDefinition xmlns="http://example.org/ontology/sales#">Line number within the order identifying the specific booked item or service.</businessDefinition><businessDomain xmlns="http://example.org/ontology/sales#">Sales Transactions</businessDomain></owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales#bookingType"><rdfs:label>booking type</rdfs:label><rdfs:comment>Indicates whether the booking is a new sale or a renewal.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontology/sales#Booking"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><sourceTable xmlns="http://example.org/ontology/sales#">quotetobooking.fact_bookings</sourceTable><sourceColumn xmlns="http://example.org/ontology/sales#">booking_type</sourceColumn><sourceAttribute xmlns="http://example.org/ontology/sales#">Booking Type</sourceAttribute><businessDefinition xmlns="http://example.org/ontology/sales#">Indicates whether the booking is a new sale or a renewal.</businessDefinition><businessDomain xmlns="http://example.org/ontology/sales#">Sales Transactions</businessDomain></owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales#isRenewal"><rdfs:label>renewal indicator</rdfs:label><rdfs:comment>Indicates whether the booking transaction is a renewal record, typically using 1 for yes and 0 for no.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontology/sales#Booking"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/><sourceTable xmlns="http://example.org/ontology/sales#">quotetobooking.fact_bookings</sourceTable><sourceColumn xmlns="http://example.org/ontology/sales#">is_renewal</sourceColumn><sourceAttribute xmlns="http://example.org/ontology/sales#">Renewal Indicator</sourceAttribute><businessDefinition xmlns="http://example.org/ontology/sales#">Indicates whether the booking transaction is a renewal record, typically using 1 for yes and 0 for no.</businessDefinition><businessDomain xmlns="http://example.org/ontology/sales#">Sales Transactions</businessDomain></owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales#quantity"><rdfs:label>quantity</rdfs:label><rdfs:comment>Number of units, licenses, or items included in the booking line.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontology/sales#Booking"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/><sourceTable xmlns="http://example.org/ontology/sales#">quotetobooking.fact_bookings</sourceTable><sourceColumn xmlns="http://example.org/ontology/sales#">quantity</sourceColumn><sourceAttribute xmlns="http://example.org/ontology/sales#">Quantity</sourceAttribute><businessDefinition xmlns="http://example.org/ontology/sales#">Number of units, licenses, or items included in the booking line.</businessDefinition><businessDomain xmlns="http://example.org/ontology/sales#">Sales Transactions</businessDomain></owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales#unitListPriceUSD"><rdfs:label>unit list price usd</rdfs:label><rdfs:comment>Standard list price per unit in US dollars before discount.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontology/sales#Booking"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/><sourceTable xmlns="http://example.org/ontology/sales#">quotetobooking.fact_bookings</sourceTable><sourceColumn xmlns="http://example.org/ontology/sales#">unit_list_price_usd</sourceColumn><sourceAttribute xmlns="http://example.org/ontology/sales#">Unit List Price USD</sourceAttribute><businessDefinition xmlns="http://example.org/ontology/sales#">Standard list price per unit in US dollars before discount.</businessDefinition><businessDomain xmlns="http://example.org/ontology/sales#">Pricing</businessDomain><metricDefinition xmlns="http://example.org/ontology/sales#">Pricing measure associated with booking line valuation.</metricDefinition></owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales#discountPct"><rdfs:label>discount percentage</rdfs:label><rdfs:comment>Discount rate applied to the booked item relative to list price.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontology/sales#Booking"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/><sourceTable xmlns="http://example.org/ontology/sales#">quotetobooking.fact_bookings</sourceTable><sourceColumn xmlns="http://example.org/ontology/sales#">discount_pct</sourceColumn><sourceAttribute xmlns="http://example.org/ontology/sales#">Discount Percentage</sourceAttribute><businessDefinition xmlns="http://example.org/ontology/sales#">Discount rate applied to the booked item relative to list price.</businessDefinition><businessDomain xmlns="http://example.org/ontology/sales#">Pricing</businessDomain><metricDefinition xmlns="http://example.org/ontology/sales#">Pricing metric representing discount rate applied to a booking line.</metricDefinition></owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales#bookingAmountUSD"><rdfs:label>booking amount usd</rdfs:label><rdfs:comment>Total booked revenue amount in US dollars after pricing and discount considerations.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontology/sales#Booking"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/><sourceTable xmlns="http://example.org/ontology/sales#">quotetobooking.fact_bookings</sourceTable><sourceColumn xmlns="http://example.org/ontology/sales#">booking_amount_usd</sourceColumn><sourceAttribute xmlns="http://example.org/ontology/sales#">Booking Amount USD</sourceAttribute><businessDefinition xmlns="http://example.org/ontology/sales#">Total booked revenue amount in US dollars after pricing and discount considerations.</businessDefinition><businessDomain xmlns="http://example.org/ontology/sales#">Revenue</businessDomain><metricDefinition xmlns="http://example.org/ontology/sales#">Primary booking revenue metric in USD.</metricDefinition></owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales#acvUSD"><rdfs:label>annual contract value usd</rdfs:label><rdfs:comment>Annualized contract value of the booking in US dollars.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontology/sales#Booking"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/><sourceTable xmlns="http://example.org/ontology/sales#">quotetobooking.fact_bookings</sourceTable><sourceColumn xmlns="http://example.org/ontology/sales#">acv_usd</sourceColumn><sourceAttribute xmlns="http://example.org/ontology/sales#">Annual Contract Value USD</sourceAttribute><businessDefinition xmlns="http://example.org/ontology/sales#">Annualized contract value of the booking in US dollars.</businessDefinition><businessDomain xmlns="http://example.org/ontology/sales#">Revenue</businessDomain><metricDefinition xmlns="http://example.org/ontology/sales#">Annual Contract Value metric in USD.</metricDefinition></owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales#tcvUSD"><rdfs:label>total contract value usd</rdfs:label><rdfs:comment>Total contract value of the booking in US dollars across the full contract term.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontology/sales#Booking"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/><sourceTable xmlns="http://example.org/ontology/sales#">quotetobooking.fact_bookings</sourceTable><sourceColumn xmlns="http://example.org/ontology/sales#">tcv_usd</sourceColumn><sourceAttribute xmlns="http://example.org/ontology/sales#">Total Contract Value USD</sourceAttribute><businessDefinition xmlns="http://example.org/ontology/sales#">Total contract value of the booking in US dollars across the full contract term.</businessDefinition><businessDomain xmlns="http://example.org/ontology/sales#">Revenue</businessDomain><metricDefinition xmlns="http://example.org/ontology/sales#">Total Contract Value metric in USD.</metricDefinition></owl:DatatypeProperty>

</rdf:RDF>