  <owl:NamedIndividual rdf:about="#attr_acv_usd"><rdf:type rdf:resource="#Attribute"/><rdfs:label>Annual Contract Value USD</rdfs:label><rdfs:comment>Annualized value of the contract associated with the booking in U.S. dollars.</rdfs:comment><sourceEntity>Booking Transaction</sourceEntity><sourceTable>QuoteToBooking.fact_bookings</sourceTable><sourceColumn>acv_usd</sourceColumn><businessDefinition>Annualized value of the contract associated with the booking in U.S. dollars.</businessDefinition><dataType>numeric</dataType></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#attr_tcv_usd"><rdf:type rdf:resource="#Attribute"/><rdfs:label>Total Contract Value USD</rdfs:label><rdfs:comment>Total value of the full contract associated with the booking in U.S. dollars.</rdfs:comment><sourceEntity>Booking Transaction</sourceEntity><sourceTable>QuoteToBooking.fact_bookings</sourceTable><sourceColumn>tcv_usd</sourceColumn><businessDefinition>Total value of the full contract associated with the booking in U.S. dollars.</businessDefinition><dataType>numeric</dataType></owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="#measure_quantity_sold"><rdf:type rdf:resource="#Measure"/><rdfs:label>Quantity Sold</rdfs:label><rdfs:comment>Number of units, licenses, or subscriptions included in the booking transaction.</rdfs:comment><sourceEntity>Booking Transaction</sourceEntity><sourceTable>QuoteToBooking.fact_bookings</sourceTable><sourceColumn>quantity</sourceColumn><businessDefinition>Number of units, licenses, or subscriptions included in the booking transaction.</businessDefinition><dataType>numeric</dataType><aggregationType>SUM</aggregationType></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#measure_unit_list_price_usd"><rdf:type rdf:resource="#Measure"/><rdfs:label>Unit List Price USD</rdfs:label><rdfs:comment>Standard list price per unit in U.S. dollars before discounts are applied.</rdfs:comment><sourceEntity>Booking Transaction</sourceEntity><sourceTable>QuoteToBooking.fact_bookings</sourceTable><sourceColumn>unit_list_price_usd</sourceColumn><businessDefinition>Standard list price per unit in U.S. dollars before discounts are applied.</businessDefinition><dataType>numeric</dataType><aggregationType>SUM</aggregationType></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#measure_discount_percentage"><rdf:type rdf:resource="#Measure"/><rdfs:label>Discount Percentage</rdfs:label><rdfs:comment>Percentage discount applied to the list price for the booking transaction.</rdfs:comment><sourceEntity>Booking Transaction</sourceEntity><sourceTable>QuoteToBooking.fact_bookings</sourceTable><sourceColumn>discount_pct</sourceColumn><businessDefinition>Percentage discount applied to the list price for the booking transaction.</businessDefinition><dataType>numeric</dataType><aggregationType>AVG</aggregationType></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#measure_booking_amount_usd"><rdf:type rdf:resource="#Measure"/><rdfs:label>Booking Amount USD</rdfs:label><rdfs:comment>Total booked revenue amount for the transaction in U.S. dollars after pricing adjustments.</rdfs:comment><sourceEntity>Booking Transaction</sourceEntity><sourceTable>QuoteToBooking.fact_bookings</sourceTable><sourceColumn>booking_amount_usd</sourceColumn><businessDefinition>Total booked revenue amount for the transaction in U.S. dollars after pricing adjustments.</businessDefinition><dataType>numeric</dataType><aggregationType>SUM</aggregationType></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#measure_acv_usd"><rdf:type rdf:resource="#Measure"/><rdfs:label>Annual Contract Value USD</rdfs:label><rdfs:comment>Annualized value of the contract associated with the booking in U.S. dollars.</rdfs:comment><sourceEntity>Booking Transaction</sourceEntity><sourceTable>QuoteToBooking.fact_bookings</sourceTable><sourceColumn>acv_usd</sourceColumn><businessDefinition>Annualized value of the contract associated with the booking in U.S. dollars.</businessDefinition><dataType>numeric</dataType><aggregationType>SUM</aggregationType></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#measure_tcv_usd"><rdf:type rdf:resource="#Measure"/><rdfs:label>Total Contract Value USD</rdfs:label><rdfs:comment>Total value of the full contract associated with the booking in U.S. dollars.</rdfs:comment><sourceEntity>Booking Transaction</sourceEntity><sourceTable>QuoteToBooking.fact_bookings</sourceTable><sourceColumn>tcv_usd</sourceColumn><businessDefinition>Total value of the full contract associated with the booking in U.S. dollars.</businessDefinition><dataType>numeric</dataType><aggregationType>SUM</aggregationType></owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="#rule_completed_booking_transaction"><rdf:type rdf:resource="#BusinessRule"/><rdfs:label>Completed Booking Transaction</rdfs:label><rdfs:comment>A booking transaction represents a completed sales booking transaction linked to core dimensions.</rdfs:comment><sourceEntity>Booking Transaction</sourceEntity><semanticDefinition>Derived from the OSI semantic model description of fact_bookings as completed sales booking transactions linked to customer, product, partner, geography, sales representative, contract, and date.</semanticDefinition></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#rule_new_or_renewal_booking"><rdf:type rdf:resource="#BusinessRule"/><rdfs:label>New or Renewal Booking</rdfs:label><rdfs:comment>Booking Type indicates whether the booking is a new sale or a renewal.</rdfs:comment><sourceEntity>Booking Transaction</sourceEntity><semanticDefinition>Derived from the booking_type attribute in the OSI semantic model.</semanticDefinition></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#rule_one_dimension_member_per_booking"><rdf:type rdf:resource="#BusinessRule"/><rdfs:label>One Dimension Member Per Booking Link</rdfs:label><rdfs:comment>Each booking transaction is modeled with at most one linked member for each core dimension relationship.</rdfs:comment><sourceEntity>Booking Transaction</sourceEntity><semanticDefinition>Derived from one-to-many foreign key relationships from each dimension to booking transactions.</semanticDefinition></owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="#glossary_contract"><rdf:type rdf:resource="#GlossaryTerm"/><rdfs:label>Contract</rdfs:label><rdfs:comment>Stores the business attributes of commercial agreements associated with bookings, including contract type, term, renewal behavior, and support coverage level.</rdfs:comment><sourceEntity>Contract</sourceEntity><semanticDefinition>Stores the business attributes of commercial agreements associated with bookings, including contract type, term, renewal behavior, and support coverage level.</semanticDefinition></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#glossary_customer"><rdf:type rdf:resource="#GlossaryTerm"/><rdfs:label>Customer</rdfs:label><rdfs:comment>Stores descriptive information about customers that place orders and generate bookings, including segment, industry, account tier, and headquarters location.</rdfs:comment><sourceEntity>Customer</sourceEntity><semanticDefinition>Stores descriptive information about customers that place orders and generate bookings, including segment, industry, account tier, and headquarters location.</semanticDefinition></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#glossary_date"><rdf:type rdf:resource="#GlossaryTerm"/><rdfs:label>Date</rdfs:label><rdfs:comment>Stores calendar and fiscal date attributes used to analyze bookings over time.</rdfs:comment><sourceEntity>Date</sourceEntity><semanticDefinition>Stores calendar and fiscal date attributes used to analyze bookings over time.</semanticDefinition></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#glossary_geography"><rdf:type rdf:resource="#GlossaryTerm"/><rdfs:label>Geography</rdfs:label><rdfs:comment>Stores geographic attributes used to analyze bookings by sales region, theater, and country.</rdfs:comment><sourceEntity>Geography</sourceEntity><semanticDefinition>Stores geographic attributes used to analyze bookings by sales region, theater, and country.</semanticDefinition></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#glossary_partner"><rdf:type rdf:resource="#GlossaryTerm"/><rdfs:label>Partner</rdfs:label><rdfs:comment>Stores information about channel and direct partners involved in the sales process, including partner type, partner tier, and route to market.</rdfs:comment><sourceEntity>Partner</sourceEntity><semanticDefinition>Stores information about channel and direct partners involved in the sales process, including partner type, partner tier, and route to market.</semanticDefinition></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#glossary_product"><rdf:type rdf:resource="#GlossaryTerm"/><rdfs:label>Product</rdfs:label><rdfs:comment>Stores descriptive information about products and offers sold to customers, including product family, technology domain, offer type, and business entity.</rdfs:comment><sourceEntity>Product</sourceEntity><semanticDefinition>Stores descriptive information about products and offers sold to customers, including product family, technology domain, offer type, and business entity.</semanticDefinition></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#glossary_sales_representative"><rdf:type rdf:resource="#GlossaryTerm"/><rdfs:label>Sales Representative</rdfs:label><rdfs:comment>Stores information about sales personnel responsible for managing customer relationships and booking transactions.</rdfs:comment><sourceEntity>Sales Representative</sourceEntity><semanticDefinition>Stores information about sales personnel responsible for managing customer relationships and booking transactions.</semanticDefinition></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#glossary_booking_transaction"><rdf:type rdf:resource="#GlossaryTerm"/><rdfs:label>Booking Transaction</rdfs:label><rdfs:comment>Stores individual completed sales booking transactions with related financial measures and links to customer, product, partner, geography, sales representative, contract, and date dimensions.</rdfs:comment><sourceEntity>Booking Transaction</sourceEntity><semanticDefinition>Stores individual completed sales booking transactions with related financial measures and links to customer, product, partner, geography, sales representative, contract, and date dimensions.</semanticDefinition></owl:NamedIndividual>

