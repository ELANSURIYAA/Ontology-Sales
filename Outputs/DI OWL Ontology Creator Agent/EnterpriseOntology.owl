  </owl:Class>

  <owl:Class rdf:about="http://example.org/ontology/sales#Booking">
    <rdfs:label>Booking</rdfs:label>
    <rdfs:comment>Stores transactional booking records for customer orders, including associated dimensions, quantities, pricing, discounts, and contract value metrics.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/ontology/sales#Fact"/>
    <rdfs:subClassOf rdf:resource="http://example.org/ontology/sales#Transaction"/>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://example.org/ontology/sales#hasCustomer"/>
        <owl:someValuesFrom rdf:resource="http://example.org/ontology/sales#Customer"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://example.org/ontology/sales#hasProduct"/>
        <owl:someValuesFrom rdf:resource="http://example.org/ontology/sales#Product"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://example.org/ontology/sales#hasDate"/>
        <owl:someValuesFrom rdf:resource="http://example.org/ontology/sales#Date"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://example.org/ontology/sales#hasCustomer"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onClass rdf:resource="http://example.org/ontology/sales#Customer"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://example.org/ontology/sales#hasProduct"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onClass rdf:resource="http://example.org/ontology/sales#Product"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://example.org/ontology/sales#hasDate"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onClass rdf:resource="http://example.org/ontology/sales#Date"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <sales:businessDefinition>Stores transactional booking records for customer orders, including associated dimensions, quantities, pricing, discounts, and contract value metrics.</sales:businessDefinition>
    <sales:businessDomain>Sales Transactions</sales:businessDomain>
    <sales:sourceEntity>Bookings Fact</sales:sourceEntity>
    <sales:sourceTable>quotetobooking.fact_bookings</sales:sourceTable>
    <sales:metricDefinition>Booking Amount USD, Annual Contract Value USD, and Total Contract Value USD are represented as business measures associated with Booking.</sales:metricDefinition>
    <sales:sourceGlossary>Outputs/DI Glossary Creator Agent/business_glossary_data_dictionary.md</sales:sourceGlossary>
  </owl:Class>

