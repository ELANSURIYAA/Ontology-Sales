    <owl:DatatypeProperty rdf:about="#orderNumber"><rdfs:label>Order Number</rdfs:label><rdfs:comment>Business order number associated with the booking transaction. Source Table: QuoteToBooking.fact_bookings. Source Column: order_number. Business Definition: Business order number associated with the booking transaction.</rdfs:comment><rdfs:domain rdf:resource="#BookingTransaction"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/></owl:DatatypeProperty>
