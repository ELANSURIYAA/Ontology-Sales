  <owl:Class rdf:about="http://example.org/ontology/sales-bookings#BookingTransaction">
    <rdfs:label>Booking Transaction</rdfs:label>
    <rdfs:comment>Captures individual completed sales booking transactions and their associated financial measures, quantities, renewal status, and links to related business dimensions.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/ontology/sales-bookings#Transaction"/>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://example.org/ontology/sales-bookings#hasCustomer"/>
        <owl:someValuesFrom rdf:resource="http://example.org/ontology/sales-bookings#Customer"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://example.org/ontology/sales-bookings#hasProduct"/>
        <owl:someValuesFrom rdf:resource="http://example.org/ontology/sales-bookings#Product"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://example.org/ontology/sales-bookings#hasBookingDate"/>
        <owl:someValuesFrom rdf:resource="http://example.org/ontology/sales-bookings#Date"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://example.org/ontology/sales-bookings#hasCustomer"/>
        <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://example.org/ontology/sales-bookings#hasProduct"/>
        <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://example.org/ontology/sales-bookings#hasBookingDate"/>
        <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
    <skos:definition>Captures individual completed sales booking transactions and their associated financial measures, quantities, renewal status, and links to related business dimensions.</skos:definition>
    <onto:businessDefinition>Captures individual completed sales booking transactions and their associated financial measures, quantities, renewal status, and links to related business dimensions.</onto:businessDefinition>
    <onto:businessDomain>Sales Bookings and Revenue Analytics</onto:businessDomain>
    <onto:businessCategory>Sales Performance</onto:businessCategory>
    <onto:sourceEntity>Booking Transaction</onto:sourceEntity>
    <onto:sourceTable>quotetobooking.fact_bookings</onto:sourceTable>
    <onto:sourceGlossary>Outputs/DI Glossary Creator Agent/business_glossary_data_dictionary.md</onto:sourceGlossary>
    <onto:metricDefinition>booking_amount_usd: Total booked sales amount in US dollars after pricing and discount adjustments.</onto:metricDefinition>
    <onto:metricDefinition>acv_usd: Annualized contract value of the booking in US dollars.</onto:metricDefinition>
    <onto:metricDefinition>tcv_usd: Total contract value of the booking over the full contract term in US dollars.</onto:metricDefinition>
  </owl:Class>

  <owl:ObjectProperty rdf:about="http://example.org/ontology/sales-bookings#hasBookingDate">
    <rdfs:label>has booking date</rdfs:label>
    <rdfs:comment>Links a booking transaction to the date dimension record used for reporting.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings#BookingTransaction"/>
    <rdfs:range rdf:resource="http://example.org/ontology/sales-bookings#Date"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <onto:businessDefinition>Foreign key linking the booking transaction to the reporting date dimension.</onto:businessDefinition>
    <onto:sourceRelationship>fact_bookings.date_key -&gt; dim_date.date_key</onto:sourceRelationship>
    <onto:sourceTable>quotetobooking.fact_bookings</onto:sourceTable>
    <onto:sourceColumn>date_key</onto:sourceColumn>
    <onto:sourceGlossary>Outputs/DI Glossary Creator Agent/business_glossary_data_dictionary.md</onto:sourceGlossary>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.org/ontology/sales-bookings#isBookingDateOf">
    <rdfs:label>is booking date of</rdfs:label>
    <rdfs:comment>Inverse relationship from date to booking transaction.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings#Date"/>
    <rdfs:range rdf:resource="http://example.org/ontology/sales-bookings#BookingTransaction"/>
    <owl:inverseOf rdf:resource="http://example.org/ontology/sales-bookings#hasBookingDate"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.org/ontology/sales-bookings#hasCustomer">
    <rdfs:label>has customer</rdfs:label>
    <rdfs:comment>Links a booking transaction to the customer associated with the booking.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings#BookingTransaction"/>
