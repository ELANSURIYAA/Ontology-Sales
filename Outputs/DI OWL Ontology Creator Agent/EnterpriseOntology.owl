    <onto:sourceTable>quotetobooking.fact_bookings</onto:sourceTable>
    <onto:sourceColumn>customer_key</onto:sourceColumn>
    <onto:sourceGlossary>Outputs/DI Glossary Creator Agent/business_glossary_data_dictionary.md</onto:sourceGlossary>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.org/ontology/sales-bookings#isCustomerOfBooking">
    <rdfs:label>is customer of booking</rdfs:label>
    <rdfs:comment>Inverse relationship from customer to booking transaction.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings#Customer"/>
    <rdfs:range rdf:resource="http://example.org/ontology/sales-bookings#BookingTransaction"/>
