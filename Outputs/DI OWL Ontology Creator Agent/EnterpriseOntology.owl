  <owl:Ontology rdf:about="http://example.org/ontology/sales-bookings-revenue">
    <rdfs:label xml:lang="en">Enterprise Sales Bookings and Revenue Ontology</rdfs:label>
    <rdfs:comment xml:lang="en">OWL 2 ontology generated from the OSI Semantic Model for Sales Bookings and Revenue Analytics and enriched where possible from the QuoteToBooking business process input. The business process document could not be decoded from the provided repository path, so ontology generation is based on the validated OSI Semantic Model and explicit relationship semantics available therein.</rdfs:comment>
    <owl:versionInfo>1.0.0</owl:versionInfo>
    <dc:source>Outputs/DI OSI Semantic Creator Agent/OSI Semantic Model.md</dc:source>
    <dc:source>Inputs/QuoteToBooking.docx</dc:source>
    <dcterms:created>2026-07-28</dcterms:created>
    <dcterms:title>EnterpriseOntology.owl</dcterms:title>
    <dcterms:description>GraphDB-compatible RDF/XML ontology representing business entities, relationships, attributes, measures, and semantic constraints for quote-to-booking sales analytics.</dcterms:description>
  </owl:Ontology>

