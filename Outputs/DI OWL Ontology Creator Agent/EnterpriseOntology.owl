      <rdf:Description rdf:about="http://example.org/ontology/sales-bookings-revenue#SalesRepresentative"/>
      <rdf:Description rdf:about="http://example.org/ontology/sales-bookings-revenue#BookingTransaction"/>
    </owl:members>
  </owl:AllDisjointClasses>

  <owl:ObjectProperty rdf:about="http://example.org/ontology/sales-bookings-revenue#hasContract">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings-revenue#BookingTransaction"/>
    <rdfs:range rdf:resource="http://example.org/ontology/sales-bookings-revenue#Contract"/>
    <owl:inverseOf rdf:resource="http://example.org/ontology/sales-bookings-revenue#isContractOfBooking"/>
    <rdfs:label>has contract</rdfs:label>
    <rdfs:comment>Relates a booking transaction to the contract associated with that booking.</rdfs:comment>
    <enterprise:sourceRelationship>REL001</enterprise:sourceRelationship>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.org/ontology/sales-bookings-revenue#isContractOfBooking">
    <rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings-revenue#Contract"/>
    <rdfs:range rdf:resource="http://example.org/ontology/sales-bookings-revenue#BookingTransaction"/>
    <rdfs:label>is contract of booking</rdfs:label>
    <rdfs:comment>Inverse of has contract.</rdfs:comment>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.org/ontology/sales-bookings-revenue#hasCustomer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings-revenue#BookingTransaction"/>
    <rdfs:range rdf:resource="http://example.org/ontology/sales-bookings-revenue#Customer"/>
    <owl:inverseOf rdf:resource="http://example.org/ontology/sales-bookings-revenue#isCustomerOfBooking"/>
    <rdfs:label>has customer</rdfs:label>
    <rdfs:comment>Relates a booking transaction to the customer that placed the order.</rdfs:comment>
    <enterprise:sourceRelationship>REL002</enterprise:sourceRelationship>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.org/ontology/sales-bookings-revenue#isCustomerOfBooking">
    <rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings-revenue#Customer"/>
    <rdfs:range rdf:resource="http://example.org/ontology/sales-bookings-revenue#BookingTransaction"/>
    <rdfs:label>is customer of booking</rdfs:label>
    <rdfs:comment>Inverse of has customer.</rdfs:comment>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.org/ontology/sales-bookings-revenue#hasBookingDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings-revenue#BookingTransaction"/>
    <rdfs:range rdf:resource="http://example.org/ontology/sales-bookings-revenue#Date"/>
    <owl:inverseOf rdf:resource="http://example.org/ontology/sales-bookings-revenue#isDateOfBooking"/>
    <rdfs:label>has booking date</rdfs:label>
    <rdfs:comment>Relates a booking transaction to the reporting date dimension record.</rdfs:comment>
    <enterprise:sourceRelationship>REL003</enterprise:sourceRelationship>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.org/ontology/sales-bookings-revenue#isDateOfBooking">
    <rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings-revenue#Date"/>
    <rdfs:range rdf:resource="http://example.org/ontology/sales-bookings-revenue#BookingTransaction"/>
    <rdfs:label>is date of booking</rdfs:label>
    <rdfs:comment>Inverse of has booking date.</rdfs:comment>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.org/ontology/sales-bookings-revenue#hasGeography">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings-revenue#BookingTransaction"/>
    <rdfs:range rdf:resource="http://example.org/ontology/sales-bookings-revenue#Geography"/>
    <owl:inverseOf rdf:resource="http://example.org/ontology/sales-bookings-revenue#isGeographyOfBooking"/>
    <rdfs:label>has geography</rdfs:label>
    <rdfs:comment>Relates a booking transaction to the geography used for sales reporting.</rdfs:comment>
    <enterprise:sourceRelationship>REL004</enterprise:sourceRelationship>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.org/ontology/sales-bookings-revenue#isGeographyOfBooking">
    <rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings-revenue#Geography"/>
    <rdfs:range rdf:resource="http://example.org/ontology/sales-bookings-revenue#BookingTransaction"/>
    <rdfs:label>is geography of booking</rdfs:label>
    <rdfs:comment>Inverse of has geography.</rdfs:comment>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.org/ontology/sales-bookings-revenue#hasPartner">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings-revenue#BookingTransaction"/>
    <rdfs:range rdf:resource="http://example.org/ontology/sales-bookings-revenue#Partner"/>
    <owl:inverseOf rdf:resource="http://example.org/ontology/sales-bookings-revenue#isPartnerOfBooking"/>
    <rdfs:label>has partner</rdfs:label>
    <rdfs:comment>Relates a booking transaction to the partner involved in the sales process.</rdfs:comment>
    <enterprise:sourceRelationship>REL005</enterprise:sourceRelationship>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.org/ontology/sales-bookings-revenue#isPartnerOfBooking">
    <rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings-revenue#Partner"/>
    <rdfs:range rdf:resource="http://example.org/ontology/sales-bookings-revenue#BookingTransaction"/>
    <rdfs:label>is partner of booking</rdfs:label>
    <rdfs:comment>Inverse of has partner.</rdfs:comment>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.org/ontology/sales-bookings-revenue#hasProduct">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings-revenue#BookingTransaction"/>
    <rdfs:range rdf:resource="http://example.org/ontology/sales-bookings-revenue#Product"/>
    <owl:inverseOf rdf:resource="http://example.org/ontology/sales-bookings-revenue#isProductOfBooking"/>
    <rdfs:label>has product</rdfs:label>
    <rdfs:comment>Relates a booking transaction to the product or offer booked.</rdfs:comment>
    <enterprise:sourceRelationship>REL006</enterprise:sourceRelationship>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.org/ontology/sales-bookings-revenue#isProductOfBooking">
    <rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings-revenue#Product"/>
    <rdfs:range rdf:resource="http://example.org/ontology/sales-bookings-revenue#BookingTransaction"/>
    <rdfs:label>is product of booking</rdfs:label>
    <rdfs:comment>Inverse of has product.</rdfs:comment>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.org/ontology/sales-bookings-revenue#hasSalesRepresentative">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings-revenue#BookingTransaction"/>
    <rdfs:range rdf:resource="http://example.org/ontology/sales-bookings-revenue#SalesRepresentative"/>
    <owl:inverseOf rdf:resource="http://example.org/ontology/sales-bookings-revenue#isSalesRepresentativeOfBooking"/>
    <rdfs:label>has sales representative</rdfs:label>
    <rdfs:comment>Relates a booking transaction to the sales representative responsible for the booking.</rdfs:comment>
    <enterprise:sourceRelationship>REL007</enterprise:sourceRelationship>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.org/ontology/sales-bookings-revenue#isSalesRepresentativeOfBooking">
    <rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings-revenue#SalesRepresentative"/>
    <rdfs:range rdf:resource="http://example.org/ontology/sales-bookings-revenue#BookingTransaction"/>
    <rdfs:label>is sales representative of booking</rdfs:label>
    <rdfs:comment>Inverse of has sales representative.</rdfs:comment>
  </owl:ObjectProperty>

  <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales-bookings-revenue#contractKey">
    <rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings-revenue#Contract"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label>contract key</rdfs:label>
    <rdfs:comment>Surrogate key that uniquely identifies a contract record in the contract dimension.</rdfs:comment>
    <enterprise:sourceTable>QuoteToBooking.dim_contract</enterprise:sourceTable>
    <enterprise:sourceColumn>contract_key</enterprise:sourceColumn>
    <enterprise:sourceAttribute>ATTR001</enterprise:sourceAttribute>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales-bookings-revenue#contractType">
    <rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings-revenue#Contract"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>contract type</rdfs:label>
    <rdfs:comment>Describes the type of commercial agreement attached to the booking, such as SaaS subscription, Enterprise Agreement, or support contract.</rdfs:comment>
    <enterprise:sourceTable>QuoteToBooking.dim_contract</enterprise:sourceTable>
    <enterprise:sourceColumn>contract_type</enterprise:sourceColumn>
    <enterprise:sourceAttribute>ATTR002</enterprise:sourceAttribute>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales-bookings-revenue#termMonths">
    <rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings-revenue#Contract"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label>contract term months</rdfs:label>
    <rdfs:comment>Indicates the duration of the contract in months.</rdfs:comment>
    <enterprise:sourceTable>QuoteToBooking.dim_contract</enterprise:sourceTable>
    <enterprise:sourceColumn>term_months</enterprise:sourceColumn>
