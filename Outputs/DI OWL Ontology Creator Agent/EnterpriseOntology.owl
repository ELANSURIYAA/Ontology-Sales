<?xml version="1.0"?>
<rdf:RDF
    xmlns="http://example.com/ontology/enterprise-sales-bookings#"
    xml:base="http://example.com/ontology/enterprise-sales-bookings"
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
    xmlns:skos="http://www.w3.org/2004/02/skos/core#"
    xmlns:ex="http://example.com/ontology/enterprise-sales-bookings#">

    <owl:Ontology rdf:about="http://example.com/ontology/enterprise-sales-bookings">
        <rdfs:label>Enterprise Sales Bookings Ontology</rdfs:label>
        <rdfs:comment>OWL 2 ontology generated from the OSI Semantic Model for the Sales Bookings and Revenue Analytics domain. The Business Process document could not be read from GitHub due to binary DOCX decoding failure, so ontology enrichment from process documentation is limited and validation warning metadata is preserved in this ontology.</rdfs:comment>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition>Represents enterprise sales booking transactions, customers, products, partners, geographies, contracts, sales representatives, and reporting dates together with semantic metadata for attributes, measures, glossary terms, and business rules.</skos:definition>
    </owl:Ontology>

    <!-- Annotation Properties -->
    <owl:AnnotationProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#sourceTable"/>
    <owl:AnnotationProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#sourceColumn"/>
    <owl:AnnotationProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#businessDefinition"/>
    <owl:AnnotationProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#sourceEntity"/>
    <owl:AnnotationProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#semanticDefinition"/>
    <owl:AnnotationProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#validationWarning"/>
    <owl:AnnotationProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#aggregationType"/>

    <!-- Classes -->
    <owl:Class rdf:about="http://example.com/ontology/enterprise-sales-bookings#BusinessEntity">
        <rdfs:label>Business Entity</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://example.com/ontology/enterprise-sales-bookings#MetadataConcept">
        <rdfs:label>Metadata Concept</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://example.com/ontology/enterprise-sales-bookings#Contract">
        <rdfs:subClassOf rdf:resource="http://example.com/ontology/enterprise-sales-bookings#BusinessEntity"/>
        <rdfs:label>Contract</rdfs:label>
        <rdfs:comment>Stores the business attributes of commercial agreements associated with bookings, including contract type, term, renewal behavior, and support coverage level.</rdfs:comment>
        <sourceTable>QuoteToBooking.dim_contract</sourceTable>
    </owl:Class>

    <owl:Class rdf:about="http://example.com/ontology/enterprise-sales-bookings#Customer">
        <rdfs:subClassOf rdf:resource="http://example.com/ontology/enterprise-sales-bookings#BusinessEntity"/>
        <rdfs:label>Customer</rdfs:label>
        <rdfs:comment>Stores descriptive information about customers that place orders and generate bookings, including segment, industry, account tier, and headquarters location.</rdfs:comment>
        <sourceTable>QuoteToBooking.dim_customer</sourceTable>
    </owl:Class>

    <owl:Class rdf:about="http://example.com/ontology/enterprise-sales-bookings#Date">
        <rdfs:subClassOf rdf:resource="http://example.com/ontology/enterprise-sales-bookings#BusinessEntity"/>
        <rdfs:label>Date</rdfs:label>
        <rdfs:comment>Stores calendar and fiscal date attributes used to analyze bookings over time.</rdfs:comment>
        <sourceTable>QuoteToBooking.dim_date</sourceTable>
    </owl:Class>

    <owl:Class rdf:about="http://example.com/ontology/enterprise-sales-bookings#Geography">
        <rdfs:subClassOf rdf:resource="http://example.com/ontology/enterprise-sales-bookings#BusinessEntity"/>
        <rdfs:label>Geography</rdfs:label>
        <rdfs:comment>Stores geographic attributes used to analyze bookings by sales region, theater, and country.</rdfs:comment>
        <sourceTable>QuoteToBooking.dim_geography</sourceTable>
    </owl:Class>

    <owl:Class rdf:about="http://example.com/ontology/enterprise-sales-bookings#Partner">
        <rdfs:subClassOf rdf:resource="http://example.com/ontology/enterprise-sales-bookings#BusinessEntity"/>
        <rdfs:label>Partner</rdfs:label>
        <rdfs:comment>Stores information about channel and direct partners involved in the sales process, including partner type, partner tier, and route to market.</rdfs:comment>
        <sourceTable>QuoteToBooking.dim_partner</sourceTable>
    </owl:Class>

    <owl:Class rdf:about="http://example.com/ontology/enterprise-sales-bookings#Product">
        <rdfs:subClassOf rdf:resource="http://example.com/ontology/enterprise-sales-bookings#BusinessEntity"/>
        <rdfs:label>Product</rdfs:label>
        <rdfs:comment>Stores descriptive information about products and offers sold to customers, including product family, technology domain, offer type, and business entity.</rdfs:comment>
        <sourceTable>QuoteToBooking.dim_product</sourceTable>
    </owl:Class>

    <owl:Class rdf:about="http://example.com/ontology/enterprise-sales-bookings#SalesRepresentative">
        <rdfs:subClassOf rdf:resource="http://example.com/ontology/enterprise-sales-bookings#BusinessEntity"/>
        <rdfs:label>Sales Representative</rdfs:label>
        <rdfs:comment>Stores information about sales personnel responsible for managing customer relationships and booking transactions.</rdfs:comment>
        <sourceTable>QuoteToBooking.dim_sales_rep</sourceTable>
    </owl:Class>

    <owl:Class rdf:about="http://example.com/ontology/enterprise-sales-bookings#BookingTransaction">
        <rdfs:subClassOf rdf:resource="http://example.com/ontology/enterprise-sales-bookings#BusinessEntity"/>
        <rdfs:label>Booking Transaction</rdfs:label>
        <rdfs:comment>Stores individual completed sales booking transactions with related financial measures and links to customer, product, partner, geography, sales representative, contract, and date dimensions.</rdfs:comment>
        <sourceTable>QuoteToBooking.fact_bookings</sourceTable>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.com/ontology/enterprise-sales-bookings#hasCustomer"/>
                <owl:someValuesFrom rdf:resource="http://example.com/ontology/enterprise-sales-bookings#Customer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.com/ontology/enterprise-sales-bookings#hasProduct"/>
                <owl:someValuesFrom rdf:resource="http://example.com/ontology/enterprise-sales-bookings#Product"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.com/ontology/enterprise-sales-bookings#hasDate"/>
                <owl:someValuesFrom rdf:resource="http://example.com/ontology/enterprise-sales-bookings#Date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.com/ontology/enterprise-sales-bookings#hasCustomer"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://example.com/ontology/enterprise-sales-bookings#Customer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.com/ontology/enterprise-sales-bookings#hasProduct"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://example.com/ontology/enterprise-sales-bookings#Product"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.com/ontology/enterprise-sales-bookings#hasPartner"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="http://example.com/ontology/enterprise-sales-bookings#Partner"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.com/ontology/enterprise-sales-bookings#hasContract"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="http://example.com/ontology/enterprise-sales-bookings#Contract"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="http://example.com/ontology/enterprise-sales-bookings#Attribute">
        <rdfs:subClassOf rdf:resource="http://example.com/ontology/enterprise-sales-bookings#MetadataConcept"/>
        <rdfs:label>Attribute</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://example.com/ontology/enterprise-sales-bookings#Measure">
        <rdfs:subClassOf rdf:resource="http://example.com/ontology/enterprise-sales-bookings#MetadataConcept"/>
        <rdfs:label>Measure</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://example.com/ontology/enterprise-sales-bookings#BusinessRule">
        <rdfs:subClassOf rdf:resource="http://example.com/ontology/enterprise-sales-bookings#MetadataConcept"/>
        <rdfs:label>Business Rule</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://example.com/ontology/enterprise-sales-bookings#GlossaryTerm">
        <rdfs:subClassOf rdf:resource="http://example.com/ontology/enterprise-sales-bookings#MetadataConcept"/>
        <rdfs:label>Glossary Term</rdfs:label>
    </owl:Class>

    <!-- Disjointness -->
    <owl:AllDisjointClasses>
        <owl:members rdf:parseType="Collection">
            <rdf:Description rdf:about="http://example.com/ontology/enterprise-sales-bookings#Contract"/>
            <rdf:Description rdf:about="http://example.com/ontology/enterprise-sales-bookings#Customer"/>
            <rdf:Description rdf:about="http://example.com/ontology/enterprise-sales-bookings#Date"/>
            <rdf:Description rdf:about="http://example.com/ontology/enterprise-sales-bookings#Geography"/>
            <rdf:Description rdf:about="http://example.com/ontology/enterprise-sales-bookings#Partner"/>
            <rdf:Description rdf:about="http://example.com/ontology/enterprise-sales-bookings#Product"/>
            <rdf:Description rdf:about="http://example.com/ontology/enterprise-sales-bookings#SalesRepresentative"/>
            <rdf:Description rdf:about="http://example.com/ontology/enterprise-sales-bookings#BookingTransaction"/>
        </owl:members>
    </owl:AllDisjointClasses>

    <!-- Object Properties -->
    <owl:ObjectProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#hasContract">
        <rdfs:label>has Contract</rdfs:label>
        <rdfs:comment>Links a booking transaction to the contract associated with the booking.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/enterprise-sales-bookings#BookingTransaction"/>
        <rdfs:range rdf:resource="http://example.com/ontology/enterprise-sales-bookings#Contract"/>
        <owl:inverseOf rdf:resource="http://example.com/ontology/enterprise-sales-bookings#isContractOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#isContractOf">
        <rdfs:label>is Contract Of</rdfs:label>
        <rdfs:domain rdf:resource="http://example.com/ontology/enterprise-sales-bookings#Contract"/>
        <rdfs:range rdf:resource="http://example.com/ontology/enterprise-sales-bookings#BookingTransaction"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#hasCustomer">
        <rdfs:label>has Customer</rdfs:label>
        <rdfs:comment>Links a booking transaction to the customer that placed the order.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/enterprise-sales-bookings#BookingTransaction"/>
        <rdfs:range rdf:resource="http://example.com/ontology/enterprise-sales-bookings#Customer"/>
        <owl:inverseOf rdf:resource="http://example.com/ontology/enterprise-sales-bookings#isCustomerOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#isCustomerOf">
        <rdfs:label>is Customer Of</rdfs:label>
        <rdfs:domain rdf:resource="http://example.com/ontology/enterprise-sales-bookings#Customer"/>
        <rdfs:range rdf:resource="http://example.com/ontology/enterprise-sales-bookings#BookingTransaction"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#hasDate">
        <rdfs:label>has Date</rdfs:label>
        <rdfs:comment>Links a booking transaction to the reporting date.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/enterprise-sales-bookings#BookingTransaction"/>
        <rdfs:range rdf:resource="http://example.com/ontology/enterprise-sales-bookings#Date"/>
        <owl:inverseOf rdf:resource="http://example.com/ontology/enterprise-sales-bookings#isDateOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#isDateOf">
        <rdfs:label>is Date Of</rdfs:label>
        <rdfs:domain rdf:resource="http://example.com/ontology/enterprise-sales-bookings#Date"/>
        <rdfs:range rdf:resource="http://example.com/ontology/enterprise-sales-bookings#BookingTransaction"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#hasGeography">
        <rdfs:label>has Geography</rdfs:label>
        <rdfs:comment>Links a booking transaction to a geography.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/enterprise-sales-bookings#BookingTransaction"/>
        <rdfs:range rdf:resource="http://example.com/ontology/enterprise-sales-bookings#Geography"/>
        <owl:inverseOf rdf:resource="http://example.com/ontology/enterprise-sales-bookings#isGeographyOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#isGeographyOf">
        <rdfs:label>is Geography Of</rdfs:label>
        <rdfs:domain rdf:resource="http://example.com/ontology/enterprise-sales-bookings#Geography"/>
        <rdfs:range rdf:resource="http://example.com/ontology/enterprise-sales-bookings#BookingTransaction"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#hasPartner">
        <rdfs:label>has Partner</rdfs:label>
        <rdfs:comment>Links a booking transaction to a partner organization involved in the transaction.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/enterprise-sales-bookings#BookingTransaction"/>
        <rdfs:range rdf:resource="http://example.com/ontology/enterprise-sales-bookings#Partner"/>
        <owl:inverseOf rdf:resource="http://example.com/ontology/enterprise-sales-bookings#isPartnerOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#isPartnerOf">
        <rdfs:label>is Partner Of</rdfs:label>
        <rdfs:domain rdf:resource="http://example.com/ontology/enterprise-sales-bookings#Partner"/>
        <rdfs:range rdf:resource="http://example.com/ontology/enterprise-sales-bookings#BookingTransaction"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#hasProduct">
        <rdfs:label>has Product</rdfs:label>
        <rdfs:comment>Links a booking transaction to the product sold.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/enterprise-sales-bookings#BookingTransaction"/>
        <rdfs:range rdf:resource="http://example.com/ontology/enterprise-sales-bookings#Product"/>
        <owl:inverseOf rdf:resource="http://example.com/ontology/enterprise-sales-bookings#isProductOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#isProductOf">
        <rdfs:label>is Product Of</rdfs:label>
        <rdfs:domain rdf:resource="http://example.com/ontology/enterprise-sales-bookings#Product"/>
        <rdfs:range rdf:resource="http://example.com/ontology/enterprise-sales-bookings#BookingTransaction"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#hasSalesRepresentative">
        <rdfs:label>has Sales Representative</rdfs:label>
        <rdfs:comment>Links a booking transaction to the sales representative associated with the booking.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/enterprise-sales-bookings#BookingTransaction"/>
        <rdfs:range rdf:resource="http://example.com/ontology/enterprise-sales-bookings#SalesRepresentative"/>
        <owl:inverseOf rdf:resource="http://example.com/ontology/enterprise-sales-bookings#isSalesRepresentativeOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#isSalesRepresentativeOf">
        <rdfs:label>is Sales Representative Of</rdfs:label>
        <rdfs:domain rdf:resource="http://example.com/ontology/enterprise-sales-bookings#SalesRepresentative"/>
        <rdfs:range rdf:resource="http://example.com/ontology/enterprise-sales-bookings#BookingTransaction"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#hasAttribute">
        <rdfs:label>has Attribute</rdfs:label>
        <rdfs:comment>Links a business entity to an attribute metadata individual.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/enterprise-sales-bookings#BusinessEntity"/>
        <rdfs:range rdf:resource="http://example.com/ontology/enterprise-sales-bookings#Attribute"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#hasMeasure">
        <rdfs:label>has Measure</rdfs:label>
        <rdfs:comment>Links a business entity to a measure metadata individual.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/enterprise-sales-bookings#BusinessEntity"/>
        <rdfs:range rdf:resource="http://example.com/ontology/enterprise-sales-bookings#Measure"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#hasBusinessRule">
        <rdfs:label>has Business Rule</rdfs:label>
        <rdfs:comment>Links a business entity to a business rule metadata individual.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/enterprise-sales-bookings#BusinessEntity"/>
        <rdfs:range rdf:resource="http://example.com/ontology/enterprise-sales-bookings#BusinessRule"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#hasGlossaryTerm">
        <rdfs:label>has Glossary Term</rdfs:label>
        <rdfs:comment>Links a business entity to a glossary term metadata individual.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/enterprise-sales-bookings#BusinessEntity"/>
        <rdfs:range rdf:resource="http://example.com/ontology/enterprise-sales-bookings#GlossaryTerm"/>
    </owl:ObjectProperty>

    <!-- Datatype Properties -->
    <owl:DatatypeProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#contractKey"><rdfs:label>Contract Key</rdfs:label><rdfs:comment>Surrogate key that uniquely identifies a contract record in the contract dimension.</rdfs:comment><rdfs:domain rdf:resource="http://example.com/ontology/enterprise-sales-bookings#Contract"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/><sourceTable>QuoteToBooking.dim_contract</sourceTable><sourceColumn>contract_key</sourceColumn><businessDefinition>Surrogate key that uniquely identifies a contract record in the contract dimension.</businessDefinition></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#contractType"><rdfs:label>Contract Type</rdfs:label><rdfs:comment>Describes the type of commercial agreement attached to the booking, such as SaaS subscription, Enterprise Agreement, or support contract.</rdfs:comment><rdfs:domain rdf:resource="http://example.com/ontology/enterprise-sales-bookings#Contract"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><sourceTable>QuoteToBooking.dim_contract</sourceTable><sourceColumn>contract_type</sourceColumn><businessDefinition>Describes the type of commercial agreement attached to the booking, such as SaaS subscription, Enterprise Agreement, or support contract.</businessDefinition></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#termMonths"><rdfs:label>Contract Term Months</rdfs:label><rdfs:comment>Indicates the duration of the contract in months.</rdfs:comment><rdfs:domain rdf:resource="http://example.com/ontology/enterprise-sales-bookings#Contract"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/><sourceTable>QuoteToBooking.dim_contract</sourceTable><sourceColumn>term_months</sourceColumn><businessDefinition>Indicates the duration of the contract in months.</businessDefinition></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#autoRenewFlag"><rdfs:label>Auto Renew Flag</rdfs:label><rdfs:comment>Indicates whether the contract is set to renew automatically at the end of its term.</rdfs:comment><rdfs:domain rdf:resource="http://example.com/ontology/enterprise-sales-bookings#Contract"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><sourceTable>QuoteToBooking.dim_contract</sourceTable><sourceColumn>auto_renew_flag</sourceColumn><businessDefinition>Indicates whether the contract is set to renew automatically at the end of its term.</businessDefinition></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#coverageLevel"><rdfs:label>Coverage Level</rdfs:label><rdfs:comment>Describes the level of service or support coverage provided under the contract.</rdfs:comment><rdfs:domain rdf:resource="http://example.com/ontology/enterprise-sales-bookings#Contract"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><sourceTable>QuoteToBooking.dim_contract</sourceTable><sourceColumn>coverage_level</sourceColumn><businessDefinition>Describes the level of service or support coverage provided under the contract.</businessDefinition></owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#customerKey"><rdfs:label>Customer Key</rdfs:label><rdfs:comment>Surrogate key that uniquely identifies a customer record in the customer dimension.</rdfs:comment><rdfs:domain rdf:resource="http://example.com/ontology/enterprise-sales-bookings#Customer"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/><sourceTable>QuoteToBooking.dim_customer</sourceTable><sourceColumn>customer_key</sourceColumn><businessDefinition>Surrogate key that uniquely identifies a customer record in the customer dimension.</businessDefinition></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#customerId"><rdfs:label>Customer ID</rdfs:label><rdfs:comment>Business identifier assigned to the customer account.</rdfs:comment><rdfs:domain rdf:resource="http://example.com/ontology/enterprise-sales-bookings#Customer"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><sourceTable>QuoteToBooking.dim_customer</sourceTable><sourceColumn>customer_id</sourceColumn><businessDefinition>Business identifier assigned to the customer account.</businessDefinition></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#customerName"><rdfs:label>Customer Name</rdfs:label><rdfs:comment>Official name of the customer organization that purchased products or services.</rdfs:comment><rdfs:domain rdf:resource="http://example.com/ontology/enterprise-sales-bookings#Customer"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><sourceTable>QuoteToBooking.dim_customer</sourceTable><sourceColumn>customer_name</sourceColumn><businessDefinition>Official name of the customer organization that purchased products or services.</businessDefinition></owl:DatatypeProperty>
