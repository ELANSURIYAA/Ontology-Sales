  <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales#contractKey">
    <rdfs:label>contract key</rdfs:label>
    <rdfs:comment>Unique surrogate key for the contract record used to join contract details to booking transactions.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology/sales#Contract"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <sales:businessDefinition>Unique surrogate key for the contract record used to join contract details to booking transactions.</sales:businessDefinition>
    <sales:sourceTable>quotetobooking.dim_contract</sales:sourceTable>
    <sales:sourceColumn>contract_key</sales:sourceColumn>
    <sales:businessDomain>Contracts</sales:businessDomain>
    <sales:xsdDataType>integer</sales:xsdDataType>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales#contractType">
    <rdfs:label>contract type</rdfs:label>
    <rdfs:comment>Type of customer contract or service agreement associated with the booking.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology/sales#Contract"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <sales:businessDefinition>Type of customer contract or service agreement associated with the booking.</sales:businessDefinition>
    <sales:sourceTable>quotetobooking.dim_contract</sales:sourceTable>
    <sales:sourceColumn>contract_type</sales:sourceColumn>
    <sales:businessDomain>Contracts</sales:businessDomain>
    <sales:xsdDataType>character varying(40)</sales:xsdDataType>
  </owl:DatatypeProperty>

