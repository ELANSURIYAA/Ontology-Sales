    <owl:DatatypeProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#technologyDomain"><rdfs:label>Technology Domain</rdfs:label><rdfs:comment>Technology area or solution domain to which the product belongs.</rdfs:comment><rdfs:domain rdf:resource="http://example.com/ontology/enterprise-sales-bookings#Product"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><sourceTable>QuoteToBooking.dim_product</sourceTable><sourceColumn>technology_domain</sourceColumn><businessDefinition>Technology area or solution domain to which the product belongs.</businessDefinition></owl:DatatypeProperty>
