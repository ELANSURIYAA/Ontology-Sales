<?xml version="1.0"?>
<rdf:RDF xmlns="http://example.org/ontology/sales-bookings#"
     xml:base="http://example.org/ontology/sales-bookings"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#">

    <owl:Ontology rdf:about="http://example.org/ontology/sales-bookings">
        <rdfs:label xml:lang="en">Sales Bookings and Revenue Analytics Ontology</rdfs:label>
        <rdfs:comment xml:lang="en">OWL 2 ontology generated from the OSI Semantic Model for the Sales Bookings and Revenue Analytics domain. The business process document could not be parsed from the provided repository input, so ontology enrichment from process documentation was not applied. The ontology preserves only concepts and relationships explicitly supported by the readable semantic model.</rdfs:comment>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:note xml:lang="en">Validation warning: Business process document Inputs/QuoteToBooking.docx was not readable due to UTF-8 decoding error. Semantic enrichment from the business process source was therefore not performed.</skos:note>
        <skos:note xml:lang="en">Validation result: OSI Semantic Model was readable and contained domains, entities, attributes, measures, relationships, and glossary mappings.</skos:note>
        <skos:note xml:lang="en">Validation result: No duplicate entities were detected in the OSI Semantic Model.</skos:note>
        <skos:note xml:lang="en">Validation result: Required semantic components for ontology generation were present in the OSI Semantic Model.</skos:note>
    </owl:Ontology>

    <!-- Classes -->

    <owl:Class rdf:about="#Contract">
        <rdfs:label>Contract</rdfs:label>
        <rdfs:comment>Stores the business attributes of commercial agreements associated with bookings, including contract type, term, renewal behavior, and support coverage level.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Customer">
        <rdfs:label>Customer</rdfs:label>
        <rdfs:comment>Stores descriptive information about customers that place orders and generate bookings, including segment, industry, account tier, and headquarters location.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Date">
        <rdfs:label>Date</rdfs:label>
        <rdfs:comment>Stores calendar and fiscal date attributes used to analyze bookings over time.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Geography">
        <rdfs:label>Geography</rdfs:label>
        <rdfs:comment>Stores geographic attributes used to analyze bookings by sales region, theater, and country.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Partner">
        <rdfs:label>Partner</rdfs:label>
        <rdfs:comment>Stores information about channel and direct partners involved in the sales process, including partner type, partner tier, and route to market.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Product">
        <rdfs:label>Product</rdfs:label>
        <rdfs:comment>Stores descriptive information about products and offers sold to customers, including product family, technology domain, offer type, and business entity.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#SalesRepresentative">
        <rdfs:label>Sales Representative</rdfs:label>
        <rdfs:comment>Stores information about sales personnel responsible for managing customer relationships and booking transactions.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#BookingTransaction">
        <rdfs:label>Booking Transaction</rdfs:label>
        <rdfs:comment>Stores individual completed sales booking transactions with related financial measures and links to customer, product, partner, geography, sales representative, contract, and date dimensions.</rdfs:comment>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#hasContract"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="#Contract"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#hasCustomer"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="#Customer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#hasBookingDate"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="#Date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#hasGeography"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="#Geography"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#hasPartner"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="#Partner"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#hasProduct"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="#Product"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#hasSalesRepresentative"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="#SalesRepresentative"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <!-- Object Properties -->

    <owl:ObjectProperty rdf:about="#hasContract">
        <rdfs:label>has contract</rdfs:label>
        <rdfs:comment>Links a booking transaction to the contract associated with the booking.</rdfs:comment>
        <rdfs:domain rdf:resource="#BookingTransaction"/>
        <rdfs:range rdf:resource="#Contract"/>
        <owl:inverseOf rdf:resource="#isContractOfBookingTransaction"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#isContractOfBookingTransaction">
        <rdfs:label>is contract of booking transaction</rdfs:label>
        <rdfs:domain rdf:resource="#Contract"/>
        <rdfs:range rdf:resource="#BookingTransaction"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasCustomer">
        <rdfs:label>has customer</rdfs:label>
        <rdfs:comment>Links a booking transaction to the customer that placed the order.</rdfs:comment>
        <rdfs:domain rdf:resource="#BookingTransaction"/>
        <rdfs:range rdf:resource="#Customer"/>
        <owl:inverseOf rdf:resource="#isCustomerOfBookingTransaction"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#isCustomerOfBookingTransaction">
        <rdfs:label>is customer of booking transaction</rdfs:label>
        <rdfs:domain rdf:resource="#Customer"/>
        <rdfs:range rdf:resource="#BookingTransaction"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasBookingDate">
        <rdfs:label>has booking date</rdfs:label>
        <rdfs:comment>Links a booking transaction to its reporting date.</rdfs:comment>
        <rdfs:domain rdf:resource="#BookingTransaction"/>
        <rdfs:range rdf:resource="#Date"/>
        <owl:inverseOf rdf:resource="#isBookingDateOfTransaction"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#isBookingDateOfTransaction">
        <rdfs:label>is booking date of transaction</rdfs:label>
        <rdfs:domain rdf:resource="#Date"/>
        <rdfs:range rdf:resource="#BookingTransaction"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasGeography">
        <rdfs:label>has geography</rdfs:label>
        <rdfs:comment>Links a booking transaction to the geography used for reporting.</rdfs:comment>
        <rdfs:domain rdf:resource="#BookingTransaction"/>
        <rdfs:range rdf:resource="#Geography"/>
        <owl:inverseOf rdf:resource="#isGeographyOfBookingTransaction"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#isGeographyOfBookingTransaction">
        <rdfs:label>is geography of booking transaction</rdfs:label>
        <rdfs:domain rdf:resource="#Geography"/>
        <rdfs:range rdf:resource="#BookingTransaction"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasPartner">
        <rdfs:label>has partner</rdfs:label>
        <rdfs:comment>Links a booking transaction to the partner involved in the sale.</rdfs:comment>
        <rdfs:domain rdf:resource="#BookingTransaction"/>
        <rdfs:range rdf:resource="#Partner"/>
        <owl:inverseOf rdf:resource="#isPartnerOfBookingTransaction"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#isPartnerOfBookingTransaction">
        <rdfs:label>is partner of booking transaction</rdfs:label>
        <rdfs:domain rdf:resource="#Partner"/>
        <rdfs:range rdf:resource="#BookingTransaction"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasProduct">
        <rdfs:label>has product</rdfs:label>
        <rdfs:comment>Links a booking transaction to the product or offer sold.</rdfs:comment>
        <rdfs:domain rdf:resource="#BookingTransaction"/>
        <rdfs:range rdf:resource="#Product"/>
        <owl:inverseOf rdf:resource="#isProductOfBookingTransaction"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#isProductOfBookingTransaction">
        <rdfs:label>is product of booking transaction</rdfs:label>
        <rdfs:domain rdf:resource="#Product"/>
        <rdfs:range rdf:resource="#BookingTransaction"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasSalesRepresentative">
        <rdfs:label>has sales representative</rdfs:label>
        <rdfs:comment>Links a booking transaction to the sales representative responsible for the transaction.</rdfs:comment>
        <rdfs:domain rdf:resource="#BookingTransaction"/>
        <rdfs:range rdf:resource="#SalesRepresentative"/>
        <owl:inverseOf rdf:resource="#isSalesRepresentativeOfBookingTransaction"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#isSalesRepresentativeOfBookingTransaction">
        <rdfs:label>is sales representative of booking transaction</rdfs:label>
        <rdfs:domain rdf:resource="#SalesRepresentative"/>
        <rdfs:range rdf:resource="#BookingTransaction"/>
    </owl:ObjectProperty>

