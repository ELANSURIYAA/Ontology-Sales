        <rdfs:comment>Sales team or organization to which the representative belongs.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/quotetobooking#SalesRepresentativeDimension"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <qb:sourceTable>quotetobooking.dim_sales_rep</qb:sourceTable>
        <qb:sourceColumn>sales_team</qb:sourceColumn>
        <qb:sourceAttribute>ATT042</qb:sourceAttribute>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.com/ontology/quotetobooking#segmentCovered">
        <rdfs:label>segment covered</rdfs:label>
        <rdfs:comment>Customer segment primarily covered by the sales representative.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/quotetobooking#SalesRepresentativeDimension"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <qb:sourceTable>quotetobooking.dim_sales_rep</qb:sourceTable>
        <qb:sourceColumn>segment_covered</qb:sourceColumn>
        <qb:sourceAttribute>ATT043</qb:sourceAttribute>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.com/ontology/quotetobooking#bookingId">
        <rdfs:label>booking ID</rdfs:label>
        <rdfs:comment>Unique identifier for an individual booking transaction.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/quotetobooking#BookingFact"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <qb:sourceTable>quotetobooking.fact_bookings</qb:sourceTable>
        <qb:sourceColumn>booking_id</qb:sourceColumn>
        <qb:sourceAttribute>ATT044</qb:sourceAttribute>
    </owl:DatatypeProperty>
    <owl:FunctionalProperty rdf:about="http://example.com/ontology/quotetobooking#bookingId"/>

    <owl:DatatypeProperty rdf:about="http://example.com/ontology/quotetobooking#orderNumber">
        <rdfs:label>order number</rdfs:label>
        <rdfs:comment>Sales order number associated with the booking transaction.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/quotetobooking#BookingFact"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <qb:sourceTable>quotetobooking.fact_bookings</qb:sourceTable>
        <qb:sourceColumn>order_number</qb:sourceColumn>
        <qb:sourceAttribute>ATT045</qb:sourceAttribute>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.com/ontology/quotetobooking#orderLineNumber">
        <rdfs:label>order line number</rdfs:label>
        <rdfs:comment>Line number within the sales order that identifies the specific booked item.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/quotetobooking#BookingFact"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <qb:sourceTable>quotetobooking.fact_bookings</qb:sourceTable>
        <qb:sourceColumn>order_line_number</qb:sourceColumn>
        <qb:sourceAttribute>ATT046</qb:sourceAttribute>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.com/ontology/quotetobooking#bookingDateKey">
        <rdfs:label>booking date key</rdfs:label>
        <rdfs:comment>Reference to the date dimension indicating when the booking was recorded.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/quotetobooking#BookingFact"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <qb:sourceTable>quotetobooking.fact_bookings</qb:sourceTable>
        <qb:sourceColumn>date_key</qb:sourceColumn>
        <qb:sourceAttribute>ATT047</qb:sourceAttribute>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.com/ontology/quotetobooking#bookingCustomerKey">
        <rdfs:label>booking customer key</rdfs:label>
        <rdfs:comment>Reference to the customer associated with the booking.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/quotetobooking#BookingFact"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <qb:sourceTable>quotetobooking.fact_bookings</qb:sourceTable>
        <qb:sourceColumn>customer_key</qb:sourceColumn>
        <qb:sourceAttribute>ATT048</qb:sourceAttribute>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.com/ontology/quotetobooking#bookingProductKey">
        <rdfs:label>booking product key</rdfs:label>
        <rdfs:comment>Reference to the product or offer included in the booking.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/quotetobooking#BookingFact"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <qb:sourceTable>quotetobooking.fact_bookings</qb:sourceTable>
        <qb:sourceColumn>product_key</qb:sourceColumn>
        <qb:sourceAttribute>ATT049</qb:sourceAttribute>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.com/ontology/quotetobooking#bookingPartnerKey">
        <rdfs:label>booking partner key</rdfs:label>
        <rdfs:comment>Reference to the partner involved in fulfilling or transacting the booking.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/quotetobooking#BookingFact"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <qb:sourceTable>quotetobooking.fact_bookings</qb:sourceTable>
        <qb:sourceColumn>partner_key</qb:sourceColumn>
        <qb:sourceAttribute>ATT050</qb:sourceAttribute>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.com/ontology/quotetobooking#bookingGeographyKey">
        <rdfs:label>booking geography key</rdfs:label>
        <rdfs:comment>Reference to the geography associated with the booking.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/quotetobooking#BookingFact"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <qb:sourceTable>quotetobooking.fact_bookings</qb:sourceTable>
        <qb:sourceColumn>geography_key</qb:sourceColumn>
        <qb:sourceAttribute>ATT051</qb:sourceAttribute>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.com/ontology/quotetobooking#bookingSalesRepKey">
        <rdfs:label>booking sales representative key</rdfs:label>
        <rdfs:comment>Reference to the sales representative responsible for the booking.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/quotetobooking#BookingFact"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <qb:sourceTable>quotetobooking.fact_bookings</qb:sourceTable>
        <qb:sourceColumn>sales_rep_key</qb:sourceColumn>
        <qb:sourceAttribute>ATT052</qb:sourceAttribute>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.com/ontology/quotetobooking#bookingContractKey">
        <rdfs:label>booking contract key</rdfs:label>
        <rdfs:comment>Reference to the contract or commercial agreement associated with the booking.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/quotetobooking#BookingFact"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <qb:sourceTable>quotetobooking.fact_bookings</qb:sourceTable>
        <qb:sourceColumn>contract_key</qb:sourceColumn>
        <qb:sourceAttribute>ATT053</qb:sourceAttribute>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.com/ontology/quotetobooking#bookingType">
        <rdfs:label>booking type</rdfs:label>
        <rdfs:comment>Classification of the booking event, such as new business or renewal.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/quotetobooking#BookingFact"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <qb:sourceTable>quotetobooking.fact_bookings</qb:sourceTable>
        <qb:sourceColumn>booking_type</qb:sourceColumn>
        <qb:sourceAttribute>ATT054</qb:sourceAttribute>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.com/ontology/quotetobooking#isRenewal">
        <rdfs:label>renewal indicator</rdfs:label>
        <rdfs:comment>Indicator showing whether the booking represents a renewal transaction.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/quotetobooking#BookingFact"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <qb:sourceTable>quotetobooking.fact_bookings</qb:sourceTable>
        <qb:sourceColumn>is_renewal</qb:sourceColumn>
        <qb:sourceAttribute>ATT055</qb:sourceAttribute>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.com/ontology/quotetobooking#quantity">
        <rdfs:label>quantity sold</rdfs:label>
        <rdfs:comment>Number of units, licenses, or subscriptions booked in the transaction.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/quotetobooking#BookingFact"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <qb:sourceTable>quotetobooking.fact_bookings</qb:sourceTable>
        <qb:sourceColumn>quantity</qb:sourceColumn>
        <qb:sourceAttribute>ATT056</qb:sourceAttribute>
        <qb:aggregationType>Sum</qb:aggregationType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.com/ontology/quotetobooking#unitListPriceUSD">
        <rdfs:label>unit list price USD</rdfs:label>
        <rdfs:comment>Standard list price per unit in U.S. dollars before discounts.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/quotetobooking#BookingFact"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <qb:sourceTable>quotetobooking.fact_bookings</qb:sourceTable>
        <qb:sourceColumn>unit_list_price_usd</qb:sourceColumn>
        <qb:sourceAttribute>ATT057</qb:sourceAttribute>
        <qb:aggregationType>Average</qb:aggregationType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.com/ontology/quotetobooking#discountPercentage">
        <rdfs:label>discount percentage</rdfs:label>
        <rdfs:comment>Discount applied to the list price for the booking line.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/quotetobooking#BookingFact"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <qb:sourceTable>quotetobooking.fact_bookings</qb:sourceTable>
        <qb:sourceColumn>discount_pct</qb:sourceColumn>
        <qb:sourceAttribute>ATT058</qb:sourceAttribute>
        <qb:aggregationType>Average</qb:aggregationType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.com/ontology/quotetobooking#bookingAmountUSD">
        <rdfs:label>booking amount USD</rdfs:label>
        <rdfs:comment>Total booked revenue amount in U.S. dollars for the transaction.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/quotetobooking#BookingFact"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <qb:sourceTable>quotetobooking.fact_bookings</qb:sourceTable>
        <qb:sourceColumn>booking_amount_usd</qb:sourceColumn>
        <qb:sourceAttribute>ATT059</qb:sourceAttribute>
        <qb:aggregationType>Sum</qb:aggregationType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.com/ontology/quotetobooking#acvUSD">
        <rdfs:label>annual contract value USD</rdfs:label>
        <rdfs:comment>Annualized contract value in U.S. dollars used for recurring revenue analysis.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/quotetobooking#BookingFact"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <qb:sourceTable>quotetobooking.fact_bookings</qb:sourceTable>
        <qb:sourceColumn>acv_usd</qb:sourceColumn>
        <qb:sourceAttribute>ATT060</qb:sourceAttribute>
        <qb:aggregationType>Sum</qb:aggregationType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.com/ontology/quotetobooking#tcvUSD">
        <rdfs:label>total contract value USD</rdfs:label>
        <rdfs:comment>Total contract value in U.S. dollars over the full contract term.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/quotetobooking#BookingFact"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <qb:sourceTable>quotetobooking.fact_bookings</qb:sourceTable>
        <qb:sourceColumn>tcv_usd</qb:sourceColumn>
        <qb:sourceAttribute>ATT061</qb:sourceAttribute>
        <qb:aggregationType>Sum</qb:aggregationType>
    </owl:DatatypeProperty>

</rdf:RDF>
