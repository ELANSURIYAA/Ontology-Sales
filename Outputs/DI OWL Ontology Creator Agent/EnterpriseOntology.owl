    <!-- Domain Class -->
    <owl:Class rdf:about="http://example.com/ontology/sales-bookings#SalesBookingsAndRevenueAnalyticsDomain">
        <rdfs:subClassOf rdf:resource="http://example.com/ontology/sales-bookings#DomainConcept"/>
        <rdfs:label>Sales Bookings and Revenue Analytics Domain</rdfs:label>
        <rdfs:comment>This domain represents sales booking operations for enterprise networking, security, collaboration, observability, and software subscription products. It captures completed customer bookings and supports analysis of sales performance across customers, products, partners, geographies, sales representatives, contracts, and fiscal periods.</rdfs:comment>
        <businessDefinition>This domain represents sales booking operations for enterprise networking, security, collaboration, observability, and software subscription products. It captures completed customer bookings and supports analysis of sales performance across customers, products, partners, geographies, sales representatives, contracts, and fiscal periods.</businessDefinition>
        <businessDomain>Sales Bookings and Revenue Analytics</businessDomain>
        <sourceSemanticModel>Outputs/DI OSI Semantic Creator Agent/OSI Semantic Model.md</sourceSemanticModel>
    </owl:Class>

