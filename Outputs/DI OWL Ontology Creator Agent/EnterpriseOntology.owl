    <owl:Class rdf:about="http://example.com/ontology/quotetobooking#DomainConcept">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>Domain Concept</rdfs:label>
        <rdfs:comment>Top-level abstract business concept used to organize the ontology class hierarchy.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://example.com/ontology/quotetobooking#BusinessEntity">
        <rdfs:subClassOf rdf:resource="http://example.com/ontology/quotetobooking#DomainConcept"/>
        <rdfs:label>Business Entity</rdfs:label>
        <rdfs:comment>Abstract superclass for all business entities represented in the semantic model.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://example.com/ontology/quotetobooking#DimensionEntity">
        <rdfs:subClassOf rdf:resource="http://example.com/ontology/quotetobooking#BusinessEntity"/>
        <rdfs:label>Dimension Entity</rdfs:label>
        <rdfs:comment>Superclass for dimensional master data entities used to classify and analyze transactions.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://example.com/ontology/quotetobooking#TransactionEntity">
        <rdfs:subClassOf rdf:resource="http://example.com/ontology/quotetobooking#BusinessEntity"/>
        <rdfs:label>Transaction Entity</rdfs:label>
        <rdfs:comment>Superclass for transactional entities recording business events and related measures.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://example.com/ontology/quotetobooking#ContractDimension">
        <rdfs:subClassOf rdf:resource="http://example.com/ontology/quotetobooking#DimensionEntity"/>
        <rdfs:label>Contract Dimension</rdfs:label>
        <rdfs:comment>Stores contract and service agreement attributes used to classify bookings by contract type, term, renewal behavior, and coverage level.</rdfs:comment>
        <qb:businessDefinition>Stores contract and service agreement attributes used to classify bookings by contract type, term, renewal behavior, and coverage level.</qb:businessDefinition>
        <qb:businessDomain>Contract Management</qb:businessDomain>
        <qb:sourceEntity>ENT001</qb:sourceEntity>
        <qb:sourceTable>quotetobooking.dim_contract</qb:sourceTable>
    </owl:Class>

    <owl:Class rdf:about="http://example.com/ontology/quotetobooking#CustomerDimension">
        <rdfs:subClassOf rdf:resource="http://example.com/ontology/quotetobooking#DimensionEntity"/>
        <rdfs:label>Customer Dimension</rdfs:label>
        <rdfs:comment>Stores descriptive customer attributes used to analyze bookings by customer identity, segment, industry, account tier, and headquarters location.</rdfs:comment>
        <qb:businessDefinition>Stores descriptive customer attributes used to analyze bookings by customer identity, segment, industry, account tier, and headquarters location.</qb:businessDefinition>
        <qb:businessDomain>Customer Management</qb:businessDomain>
        <qb:sourceEntity>ENT002</qb:sourceEntity>
        <qb:sourceTable>quotetobooking.dim_customer</qb:sourceTable>
    </owl:Class>

    <owl:Class rdf:about="http://example.com/ontology/quotetobooking#DateDimension">
        <rdfs:subClassOf rdf:resource="http://example.com/ontology/quotetobooking#DimensionEntity"/>
        <rdfs:label>Date Dimension</rdfs:label>
        <rdfs:comment>Stores calendar and fiscal date attributes used to analyze bookings across time periods, fiscal years, quarters, and months.</rdfs:comment>
        <qb:businessDefinition>Stores calendar and fiscal date attributes used to analyze bookings across time periods, fiscal years, quarters, and months.</qb:businessDefinition>
        <qb:businessDomain>Time Management</qb:businessDomain>
        <qb:sourceEntity>ENT003</qb:sourceEntity>
        <qb:sourceTable>quotetobooking.dim_date</qb:sourceTable>
    </owl:Class>

    <owl:Class rdf:about="http://example.com/ontology/quotetobooking#GeographyDimension">
        <rdfs:subClassOf rdf:resource="http://example.com/ontology/quotetobooking#DimensionEntity"/>
        <rdfs:label>Geography Dimension</rdfs:label>
        <rdfs:comment>Stores geographic attributes used to analyze bookings by region, theater, and country.</rdfs:comment>
        <qb:businessDefinition>Stores geographic attributes used to analyze bookings by region, theater, and country.</qb:businessDefinition>
        <qb:businessDomain>Geography</qb:businessDomain>
        <qb:sourceEntity>ENT004</qb:sourceEntity>
        <qb:sourceTable>quotetobooking.dim_geography</qb:sourceTable>
    </owl:Class>

    <owl:Class rdf:about="http://example.com/ontology/quotetobooking#PartnerDimension">
        <rdfs:subClassOf rdf:resource="http://example.com/ontology/quotetobooking#DimensionEntity"/>
        <rdfs:label>Partner Dimension</rdfs:label>
        <rdfs:comment>Stores channel partner attributes used to analyze bookings by partner identity, partner type, partner tier, and route to market.</rdfs:comment>
        <qb:businessDefinition>Stores channel partner attributes used to analyze bookings by partner identity, partner type, partner tier, and route to market.</qb:businessDefinition>
        <qb:businessDomain>Partner Management</qb:businessDomain>
        <qb:sourceEntity>ENT005</qb:sourceEntity>
        <qb:sourceTable>quotetobooking.dim_partner</qb:sourceTable>
    </owl:Class>

    <owl:Class rdf:about="http://example.com/ontology/quotetobooking#ProductDimension">
        <rdfs:subClassOf rdf:resource="http://example.com/ontology/quotetobooking#DimensionEntity"/>
        <rdfs:label>Product Dimension</rdfs:label>
        <rdfs:comment>Stores product and offer attributes used to analyze bookings by product identity, family, technology domain, offer type, and business entity.</rdfs:comment>
        <qb:businessDefinition>Stores product and offer attributes used to analyze bookings by product identity, family, technology domain, offer type, and business entity.</qb:businessDefinition>
        <qb:businessDomain>Product Management</qb:businessDomain>
        <qb:sourceEntity>ENT006</qb:sourceEntity>
        <qb:sourceTable>quotetobooking.dim_product</qb:sourceTable>
    </owl:Class>

    <owl:Class rdf:about="http://example.com/ontology/quotetobooking#SalesRepresentativeDimension">
        <rdfs:subClassOf rdf:resource="http://example.com/ontology/quotetobooking#DimensionEntity"/>
        <rdfs:label>Sales Representative Dimension</rdfs:label>
        <rdfs:comment>Stores sales representative attributes used to analyze bookings by sales person, role, team, and market segment coverage.</rdfs:comment>
        <qb:businessDefinition>Stores sales representative attributes used to analyze bookings by sales person, role, team, and market segment coverage.</qb:businessDefinition>
        <qb:businessDomain>Sales Organization</qb:businessDomain>
        <qb:sourceEntity>ENT007</qb:sourceEntity>
        <qb:sourceTable>quotetobooking.dim_sales_rep</qb:sourceTable>
    </owl:Class>

    <owl:Class rdf:about="http://example.com/ontology/quotetobooking#BookingFact">
        <rdfs:subClassOf rdf:resource="http://example.com/ontology/quotetobooking#TransactionEntity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.com/ontology/quotetobooking#hasContractDimension"/>
                <owl:allValuesFrom rdf:resource="http://example.com/ontology/quotetobooking#ContractDimension"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.com/ontology/quotetobooking#hasCustomerDimension"/>
                <owl:allValuesFrom rdf:resource="http://example.com/ontology/quotetobooking#CustomerDimension"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.com/ontology/quotetobooking#hasDateDimension"/>
                <owl:allValuesFrom rdf:resource="http://example.com/ontology/quotetobooking#DateDimension"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.com/ontology/quotetobooking#hasGeographyDimension"/>
                <owl:allValuesFrom rdf:resource="http://example.com/ontology/quotetobooking#GeographyDimension"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.com/ontology/quotetobooking#hasPartnerDimension"/>
                <owl:allValuesFrom rdf:resource="http://example.com/ontology/quotetobooking#PartnerDimension"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.com/ontology/quotetobooking#hasProductDimension"/>
                <owl:allValuesFrom rdf:resource="http://example.com/ontology/quotetobooking#ProductDimension"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.com/ontology/quotetobooking#hasSalesRepresentativeDimension"/>
                <owl:allValuesFrom rdf:resource="http://example.com/ontology/quotetobooking#SalesRepresentativeDimension"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Booking Fact</rdfs:label>
        <rdfs:comment>Stores individual booking transactions and their financial measures for analyzing sales performance across customers, products, partners, geographies, contracts, sales representatives, and time.</rdfs:comment>
        <qb:businessDefinition>Stores individual booking transactions and their financial measures for analyzing sales performance across customers, products, partners, geographies, contracts, sales representatives, and time.</qb:businessDefinition>
        <qb:businessDomain>Sales Transactions</qb:businessDomain>
        <qb:sourceEntity>ENT008</qb:sourceEntity>
        <qb:sourceTable>quotetobooking.fact_bookings</qb:sourceTable>
    </owl:Class>

    <owl:AllDisjointClasses>
        <owl:members rdf:parseType="Collection">
            <rdf:Description rdf:about="http://example.com/ontology/quotetobooking#ContractDimension"/>
            <rdf:Description rdf:about="http://example.com/ontology/quotetobooking#CustomerDimension"/>
            <rdf:Description rdf:about="http://example.com/ontology/quotetobooking#DateDimension"/>
