<?xml version="1.0"?>
<rdf:RDF
    xmlns="http://example.com/ontology/enterprise-sales-bookings#"
    xml:base="http://example.com/ontology/enterprise-sales-bookings"
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#">

    <owl:Ontology rdf:about="http://example.com/ontology/enterprise-sales-bookings">
        <rdfs:label>Enterprise Sales Bookings Ontology</rdfs:label>
        <rdfs:comment>OWL 2 ontology generated from the OSI Semantic Model for Sales Bookings and Revenue Analytics. The business process document was not readable from the provided repository path, so business process-derived enrichment and rule extraction were limited to concepts explicitly supported by the semantic model. Validation warnings preserved: business process document unreadable; no explicit duplicate entities detected; no invalid semantic references detected in the semantic model; some glossary confidence scores below 1.00 for Date Key and Renewal Indicator.</rdfs:comment>
        <owl:versionInfo>1.0.0</owl:versionInfo>
    </owl:Ontology>

    <!-- Classes -->
    <owl:Class rdf:about="#Contract"><rdfs:label>Contract</rdfs:label><rdfs:comment>Stores the business attributes of commercial agreements associated with bookings, including contract type, term, renewal behavior, and support coverage level.</rdfs:comment></owl:Class>
    <owl:Class rdf:about="#Customer"><rdfs:label>Customer</rdfs:label><rdfs:comment>Stores descriptive information about customers that place orders and generate bookings, including segment, industry, account tier, and headquarters location.</rdfs:comment></owl:Class>
    <owl:Class rdf:about="#Date"><rdfs:label>Date</rdfs:label><rdfs:comment>Stores calendar and fiscal date attributes used to analyze bookings over time.</rdfs:comment></owl:Class>
    <owl:Class rdf:about="#Geography"><rdfs:label>Geography</rdfs:label><rdfs:comment>Stores geographic attributes used to analyze bookings by sales region, theater, and country.</rdfs:comment></owl:Class>
    <owl:Class rdf:about="#Partner"><rdfs:label>Partner</rdfs:label><rdfs:comment>Stores information about channel and direct partners involved in the sales process, including partner type, partner tier, and route to market.</rdfs:comment></owl:Class>
    <owl:Class rdf:about="#Product"><rdfs:label>Product</rdfs:label><rdfs:comment>Stores descriptive information about products and offers sold to customers, including product family, technology domain, offer type, and business entity.</rdfs:comment></owl:Class>
    <owl:Class rdf:about="#SalesRepresentative"><rdfs:label>Sales Representative</rdfs:label><rdfs:comment>Stores information about sales personnel responsible for managing customer relationships and booking transactions.</rdfs:comment></owl:Class>
    <owl:Class rdf:about="#BookingTransaction"><rdfs:label>Booking Transaction</rdfs:label><rdfs:comment>Stores individual completed sales booking transactions with related financial measures and links to customer, product, partner, geography, sales representative, contract, and date dimensions.</rdfs:comment></owl:Class>

    <!-- Metadata Classes -->
    <owl:Class rdf:about="#Attribute"><rdfs:label>Attribute</rdfs:label><rdfs:comment>Metadata class representing a business attribute, identifier, measure field, or business field from the semantic model.</rdfs:comment></owl:Class>
    <owl:Class rdf:about="#Measure"><rdfs:label>Measure</rdfs:label><rdfs:comment>Metadata class representing an aggregatable business measure from the semantic model.</rdfs:comment></owl:Class>
    <owl:Class rdf:about="#BusinessRule"><rdfs:label>Business Rule</rdfs:label><rdfs:comment>Metadata class representing explicit business rules supported by the semantic model.</rdfs:comment></owl:Class>
    <owl:Class rdf:about="#GlossaryTerm"><rdfs:label>Glossary Term</rdfs:label><rdfs:comment>Metadata class representing business glossary terms for semantic exploration.</rdfs:comment></owl:Class>

    <!-- Disjointness -->
    <owl:AllDisjointClasses>
        <owl:members rdf:parseType="Collection">
            <rdf:Description rdf:about="#Contract"/>
            <rdf:Description rdf:about="#Customer"/>
            <rdf:Description rdf:about="#Date"/>
            <rdf:Description rdf:about="#Geography"/>
            <rdf:Description rdf:about="#Partner"/>
            <rdf:Description rdf:about="#Product"/>
            <rdf:Description rdf:about="#SalesRepresentative"/>
            <rdf:Description rdf:about="#BookingTransaction"/>
        </owl:members>
    </owl:AllDisjointClasses>

    <!-- Object Properties -->
    <owl:ObjectProperty rdf:about="#hasContract"><rdfs:label>has contract</rdfs:label><rdfs:comment>Relates a booking transaction to its associated contract.</rdfs:comment><rdfs:domain rdf:resource="#BookingTransaction"/><rdfs:range rdf:resource="#Contract"/><owl:inverseOf rdf:resource="#isContractOfBookingTransaction"/><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#isContractOfBookingTransaction"><rdfs:label>is contract of booking transaction</rdfs:label><rdfs:comment>Inverse of hasContract.</rdfs:comment><rdfs:domain rdf:resource="#Contract"/><rdfs:range rdf:resource="#BookingTransaction"/></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#hasCustomer"><rdfs:label>has customer</rdfs:label><rdfs:comment>Relates a booking transaction to the customer that generated the booking.</rdfs:comment><rdfs:domain rdf:resource="#BookingTransaction"/><rdfs:range rdf:resource="#Customer"/><owl:inverseOf rdf:resource="#isCustomerOfBookingTransaction"/><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#isCustomerOfBookingTransaction"><rdfs:label>is customer of booking transaction</rdfs:label><rdfs:comment>Inverse of hasCustomer.</rdfs:comment><rdfs:domain rdf:resource="#Customer"/><rdfs:range rdf:resource="#BookingTransaction"/></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#hasBookingDate"><rdfs:label>has booking date</rdfs:label><rdfs:comment>Relates a booking transaction to its reporting date.</rdfs:comment><rdfs:domain rdf:resource="#BookingTransaction"/><rdfs:range rdf:resource="#Date"/><owl:inverseOf rdf:resource="#isDateOfBookingTransaction"/><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#isDateOfBookingTransaction"><rdfs:label>is date of booking transaction</rdfs:label><rdfs:comment>Inverse of hasBookingDate.</rdfs:comment><rdfs:domain rdf:resource="#Date"/><rdfs:range rdf:resource="#BookingTransaction"/></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#hasGeography"><rdfs:label>has geography</rdfs:label><rdfs:comment>Relates a booking transaction to the geography used for reporting.</rdfs:comment><rdfs:domain rdf:resource="#BookingTransaction"/><rdfs:range rdf:resource="#Geography"/><owl:inverseOf rdf:resource="#isGeographyOfBookingTransaction"/><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#isGeographyOfBookingTransaction"><rdfs:label>is geography of booking transaction</rdfs:label><rdfs:comment>Inverse of hasGeography.</rdfs:comment><rdfs:domain rdf:resource="#Geography"/><rdfs:range rdf:resource="#BookingTransaction"/></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#hasPartner"><rdfs:label>has partner</rdfs:label><rdfs:comment>Relates a booking transaction to the partner involved in the transaction.</rdfs:comment><rdfs:domain rdf:resource="#BookingTransaction"/><rdfs:range rdf:resource="#Partner"/><owl:inverseOf rdf:resource="#isPartnerOfBookingTransaction"/><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#isPartnerOfBookingTransaction"><rdfs:label>is partner of booking transaction</rdfs:label><rdfs:comment>Inverse of hasPartner.</rdfs:comment><rdfs:domain rdf:resource="#Partner"/><rdfs:range rdf:resource="#BookingTransaction"/></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#hasProduct"><rdfs:label>has product</rdfs:label><rdfs:comment>Relates a booking transaction to the booked product.</rdfs:comment><rdfs:domain rdf:resource="#BookingTransaction"/><rdfs:range rdf:resource="#Product"/><owl:inverseOf rdf:resource="#isProductOfBookingTransaction"/><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#isProductOfBookingTransaction"><rdfs:label>is product of booking transaction</rdfs:label><rdfs:comment>Inverse of hasProduct.</rdfs:comment><rdfs:domain rdf:resource="#Product"/><rdfs:range rdf:resource="#BookingTransaction"/></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#hasSalesRepresentative"><rdfs:label>has sales representative</rdfs:label><rdfs:comment>Relates a booking transaction to the responsible sales representative.</rdfs:comment><rdfs:domain rdf:resource="#BookingTransaction"/><rdfs:range rdf:resource="#SalesRepresentative"/><owl:inverseOf rdf:resource="#isSalesRepresentativeOfBookingTransaction"/><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#isSalesRepresentativeOfBookingTransaction"><rdfs:label>is sales representative of booking transaction</rdfs:label><rdfs:comment>Inverse of hasSalesRepresentative.</rdfs:comment><rdfs:domain rdf:resource="#SalesRepresentative"/><rdfs:range rdf:resource="#BookingTransaction"/></owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasAttribute"><rdfs:label>has attribute</rdfs:label><rdfs:comment>Relates a business entity to an attribute metadata individual that describes one of its business fields.</rdfs:comment></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#hasMeasure"><rdfs:label>has measure</rdfs:label><rdfs:comment>Relates a business entity to a measure metadata individual.</rdfs:comment></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#hasBusinessRule"><rdfs:label>has business rule</rdfs:label><rdfs:comment>Relates a business entity to a business rule metadata individual.</rdfs:comment></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#hasGlossaryTerm"><rdfs:label>has glossary term</rdfs:label><rdfs:comment>Relates a business entity to a glossary term metadata individual.</rdfs:comment></owl:ObjectProperty>

    <!-- Datatype Properties -->
    <owl:DatatypeProperty rdf:about="#contractKey"><rdfs:label>Contract Key</rdfs:label><rdfs:comment>Surrogate key that uniquely identifies a contract record in the contract dimension. Source Table: QuoteToBooking.dim_contract. Source Column: contract_key. Business Definition: Surrogate key that uniquely identifies a contract record in the contract dimension.</rdfs:comment><rdfs:domain rdf:resource="#Contract"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#contractType"><rdfs:label>Contract Type</rdfs:label><rdfs:comment>Describes the type of commercial agreement attached to the booking, such as SaaS subscription, Enterprise Agreement, or support contract. Source Table: QuoteToBooking.dim_contract. Source Column: contract_type. Business Definition: Describes the type of commercial agreement attached to the booking, such as SaaS subscription, Enterprise Agreement, or support contract.</rdfs:comment><rdfs:domain rdf:resource="#Contract"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#termMonths"><rdfs:label>Contract Term Months</rdfs:label><rdfs:comment>Indicates the duration of the contract in months. Source Table: QuoteToBooking.dim_contract. Source Column: term_months. Business Definition: Indicates the duration of the contract in months.</rdfs:comment><rdfs:domain rdf:resource="#Contract"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#autoRenewFlag"><rdfs:label>Auto Renew Flag</rdfs:label><rdfs:comment>Indicates whether the contract is set to renew automatically at the end of its term. Source Table: QuoteToBooking.dim_contract. Source Column: auto_renew_flag. Business Definition: Indicates whether the contract is set to renew automatically at the end of its term.</rdfs:comment><rdfs:domain rdf:resource="#Contract"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#coverageLevel"><rdfs:label>Coverage Level</rdfs:label><rdfs:comment>Describes the level of service or support coverage provided under the contract. Source Table: QuoteToBooking.dim_contract. Source Column: coverage_level. Business Definition: Describes the level of service or support coverage provided under the contract.</rdfs:comment><rdfs:domain rdf:resource="#Contract"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/></owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#customerKey"><rdfs:label>Customer Key</rdfs:label><rdfs:comment>Surrogate key that uniquely identifies a customer record in the customer dimension. Source Table: QuoteToBooking.dim_customer. Source Column: customer_key. Business Definition: Surrogate key that uniquely identifies a customer record in the customer dimension.</rdfs:comment><rdfs:domain rdf:resource="#Customer"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#customerId"><rdfs:label>Customer ID</rdfs:label><rdfs:comment>Business identifier assigned to the customer account. Source Table: QuoteToBooking.dim_customer. Source Column: customer_id. Business Definition: Business identifier assigned to the customer account.</rdfs:comment><rdfs:domain rdf:resource="#Customer"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#customerName"><rdfs:label>Customer Name</rdfs:label><rdfs:comment>Official name of the customer organization that purchased products or services. Source Table: QuoteToBooking.dim_customer. Source Column: customer_name. Business Definition: Official name of the customer organization that purchased products or services.</rdfs:comment><rdfs:domain rdf:resource="#Customer"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#segment"><rdfs:label>Customer Segment</rdfs:label><rdfs:comment>Classifies the customer into a business segment such as Enterprise, Service Provider, or Public Sector. Source Table: QuoteToBooking.dim_customer. Source Column: segment. Business Definition: Classifies the customer into a business segment such as Enterprise, Service Provider, or Public Sector.</rdfs:comment><rdfs:domain rdf:resource="#Customer"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#industry"><rdfs:label>Industry</rdfs:label><rdfs:comment>Identifies the industry in which the customer operates. Source Table: QuoteToBooking.dim_customer. Source Column: industry. Business Definition: Identifies the industry in which the customer operates.</rdfs:comment><rdfs:domain rdf:resource="#Customer"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#accountTier"><rdfs:label>Account Tier</rdfs:label><rdfs:comment>Indicates the strategic importance or service tier of the customer account. Source Table: QuoteToBooking.dim_customer. Source Column: account_tier. Business Definition: Indicates the strategic importance or service tier of the customer account.</rdfs:comment><rdfs:domain rdf:resource="#Customer"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#hqCountry"><rdfs:label>Headquarters Country</rdfs:label><rdfs:comment>Country where the customer organization's headquarters is located. Source Table: QuoteToBooking.dim_customer. Source Column: hq_country. Business Definition: Country where the customer organization's headquarters is located.</rdfs:comment><rdfs:domain rdf:resource="#Customer"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#hqRegion"><rdfs:label>Headquarters Region</rdfs:label><rdfs:comment>Global region where the customer organization's headquarters is located. Source Table: QuoteToBooking.dim_customer. Source Column: hq_region. Business Definition: Global region where the customer organization's headquarters is located.</rdfs:comment><rdfs:domain rdf:resource="#Customer"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/></owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#dateKey"><rdfs:label>Date Key</rdfs:label><rdfs:comment>Encoded key that uniquely identifies a reporting date in the date dimension. Source Table: QuoteToBooking.dim_date. Source Column: date_key. Business Definition: Encoded key that uniquely identifies a reporting date in the date dimension.</rdfs:comment><rdfs:domain rdf:resource="#Date"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#fullDate"><rdfs:label>Full Date</rdfs:label><rdfs:comment>Actual calendar date represented by the date record. Source Table: QuoteToBooking.dim_date. Source Column: full_date. Business Definition: Actual calendar date represented by the date record.</rdfs:comment><rdfs:domain rdf:resource="#Date"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#monthName"><rdfs:label>Month Name</rdfs:label><rdfs:comment>Name of the calendar month for the date. Source Table: QuoteToBooking.dim_date. Source Column: month_name. Business Definition: Name of the calendar month for the date.</rdfs:comment><rdfs:domain rdf:resource="#Date"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#calendarYear"><rdfs:label>Calendar Year</rdfs:label><rdfs:comment>Four-digit calendar year associated with the date. Source Table: QuoteToBooking.dim_date. Source Column: calendar_year. Business Definition: Four-digit calendar year associated with the date.</rdfs:comment><rdfs:domain rdf:resource="#Date"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#fiscalYear"><rdfs:label>Fiscal Year</rdfs:label><rdfs:comment>Fiscal year used by the business for financial and performance reporting. Source Table: QuoteToBooking.dim_date. Source Column: fiscal_year. Business Definition: Fiscal year used by the business for financial and performance reporting.</rdfs:comment><rdfs:domain rdf:resource="#Date"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#fiscalQuarter"><rdfs:label>Fiscal Quarter</rdfs:label><rdfs:comment>Fiscal quarter used by the business for periodic reporting and analysis. Source Table: QuoteToBooking.dim_date. Source Column: fiscal_quarter. Business Definition: Fiscal quarter used by the business for periodic reporting and analysis.</rdfs:comment><rdfs:domain rdf:resource="#Date"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#fiscalPeriodSeq"><rdfs:label>Fiscal Period Sequence</rdfs:label><rdfs:comment>Sequential number representing the fiscal reporting period in ordered time analysis. Source Table: QuoteToBooking.dim_date. Source Column: fiscal_period_seq. Business Definition: Sequential number representing the fiscal reporting period in ordered time analysis.</rdfs:comment><rdfs:domain rdf:resource="#Date"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/></owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#geographyKey"><rdfs:label>Geography Key</rdfs:label><rdfs:comment>Surrogate key that uniquely identifies a geography record in the geography dimension. Source Table: QuoteToBooking.dim_geography. Source Column: geography_key. Business Definition: Surrogate key that uniquely identifies a geography record in the geography dimension.</rdfs:comment><rdfs:domain rdf:resource="#Geography"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#region"><rdfs:label>Sales Region</rdfs:label><rdfs:comment>High-level geographic region used for reporting and performance analysis. Source Table: QuoteToBooking.dim_geography. Source Column: region. Business Definition: High-level geographic region used for reporting and performance analysis.</rdfs:comment><rdfs:domain rdf:resource="#Geography"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#theater"><rdfs:label>Sales Theater</rdfs:label><rdfs:comment>Subregional sales area or theater used to organize market coverage and reporting. Source Table: QuoteToBooking.dim_geography. Source Column: theater. Business Definition: Subregional sales area or theater used to organize market coverage and reporting.</rdfs:comment><rdfs:domain rdf:resource="#Geography"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#country"><rdfs:label>Country</rdfs:label><rdfs:comment>Country associated with the geography record. Source Table: QuoteToBooking.dim_geography. Source Column: country. Business Definition: Country associated with the geography record.</rdfs:comment><rdfs:domain rdf:resource="#Geography"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/></owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#partnerKey"><rdfs:label>Partner Key</rdfs:label><rdfs:comment>Surrogate key that uniquely identifies a partner record in the partner dimension. Source Table: QuoteToBooking.dim_partner. Source Column: partner_key. Business Definition: Surrogate key that uniquely identifies a partner record in the partner dimension.</rdfs:comment><rdfs:domain rdf:resource="#Partner"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#partnerId"><rdfs:label>Partner ID</rdfs:label><rdfs:comment>Business identifier assigned to the partner organization. Source Table: QuoteToBooking.dim_partner. Source Column: partner_id. Business Definition: Business identifier assigned to the partner organization.</rdfs:comment><rdfs:domain rdf:resource="#Partner"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#partnerName"><rdfs:label>Partner Name</rdfs:label><rdfs:comment>Name of the partner organization involved in the transaction. Source Table: QuoteToBooking.dim_partner. Source Column: partner_name. Business Definition: Name of the partner organization involved in the transaction.</rdfs:comment><rdfs:domain rdf:resource="#Partner"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#partnerType"><rdfs:label>Partner Type</rdfs:label><rdfs:comment>Classifies the partner by operating model, such as distributor, reseller, systems integrator, or direct. Source Table: QuoteToBooking.dim_partner. Source Column: partner_type. Business Definition: Classifies the partner by operating model, such as distributor, reseller, systems integrator, or direct.</rdfs:comment><rdfs:domain rdf:resource="#Partner"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#partnerTier"><rdfs:label>Partner Tier</rdfs:label><rdfs:comment>Indicates the certification, authorization, or strategic tier assigned to the partner. Source Table: QuoteToBooking.dim_partner. Source Column: partner_tier. Business Definition: Indicates the certification, authorization, or strategic tier assigned to the partner.</rdfs:comment><rdfs:domain rdf:resource="#Partner"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#routeToMarket"><rdfs:label>Route to Market</rdfs:label><rdfs:comment>Describes the sales delivery path through which the product or service reached the customer. Source Table: QuoteToBooking.dim_partner. Source Column: route_to_market. Business Definition: Describes the sales delivery path through which the product or service reached the customer.</rdfs:comment><rdfs:domain rdf:resource="#Partner"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/></owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#productKey"><rdfs:label>Product Key</rdfs:label><rdfs:comment>Surrogate key that uniquely identifies a product record in the product dimension. Source Table: QuoteToBooking.dim_product. Source Column: product_key. Business Definition: Surrogate key that uniquely identifies a product record in the product dimension.</rdfs:comment><rdfs:domain rdf:resource="#Product"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#productId"><rdfs:label>Product ID</rdfs:label><rdfs:comment>Business identifier or SKU assigned to the product or offer. Source Table: QuoteToBooking.dim_product. Source Column: product_id. Business Definition: Business identifier or SKU assigned to the product or offer.</rdfs:comment><rdfs:domain rdf:resource="#Product"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#productName"><rdfs:label>Product Name</rdfs:label><rdfs:comment>Commercial name of the product or subscription offer sold to the customer. Source Table: QuoteToBooking.dim_product. Source Column: product_name. Business Definition: Commercial name of the product or subscription offer sold to the customer.</rdfs:comment><rdfs:domain rdf:resource="#Product"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#productFamily"><rdfs:label>Product Family</rdfs:label><rdfs:comment>Higher-level product grouping used for portfolio and performance analysis. Source Table: QuoteToBooking.dim_product. Source Column: product_family. Business Definition: Higher-level product grouping used for portfolio and performance analysis.</rdfs:comment><rdfs:domain rdf:resource="#Product"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#technologyDomain"><rdfs:label>Technology Domain</rdfs:label><rdfs:comment>Technology area or solution domain to which the product belongs. Source Table: QuoteToBooking.dim_product. Source Column: technology_domain. Business Definition: Technology area or solution domain to which the product belongs.</rdfs:comment><rdfs:domain rdf:resource="#Product"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#offerType"><rdfs:label>Offer Type</rdfs:label><rdfs:comment>Indicates whether the item is sold as hardware, software subscription, or SaaS subscription. Source Table: QuoteToBooking.dim_product. Source Column: offer_type. Business Definition: Indicates whether the item is sold as hardware, software subscription, or SaaS subscription.</rdfs:comment><rdfs:domain rdf:resource="#Product"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#businessEntity"><rdfs:label>Business Entity</rdfs:label><rdfs:comment>Internal business unit or portfolio responsible for the product. Source Table: QuoteToBooking.dim_product. Source Column: business_entity. Business Definition: Internal business unit or portfolio responsible for the product.</rdfs:comment><rdfs:domain rdf:resource="#Product"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/></owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#salesRepKey"><rdfs:label>Sales Representative Key</rdfs:label><rdfs:comment>Surrogate key that uniquely identifies a sales representative record in the sales representative dimension. Source Table: QuoteToBooking.dim_sales_rep. Source Column: sales_rep_key. Business Definition: Surrogate key that uniquely identifies a sales representative record in the sales representative dimension.</rdfs:comment><rdfs:domain rdf:resource="#SalesRepresentative"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/></owl:DatatypeProperty>
