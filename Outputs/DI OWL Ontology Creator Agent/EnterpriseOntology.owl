  <owl:Class rdf:about="http://example.org/ontology/sales-bookings-revenue#DomainConcept">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:label>Domain Concept</rdfs:label>
    <rdfs:comment>Top-level conceptual class for all business concepts in the ontology.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/ontology/sales-bookings-revenue#BusinessEntity">
    <rdfs:subClassOf rdf:resource="http://example.org/ontology/sales-bookings-revenue#DomainConcept"/>
    <rdfs:label>Business Entity</rdfs:label>
    <rdfs:comment>Top-level class for business entities represented in the semantic model.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/ontology/sales-bookings-revenue#DimensionEntity">
    <rdfs:subClassOf rdf:resource="http://example.org/ontology/sales-bookings-revenue#BusinessEntity"/>
    <rdfs:label>Dimension Entity</rdfs:label>
    <rdfs:comment>Class for dimensional business entities used to describe bookings.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/ontology/sales-bookings-revenue#TransactionEntity">
    <rdfs:subClassOf rdf:resource="http://example.org/ontology/sales-bookings-revenue#BusinessEntity"/>
    <rdfs:label>Transaction Entity</rdfs:label>
    <rdfs:comment>Class for transactional business entities that record measurable business events.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/ontology/sales-bookings-revenue#Contract">
    <rdfs:subClassOf rdf:resource="http://example.org/ontology/sales-bookings-revenue#DimensionEntity"/>
    <rdfs:label>Contract</rdfs:label>
    <rdfs:comment>Stores the business attributes of commercial agreements associated with bookings, including contract type, term, renewal behavior, and support coverage level.</rdfs:comment>
    <enterprise:businessDefinition>Stores the business attributes of commercial agreements associated with bookings, including contract type, term, renewal behavior, and support coverage level.</enterprise:businessDefinition>
    <enterprise:sourceEntity>ENT001</enterprise:sourceEntity>
    <enterprise:sourceTable>QuoteToBooking.dim_contract</enterprise:sourceTable>
    <enterprise:businessDomain>Sales Bookings and Revenue Analytics</enterprise:businessDomain>
    <enterprise:sourceSemanticModel>OSI Semantic Model.md</enterprise:sourceSemanticModel>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/ontology/sales-bookings-revenue#Customer">
    <rdfs:subClassOf rdf:resource="http://example.org/ontology/sales-bookings-revenue#DimensionEntity"/>
    <rdfs:label>Customer</rdfs:label>
    <rdfs:comment>Stores descriptive information about customers that place orders and generate bookings, including segment, industry, account tier, and headquarters location.</rdfs:comment>
    <enterprise:businessDefinition>Stores descriptive information about customers that place orders and generate bookings, including segment, industry, account tier, and headquarters location.</enterprise:businessDefinition>
    <enterprise:sourceEntity>ENT002</enterprise:sourceEntity>
    <enterprise:sourceTable>QuoteToBooking.dim_customer</enterprise:sourceTable>
    <enterprise:businessDomain>Sales Bookings and Revenue Analytics</enterprise:businessDomain>
    <enterprise:sourceSemanticModel>OSI Semantic Model.md</enterprise:sourceSemanticModel>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/ontology/sales-bookings-revenue#Date">
    <rdfs:subClassOf rdf:resource="http://example.org/ontology/sales-bookings-revenue#DimensionEntity"/>
    <rdfs:label>Date</rdfs:label>
    <rdfs:comment>Stores calendar and fiscal date attributes used to analyze bookings over time.</rdfs:comment>
    <enterprise:businessDefinition>Stores calendar and fiscal date attributes used to analyze bookings over time.</enterprise:businessDefinition>
    <enterprise:sourceEntity>ENT003</enterprise:sourceEntity>
    <enterprise:sourceTable>QuoteToBooking.dim_date</enterprise:sourceTable>
    <enterprise:businessDomain>Sales Bookings and Revenue Analytics</enterprise:businessDomain>
    <enterprise:sourceSemanticModel>OSI Semantic Model.md</enterprise:sourceSemanticModel>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/ontology/sales-bookings-revenue#Geography">
    <rdfs:subClassOf rdf:resource="http://example.org/ontology/sales-bookings-revenue#DimensionEntity"/>
    <rdfs:label>Geography</rdfs:label>
    <rdfs:comment>Stores geographic attributes used to analyze bookings by sales region, theater, and country.</rdfs:comment>
    <enterprise:businessDefinition>Stores geographic attributes used to analyze bookings by sales region, theater, and country.</enterprise:businessDefinition>
    <enterprise:sourceEntity>ENT004</enterprise:sourceEntity>
    <enterprise:sourceTable>QuoteToBooking.dim_geography</enterprise:sourceTable>
    <enterprise:businessDomain>Sales Bookings and Revenue Analytics</enterprise:businessDomain>
    <enterprise:sourceSemanticModel>OSI Semantic Model.md</enterprise:sourceSemanticModel>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/ontology/sales-bookings-revenue#Partner">
    <rdfs:subClassOf rdf:resource="http://example.org/ontology/sales-bookings-revenue#DimensionEntity"/>
    <rdfs:label>Partner</rdfs:label>
    <rdfs:comment>Stores information about channel and direct partners involved in the sales process, including partner type, partner tier, and route to market.</rdfs:comment>
    <enterprise:businessDefinition>Stores information about channel and direct partners involved in the sales process, including partner type, partner tier, and route to market.</enterprise:businessDefinition>
    <enterprise:sourceEntity>ENT005</enterprise:sourceEntity>
    <enterprise:sourceTable>QuoteToBooking.dim_partner</enterprise:sourceTable>
    <enterprise:businessDomain>Sales Bookings and Revenue Analytics</enterprise:businessDomain>
    <enterprise:sourceSemanticModel>OSI Semantic Model.md</enterprise:sourceSemanticModel>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/ontology/sales-bookings-revenue#Product">
    <rdfs:subClassOf rdf:resource="http://example.org/ontology/sales-bookings-revenue#DimensionEntity"/>
    <rdfs:label>Product</rdfs:label>
    <rdfs:comment>Stores descriptive information about products and offers sold to customers, including product family, technology domain, offer type, and business entity.</rdfs:comment>
    <enterprise:businessDefinition>Stores descriptive information about products and offers sold to customers, including product family, technology domain, offer type, and business entity.</enterprise:businessDefinition>
    <enterprise:sourceEntity>ENT006</enterprise:sourceEntity>
    <enterprise:sourceTable>QuoteToBooking.dim_product</enterprise:sourceTable>
    <enterprise:businessDomain>Sales Bookings and Revenue Analytics</enterprise:businessDomain>
    <enterprise:sourceSemanticModel>OSI Semantic Model.md</enterprise:sourceSemanticModel>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/ontology/sales-bookings-revenue#SalesRepresentative">
    <rdfs:subClassOf rdf:resource="http://example.org/ontology/sales-bookings-revenue#DimensionEntity"/>
    <rdfs:label>Sales Representative</rdfs:label>
    <rdfs:comment>Stores information about sales personnel responsible for managing customer relationships and booking transactions.</rdfs:comment>
    <enterprise:businessDefinition>Stores information about sales personnel responsible for managing customer relationships and booking transactions.</enterprise:businessDefinition>
    <enterprise:sourceEntity>ENT007</enterprise:sourceEntity>
    <enterprise:sourceTable>QuoteToBooking.dim_sales_rep</enterprise:sourceTable>
    <enterprise:businessDomain>Sales Bookings and Revenue Analytics</enterprise:businessDomain>
    <enterprise:sourceSemanticModel>OSI Semantic Model.md</enterprise:sourceSemanticModel>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/ontology/sales-bookings-revenue#BookingTransaction">
    <rdfs:subClassOf rdf:resource="http://example.org/ontology/sales-bookings-revenue#TransactionEntity"/>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://example.org/ontology/sales-bookings-revenue#hasContract"/>
        <owl:someValuesFrom rdf:resource="http://example.org/ontology/sales-bookings-revenue#Contract"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://example.org/ontology/sales-bookings-revenue#hasCustomer"/>
        <owl:someValuesFrom rdf:resource="http://example.org/ontology/sales-bookings-revenue#Customer"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://example.org/ontology/sales-bookings-revenue#hasBookingDate"/>
        <owl:someValuesFrom rdf:resource="http://example.org/ontology/sales-bookings-revenue#Date"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://example.org/ontology/sales-bookings-revenue#hasGeography"/>
        <owl:someValuesFrom rdf:resource="http://example.org/ontology/sales-bookings-revenue#Geography"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://example.org/ontology/sales-bookings-revenue#hasPartner"/>
        <owl:someValuesFrom rdf:resource="http://example.org/ontology/sales-bookings-revenue#Partner"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://example.org/ontology/sales-bookings-revenue#hasProduct"/>
        <owl:someValuesFrom rdf:resource="http://example.org/ontology/sales-bookings-revenue#Product"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://example.org/ontology/sales-bookings-revenue#hasSalesRepresentative"/>
        <owl:someValuesFrom rdf:resource="http://example.org/ontology/sales-bookings-revenue#SalesRepresentative"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:label>Booking Transaction</rdfs:label>
    <rdfs:comment>Stores individual completed sales booking transactions with related financial measures and links to customer, product, partner, geography, sales representative, contract, and date dimensions.</rdfs:comment>
    <enterprise:businessDefinition>Stores individual completed sales booking transactions with related financial measures and links to customer, product, partner, geography, sales representative, contract, and date dimensions.</enterprise:businessDefinition>
    <enterprise:sourceEntity>ENT008</enterprise:sourceEntity>
    <enterprise:sourceTable>QuoteToBooking.fact_bookings</enterprise:sourceTable>
    <enterprise:businessDomain>Sales Bookings and Revenue Analytics</enterprise:businessDomain>
    <enterprise:sourceSemanticModel>OSI Semantic Model.md</enterprise:sourceSemanticModel>
  </owl:Class>

  <owl:AllDisjointClasses>
    <owl:members rdf:parseType="Collection">
      <rdf:Description rdf:about="http://example.org/ontology/sales-bookings-revenue#Contract"/>
      <rdf:Description rdf:about="http://example.org/ontology/sales-bookings-revenue#Customer"/>
      <rdf:Description rdf:about="http://example.org/ontology/sales-bookings-revenue#Date"/>
      <rdf:Description rdf:about="http://example.org/ontology/sales-bookings-revenue#Geography"/>
