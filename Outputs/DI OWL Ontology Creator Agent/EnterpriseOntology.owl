    <owl:NamedIndividual rdf:about="#booking_type_attr"><rdf:type rdf:resource="#Attribute"/><rdfs:label>Booking Type</rdfs:label><rdfs:comment>Indicates whether the booking is a new sale or a renewal.</rdfs:comment></owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#renewal_indicator"><rdf:type rdf:resource="#Attribute"/><rdfs:label>Renewal Indicator</rdfs:label><rdfs:comment>Indicates whether the booking transaction is classified as a renewal.</rdfs:comment></owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#quantity_sold_attr"><rdf:type rdf:resource="#Attribute"/><rdfs:label>Quantity Sold</rdfs:label><rdfs:comment>Number of units, licenses, or subscriptions included in the booking transaction.</rdfs:comment></owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#unit_list_price_usd_attr"><rdf:type rdf:resource="#Attribute"/><rdfs:label>Unit List Price USD</rdfs:label><rdfs:comment>Standard list price per unit in U.S. dollars before discounts are applied.</rdfs:comment></owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#discount_percentage_attr"><rdf:type rdf:resource="#Attribute"/><rdfs:label>Discount Percentage</rdfs:label><rdfs:comment>Percentage discount applied to the list price for the booking transaction.</rdfs:comment></owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#booking_amount_usd_attr"><rdf:type rdf:resource="#Attribute"/><rdfs:label>Booking Amount USD</rdfs:label><rdfs:comment>Total booked revenue amount for the transaction in U.S. dollars after pricing adjustments.</rdfs:comment></owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#acv_usd_attr"><rdf:type rdf:resource="#Attribute"/><rdfs:label>Annual Contract Value USD</rdfs:label><rdfs:comment>Annualized value of the contract associated with the booking in U.S. dollars.</rdfs:comment></owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#tcv_usd_attr"><rdf:type rdf:resource="#Attribute"/><rdfs:label>Total Contract Value USD</rdfs:label><rdfs:comment>Total value of the full contract associated with the booking in U.S. dollars.</rdfs:comment></owl:NamedIndividual>

    <!-- Measure Metadata Individuals -->
    <owl:NamedIndividual rdf:about="#measure_quantity_sold"><rdf:type rdf:resource="#Measure"/><rdfs:label>Quantity Sold</rdfs:label><rdfs:comment>Number of units, licenses, or subscriptions included in the booking transaction. Aggregation Type: SUM.</rdfs:comment></owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#measure_unit_list_price_usd"><rdf:type rdf:resource="#Measure"/><rdfs:label>Unit List Price USD</rdfs:label><rdfs:comment>Standard list price per unit in U.S. dollars before discounts are applied. Aggregation Type: SUM.</rdfs:comment></owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#measure_discount_percentage"><rdf:type rdf:resource="#Measure"/><rdfs:label>Discount Percentage</rdfs:label><rdfs:comment>Percentage discount applied to the list price for the booking transaction. Aggregation Type: AVG.</rdfs:comment></owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#measure_booking_amount_usd"><rdf:type rdf:resource="#Measure"/><rdfs:label>Booking Amount USD</rdfs:label><rdfs:comment>Total booked revenue amount for the transaction in U.S. dollars after pricing adjustments. Aggregation Type: SUM.</rdfs:comment></owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#measure_acv_usd"><rdf:type rdf:resource="#Measure"/><rdfs:label>Annual Contract Value USD</rdfs:label><rdfs:comment>Annualized value of the contract associated with the booking in U.S. dollars. Aggregation Type: SUM.</rdfs:comment></owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#measure_tcv_usd"><rdf:type rdf:resource="#Measure"/><rdfs:label>Total Contract Value USD</rdfs:label><rdfs:comment>Total value of the full contract associated with the booking in U.S. dollars. Aggregation Type: SUM.</rdfs:comment></owl:NamedIndividual>

    <!-- Business Rule Metadata Individuals -->
    <owl:NamedIndividual rdf:about="#RenewalBooking"><rdf:type rdf:resource="#BusinessRule"/><rdfs:label>Renewal Booking</rdfs:label><rdfs:comment>A booking transaction classified as a renewal, supported by Booking Type and Renewal Indicator in the semantic model.</rdfs:comment></owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#NetNewBooking"><rdf:type rdf:resource="#BusinessRule"/><rdfs:label>Net New Booking</rdfs:label><rdfs:comment>A booking transaction classified as a new sale, supported by Booking Type in the semantic model.</rdfs:comment></owl:NamedIndividual>

    <!-- Glossary Individuals -->
    <owl:NamedIndividual rdf:about="#Glossary_Contract"><rdf:type rdf:resource="#GlossaryTerm"/><rdfs:label>Contract</rdfs:label><rdfs:comment>Stores the business attributes of commercial agreements associated with bookings, including contract type, term, renewal behavior, and support coverage level.</rdfs:comment></owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#Glossary_Customer"><rdf:type rdf:resource="#GlossaryTerm"/><rdfs:label>Customer</rdfs:label><rdfs:comment>Stores descriptive information about customers that place orders and generate bookings, including segment, industry, account tier, and headquarters location.</rdfs:comment></owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#Glossary_Date"><rdf:type rdf:resource="#GlossaryTerm"/><rdfs:label>Date</rdfs:label><rdfs:comment>Stores calendar and fiscal date attributes used to analyze bookings over time.</rdfs:comment></owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#Glossary_Geography"><rdf:type rdf:resource="#GlossaryTerm"/><rdfs:label>Geography</rdfs:label><rdfs:comment>Stores geographic attributes used to analyze bookings by sales region, theater, and country.</rdfs:comment></owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#Glossary_Partner"><rdf:type rdf:resource="#GlossaryTerm"/><rdfs:label>Partner</rdfs:label><rdfs:comment>Stores information about channel and direct partners involved in the sales process, including partner type, partner tier, and route to market.</rdfs:comment></owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#Glossary_Product"><rdf:type rdf:resource="#GlossaryTerm"/><rdfs:label>Product</rdfs:label><rdfs:comment>Stores descriptive information about products and offers sold to customers, including product family, technology domain, offer type, and business entity.</rdfs:comment></owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#Glossary_SalesRepresentative"><rdf:type rdf:resource="#GlossaryTerm"/><rdfs:label>Sales Representative</rdfs:label><rdfs:comment>Stores information about sales personnel responsible for managing customer relationships and booking transactions.</rdfs:comment></owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#Glossary_BookingTransaction"><rdf:type rdf:resource="#GlossaryTerm"/><rdfs:label>Booking Transaction</rdfs:label><rdfs:comment>Stores individual completed sales booking transactions with related financial measures and links to customer, product, partner, geography, sales representative, contract, and date dimensions.</rdfs:comment></owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#Glossary_TechnologyDomain"><rdf:type rdf:resource="#GlossaryTerm"/><rdfs:label>Technology Domain</rdfs:label><rdfs:comment>Technology area or solution domain to which the product belongs.</rdfs:comment></owl:NamedIndividual>

