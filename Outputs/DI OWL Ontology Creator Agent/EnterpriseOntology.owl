<?xml version="1.0"?>
<rdf:RDF xmlns="http://example.com/ontology/enterprise-sales-bookings#"
     xml:base="http://example.com/ontology/enterprise-sales-bookings"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:ex="http://example.com/ontology/enterprise-sales-bookings#">

    <owl:Ontology rdf:about="http://example.com/ontology/enterprise-sales-bookings">
        <rdfs:label>Enterprise Sales Bookings Ontology</rdfs:label>
        <rdfs:comment>OWL 2 ontology generated from the OSI Semantic Model for the Sales Bookings and Revenue Analytics domain. The business process document could not be decoded from the source repository, so ontology enrichment from that document was not applied. Validation warnings identified: business process document unreadable; no duplicate entities detected; no missing core entities in the supplied semantic model; relationships are limited to dimension-to-booking foreign key links; no invalid semantic references detected in the supplied semantic model.</rdfs:comment>
        <owl:versionInfo>1.0.0</owl:versionInfo>
    </owl:Ontology>

    <!-- Classes -->
    <owl:Class rdf:about="http://example.com/ontology/enterprise-sales-bookings#BusinessEntity">
        <rdfs:label>Business Entity</rdfs:label>
        <rdfs:comment>Represents a core business entity in the enterprise sales bookings semantic model.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://example.com/ontology/enterprise-sales-bookings#Contract">
        <rdfs:subClassOf rdf:resource="http://example.com/ontology/enterprise-sales-bookings#BusinessEntity"/>
        <rdfs:label>Contract</rdfs:label>
        <rdfs:comment>Stores the business attributes of commercial agreements associated with bookings, including contract type, term, renewal behavior, and support coverage level.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://example.com/ontology/enterprise-sales-bookings#Customer">
        <rdfs:subClassOf rdf:resource="http://example.com/ontology/enterprise-sales-bookings#BusinessEntity"/>
        <rdfs:label>Customer</rdfs:label>
        <rdfs:comment>Stores descriptive information about customers that place orders and generate bookings, including segment, industry, account tier, and headquarters location.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://example.com/ontology/enterprise-sales-bookings#Date">
        <rdfs:subClassOf rdf:resource="http://example.com/ontology/enterprise-sales-bookings#BusinessEntity"/>
        <rdfs:label>Date</rdfs:label>
        <rdfs:comment>Stores calendar and fiscal date attributes used to analyze bookings over time.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://example.com/ontology/enterprise-sales-bookings#Geography">
        <rdfs:subClassOf rdf:resource="http://example.com/ontology/enterprise-sales-bookings#BusinessEntity"/>
        <rdfs:label>Geography</rdfs:label>
        <rdfs:comment>Stores geographic attributes used to analyze bookings by sales region, theater, and country.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://example.com/ontology/enterprise-sales-bookings#Partner">
        <rdfs:subClassOf rdf:resource="http://example.com/ontology/enterprise-sales-bookings#BusinessEntity"/>
        <rdfs:label>Partner</rdfs:label>
        <rdfs:comment>Stores information about channel and direct partners involved in the sales process, including partner type, partner tier, and route to market.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://example.com/ontology/enterprise-sales-bookings#Product">
        <rdfs:subClassOf rdf:resource="http://example.com/ontology/enterprise-sales-bookings#BusinessEntity"/>
        <rdfs:label>Product</rdfs:label>
        <rdfs:comment>Stores descriptive information about products and offers sold to customers, including product family, technology domain, offer type, and business entity.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://example.com/ontology/enterprise-sales-bookings#SalesRepresentative">
        <rdfs:subClassOf rdf:resource="http://example.com/ontology/enterprise-sales-bookings#BusinessEntity"/>
        <rdfs:label>Sales Representative</rdfs:label>
        <rdfs:comment>Stores information about sales personnel responsible for managing customer relationships and booking transactions.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://example.com/ontology/enterprise-sales-bookings#BookingTransaction">
        <rdfs:subClassOf rdf:resource="http://example.com/ontology/enterprise-sales-bookings#BusinessEntity"/>
        <rdfs:label>Booking Transaction</rdfs:label>
        <rdfs:comment>Stores individual completed sales booking transactions with related financial measures and links to customer, product, partner, geography, sales representative, contract, and date dimensions.</rdfs:comment>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.com/ontology/enterprise-sales-bookings#BusinessEntity"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://example.com/ontology/enterprise-sales-bookings#hasCustomer"/>
                        <owl:someValuesFrom rdf:resource="http://example.com/ontology/enterprise-sales-bookings#Customer"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://example.com/ontology/enterprise-sales-bookings#hasProduct"/>
                        <owl:someValuesFrom rdf:resource="http://example.com/ontology/enterprise-sales-bookings#Product"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <owl:AllDisjointClasses>
        <owl:members rdf:parseType="Collection">
            <rdf:Description rdf:about="http://example.com/ontology/enterprise-sales-bookings#Contract"/>
            <rdf:Description rdf:about="http://example.com/ontology/enterprise-sales-bookings#Customer"/>
            <rdf:Description rdf:about="http://example.com/ontology/enterprise-sales-bookings#Date"/>
            <rdf:Description rdf:about="http://example.com/ontology/enterprise-sales-bookings#Geography"/>
            <rdf:Description rdf:about="http://example.com/ontology/enterprise-sales-bookings#Partner"/>
            <rdf:Description rdf:about="http://example.com/ontology/enterprise-sales-bookings#Product"/>
            <rdf:Description rdf:about="http://example.com/ontology/enterprise-sales-bookings#SalesRepresentative"/>
            <rdf:Description rdf:about="http://example.com/ontology/enterprise-sales-bookings#BookingTransaction"/>
        </owl:members>
    </owl:AllDisjointClasses>

    <owl:Class rdf:about="http://example.com/ontology/enterprise-sales-bookings#Attribute">
        <rdfs:label>Attribute</rdfs:label>
        <rdfs:comment>Metadata class representing a business attribute, identifier, date field, status field, or measure field from the semantic model.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://example.com/ontology/enterprise-sales-bookings#Measure">
        <rdfs:subClassOf rdf:resource="http://example.com/ontology/enterprise-sales-bookings#Attribute"/>
        <rdfs:label>Measure</rdfs:label>
        <rdfs:comment>Metadata class representing a quantitative business measure.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://example.com/ontology/enterprise-sales-bookings#BusinessRule">
        <rdfs:label>Business Rule</rdfs:label>
        <rdfs:comment>Metadata class representing business rules derived from the semantic model or available documentation.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://example.com/ontology/enterprise-sales-bookings#GlossaryTerm">
        <rdfs:label>Glossary Term</rdfs:label>
        <rdfs:comment>Metadata class representing a business glossary term preserved from the semantic model.</rdfs:comment>
    </owl:Class>

    <!-- Annotation properties -->
    <owl:AnnotationProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#sourceTable"/>
    <owl:AnnotationProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#sourceColumn"/>
    <owl:AnnotationProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#businessDefinition"/>
    <owl:AnnotationProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#semanticDefinition"/>
    <owl:AnnotationProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#sourceEntity"/>
    <owl:AnnotationProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#dataType"/>
    <owl:AnnotationProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#aggregationType"/>
    <owl:AnnotationProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#validationWarning"/>

    <!-- Object properties -->
    <owl:ObjectProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#hasContract">
        <rdfs:label>has contract</rdfs:label>
        <rdfs:comment>Links a booking transaction to the contract associated with the booking.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/enterprise-sales-bookings#BookingTransaction"/>
        <rdfs:range rdf:resource="http://example.com/ontology/enterprise-sales-bookings#Contract"/>
        <owl:inverseOf rdf:resource="http://example.com/ontology/enterprise-sales-bookings#isContractForBookingTransaction"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#isContractForBookingTransaction">
        <rdfs:label>is contract for booking transaction</rdfs:label>
        <rdfs:comment>Inverse relationship linking a contract to booking transactions governed by that contract.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/enterprise-sales-bookings#Contract"/>
        <rdfs:range rdf:resource="http://example.com/ontology/enterprise-sales-bookings#BookingTransaction"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#hasCustomer">
        <rdfs:label>has customer</rdfs:label>
        <rdfs:comment>Links a booking transaction to the customer that generated the booking.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/enterprise-sales-bookings#BookingTransaction"/>
        <rdfs:range rdf:resource="http://example.com/ontology/enterprise-sales-bookings#Customer"/>
        <owl:inverseOf rdf:resource="http://example.com/ontology/enterprise-sales-bookings#isCustomerForBookingTransaction"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#isCustomerForBookingTransaction">
        <rdfs:label>is customer for booking transaction</rdfs:label>
        <rdfs:comment>Inverse relationship linking a customer to booking transactions generated by that customer.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/enterprise-sales-bookings#Customer"/>
        <rdfs:range rdf:resource="http://example.com/ontology/enterprise-sales-bookings#BookingTransaction"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#hasBookingDate">
        <rdfs:label>has booking date</rdfs:label>
        <rdfs:comment>Links a booking transaction to the reporting date dimension.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/enterprise-sales-bookings#BookingTransaction"/>
        <rdfs:range rdf:resource="http://example.com/ontology/enterprise-sales-bookings#Date"/>
        <owl:inverseOf rdf:resource="http://example.com/ontology/enterprise-sales-bookings#isDateForBookingTransaction"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#isDateForBookingTransaction">
        <rdfs:label>is date for booking transaction</rdfs:label>
        <rdfs:comment>Inverse relationship linking a date to booking transactions posted on that date.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/enterprise-sales-bookings#Date"/>
        <rdfs:range rdf:resource="http://example.com/ontology/enterprise-sales-bookings#BookingTransaction"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#hasGeography">
        <rdfs:label>has geography</rdfs:label>
        <rdfs:comment>Links a booking transaction to the geography associated with the booking.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/enterprise-sales-bookings#BookingTransaction"/>
        <rdfs:range rdf:resource="http://example.com/ontology/enterprise-sales-bookings#Geography"/>
        <owl:inverseOf rdf:resource="http://example.com/ontology/enterprise-sales-bookings#isGeographyForBookingTransaction"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#isGeographyForBookingTransaction">
        <rdfs:label>is geography for booking transaction</rdfs:label>
        <rdfs:comment>Inverse relationship linking a geography to booking transactions associated with that geography.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/enterprise-sales-bookings#Geography"/>
        <rdfs:range rdf:resource="http://example.com/ontology/enterprise-sales-bookings#BookingTransaction"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#hasPartner">
        <rdfs:label>has partner</rdfs:label>
        <rdfs:comment>Links a booking transaction to the partner involved in the transaction.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/enterprise-sales-bookings#BookingTransaction"/>
        <rdfs:range rdf:resource="http://example.com/ontology/enterprise-sales-bookings#Partner"/>
        <owl:inverseOf rdf:resource="http://example.com/ontology/enterprise-sales-bookings#isPartnerForBookingTransaction"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#isPartnerForBookingTransaction">
        <rdfs:label>is partner for booking transaction</rdfs:label>
        <rdfs:comment>Inverse relationship linking a partner to booking transactions involving that partner.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/enterprise-sales-bookings#Partner"/>
        <rdfs:range rdf:resource="http://example.com/ontology/enterprise-sales-bookings#BookingTransaction"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#hasProduct">
        <rdfs:label>has product</rdfs:label>
        <rdfs:comment>Links a booking transaction to the product sold in the transaction.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/enterprise-sales-bookings#BookingTransaction"/>
        <rdfs:range rdf:resource="http://example.com/ontology/enterprise-sales-bookings#Product"/>
        <owl:inverseOf rdf:resource="http://example.com/ontology/enterprise-sales-bookings#isProductForBookingTransaction"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#isProductForBookingTransaction">
        <rdfs:label>is product for booking transaction</rdfs:label>
        <rdfs:comment>Inverse relationship linking a product to booking transactions containing that product.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/enterprise-sales-bookings#Product"/>
        <rdfs:range rdf:resource="http://example.com/ontology/enterprise-sales-bookings#BookingTransaction"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#hasSalesRepresentative">
        <rdfs:label>has sales representative</rdfs:label>
        <rdfs:comment>Links a booking transaction to the sales representative associated with the booking.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/enterprise-sales-bookings#BookingTransaction"/>
        <rdfs:range rdf:resource="http://example.com/ontology/enterprise-sales-bookings#SalesRepresentative"/>
        <owl:inverseOf rdf:resource="http://example.com/ontology/enterprise-sales-bookings#isSalesRepresentativeForBookingTransaction"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#isSalesRepresentativeForBookingTransaction">
        <rdfs:label>is sales representative for booking transaction</rdfs:label>
        <rdfs:comment>Inverse relationship linking a sales representative to booking transactions associated with that representative.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/enterprise-sales-bookings#SalesRepresentative"/>
        <rdfs:range rdf:resource="http://example.com/ontology/enterprise-sales-bookings#BookingTransaction"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#hasAttribute">
        <rdfs:label>has attribute</rdfs:label>
        <rdfs:comment>Links a business entity to metadata individuals representing its attributes.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/enterprise-sales-bookings#BusinessEntity"/>
        <rdfs:range rdf:resource="http://example.com/ontology/enterprise-sales-bookings#Attribute"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#hasMeasure">
        <rdfs:label>has measure</rdfs:label>
        <rdfs:comment>Links a business entity to metadata individuals representing its measures.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/enterprise-sales-bookings#BusinessEntity"/>
        <rdfs:range rdf:resource="http://example.com/ontology/enterprise-sales-bookings#Measure"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#hasBusinessRule">
        <rdfs:label>has business rule</rdfs:label>
        <rdfs:comment>Links a business entity to metadata individuals representing applicable business rules.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/enterprise-sales-bookings#BusinessEntity"/>
        <rdfs:range rdf:resource="http://example.com/ontology/enterprise-sales-bookings#BusinessRule"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#hasGlossaryTerm">
        <rdfs:label>has glossary term</rdfs:label>
        <rdfs:comment>Links a business entity to metadata individuals representing glossary terms.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/enterprise-sales-bookings#BusinessEntity"/>
        <rdfs:range rdf:resource="http://example.com/ontology/enterprise-sales-bookings#GlossaryTerm"/>
    </owl:ObjectProperty>

    <!-- Datatype properties -->
    <owl:DatatypeProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#contractKey">
        <rdfs:label>Contract Key</rdfs:label>
        <rdfs:comment>Surrogate key that uniquely identifies a contract record in the contract dimension.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/enterprise-sales-bookings#Contract"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <ex:sourceTable>QuoteToBooking.dim_contract</ex:sourceTable>
        <ex:sourceColumn>contract_key</ex:sourceColumn>
        <ex:businessDefinition>Surrogate key that uniquely identifies a contract record in the contract dimension.</ex:businessDefinition>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#contractType">
        <rdfs:label>Contract Type</rdfs:label>
        <rdfs:comment>Describes the type of commercial agreement attached to the booking, such as SaaS subscription, Enterprise Agreement, or support contract.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/enterprise-sales-bookings#Contract"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <ex:sourceTable>QuoteToBooking.dim_contract</ex:sourceTable>
        <ex:sourceColumn>contract_type</ex:sourceColumn>
        <ex:businessDefinition>Describes the type of commercial agreement attached to the booking, such as SaaS subscription, Enterprise Agreement, or support contract.</ex:businessDefinition>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#termMonths">
        <rdfs:label>Contract Term Months</rdfs:label>
        <rdfs:comment>Indicates the duration of the contract in months.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/enterprise-sales-bookings#Contract"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <ex:sourceTable>QuoteToBooking.dim_contract</ex:sourceTable>
        <ex:sourceColumn>term_months</ex:sourceColumn>
        <ex:businessDefinition>Indicates the duration of the contract in months.</ex:businessDefinition>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#autoRenewFlag">
        <rdfs:label>Auto Renew Flag</rdfs:label>
        <rdfs:comment>Indicates whether the contract is set to renew automatically at the end of its term.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/enterprise-sales-bookings#Contract"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <ex:sourceTable>QuoteToBooking.dim_contract</ex:sourceTable>
        <ex:sourceColumn>auto_renew_flag</ex:sourceColumn>
        <ex:businessDefinition>Indicates whether the contract is set to renew automatically at the end of its term.</ex:businessDefinition>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#coverageLevel">
        <rdfs:label>Coverage Level</rdfs:label>
        <rdfs:comment>Describes the level of service or support coverage provided under the contract.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/enterprise-sales-bookings#Contract"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <ex:sourceTable>QuoteToBooking.dim_contract</ex:sourceTable>
        <ex:sourceColumn>coverage_level</ex:sourceColumn>
        <ex:businessDefinition>Describes the level of service or support coverage provided under the contract.</ex:businessDefinition>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#customerKey">
        <rdfs:label>Customer Key</rdfs:label>
        <rdfs:comment>Surrogate key that uniquely identifies a customer record in the customer dimension.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/enterprise-sales-bookings#Customer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <ex:sourceTable>QuoteToBooking.dim_customer</ex:sourceTable>
        <ex:sourceColumn>customer_key</ex:sourceColumn>
        <ex:businessDefinition>Surrogate key that uniquely identifies a customer record in the customer dimension.</ex:businessDefinition>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#customerId">
        <rdfs:label>Customer ID</rdfs:label>
        <rdfs:comment>Business identifier assigned to the customer account.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/enterprise-sales-bookings#Customer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <ex:sourceTable>QuoteToBooking.dim_customer</ex:sourceTable>
        <ex:sourceColumn>customer_id</ex:sourceColumn>
        <ex:businessDefinition>Business identifier assigned to the customer account.</ex:businessDefinition>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#customerName">
        <rdfs:label>Customer Name</rdfs:label>
        <rdfs:comment>Official name of the customer organization that purchased products or services.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/enterprise-sales-bookings#Customer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <ex:sourceTable>QuoteToBooking.dim_customer</ex:sourceTable>
        <ex:sourceColumn>customer_name</ex:sourceColumn>
        <ex:businessDefinition>Official name of the customer organization that purchased products or services.</ex:businessDefinition>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#segment">
        <rdfs:label>Customer Segment</rdfs:label>
        <rdfs:comment>Classifies the customer into a business segment such as Enterprise, Service Provider, or Public Sector.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/enterprise-sales-bookings#Customer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <ex:sourceTable>QuoteToBooking.dim_customer</ex:sourceTable>
        <ex:sourceColumn>segment</ex:sourceColumn>
        <ex:businessDefinition>Classifies the customer into a business segment such as Enterprise, Service Provider, or Public Sector.</ex:businessDefinition>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#industry">
        <rdfs:label>Industry</rdfs:label>
        <rdfs:comment>Identifies the industry in which the customer operates.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/enterprise-sales-bookings#Customer"/>
