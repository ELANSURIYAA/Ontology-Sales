    <owl:DatatypeProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#dateKey"><rdfs:label>Date Key</rdfs:label><rdfs:comment>Encoded key that uniquely identifies a reporting date in the date dimension.</rdfs:comment><rdfs:domain rdf:resource="http://example.com/ontology/enterprise-sales-bookings#Date"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/><sourceTable>QuoteToBooking.dim_date</sourceTable><sourceColumn>date_key</sourceColumn><businessDefinition>Encoded key that uniquely identifies a reporting date in the date dimension.</businessDefinition></owl:DatatypeProperty>
