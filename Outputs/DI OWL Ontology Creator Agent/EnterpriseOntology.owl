    <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales-bookings#partnerName"><rdfs:label>partner name</rdfs:label><rdfs:comment>Name of the partner organization involved in the transaction.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings#Partner"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ex:sourceTable>QuoteToBooking.dim_partner</ex:sourceTable><ex:sourceColumn>partner_name</ex:sourceColumn></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales-bookings#partnerType"><rdfs:label>partner type</rdfs:label><rdfs:comment>Classifies the partner by operating model, such as distributor, reseller, systems integrator, or direct.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings#Partner"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ex:sourceTable>QuoteToBooking.dim_partner</ex:sourceTable><ex:sourceColumn>partner_type</ex:sourceColumn></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales-bookings#partnerTier"><rdfs:label>partner tier</rdfs:label><rdfs:comment>Indicates the certification, authorization, or strategic tier assigned to the partner.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings#Partner"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ex:sourceTable>QuoteToBooking.dim_partner</ex:sourceTable><ex:sourceColumn>partner_tier</ex:sourceColumn></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales-bookings#routeToMarket"><rdfs:label>route to market</rdfs:label><rdfs:comment>Describes the sales delivery path through which the product or service reached the customer.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings#Partner"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ex:sourceTable>QuoteToBooking.dim_partner</ex:sourceTable><ex:sourceColumn>route_to_market</ex:sourceColumn></owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales-bookings#productKey"><rdfs:label>product key</rdfs:label><rdfs:comment>Surrogate key that uniquely identifies a product record in the product dimension.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings#Product"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/><ex:sourceTable>QuoteToBooking.dim_product</ex:sourceTable><ex:sourceColumn>product_key</ex:sourceColumn></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales-bookings#productId"><rdfs:label>product id</rdfs:label><rdfs:comment>Business identifier or SKU assigned to the product or offer.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings#Product"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ex:sourceTable>QuoteToBooking.dim_product</ex:sourceTable><ex:sourceColumn>product_id</ex:sourceColumn></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales-bookings#productName"><rdfs:label>product name</rdfs:label><rdfs:comment>Commercial name of the product or subscription offer sold to the customer.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings#Product"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ex:sourceTable>QuoteToBooking.dim_product</ex:sourceTable><ex:sourceColumn>product_name</ex:sourceColumn></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales-bookings#productFamily"><rdfs:label>product family</rdfs:label><rdfs:comment>Higher-level product grouping used for portfolio and performance analysis.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings#Product"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ex:sourceTable>QuoteToBooking.dim_product</ex:sourceTable><ex:sourceColumn>product_family</ex:sourceColumn></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales-bookings#technologyDomain"><rdfs:label>technology domain</rdfs:label><rdfs:comment>Technology area or solution domain to which the product belongs.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings#Product"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ex:sourceTable>QuoteToBooking.dim_product</ex:sourceTable><ex:sourceColumn>technology_domain</ex:sourceColumn></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales-bookings#offerType"><rdfs:label>offer type</rdfs:label><rdfs:comment>Indicates whether the item is sold as hardware, software subscription, or SaaS subscription.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings#Product"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ex:sourceTable>QuoteToBooking.dim_product</ex:sourceTable><ex:sourceColumn>offer_type</ex:sourceColumn></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales-bookings#businessEntity"><rdfs:label>business entity</rdfs:label><rdfs:comment>Internal business unit or portfolio responsible for the product.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings#Product"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ex:sourceTable>QuoteToBooking.dim_product</ex:sourceTable><ex:sourceColumn>business_entity</ex:sourceColumn></owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales-bookings#salesRepresentativeKey"><rdfs:label>sales representative key</rdfs:label><rdfs:comment>Surrogate key that uniquely identifies a sales representative record in the sales representative dimension.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings#SalesRepresentative"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/><ex:sourceTable>QuoteToBooking.dim_sales_rep</ex:sourceTable><ex:sourceColumn>sales_rep_key</ex:sourceColumn></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales-bookings#salesRepresentativeId"><rdfs:label>sales representative id</rdfs:label><rdfs:comment>Business identifier assigned to the sales representative.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings#SalesRepresentative"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ex:sourceTable>QuoteToBooking.dim_sales_rep</ex:sourceTable><ex:sourceColumn>rep_id</ex:sourceColumn></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales-bookings#salesRepresentativeName"><rdfs:label>sales representative name</rdfs:label><rdfs:comment>Full name of the sales representative associated with the booking.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings#SalesRepresentative"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ex:sourceTable>QuoteToBooking.dim_sales_rep</ex:sourceTable><ex:sourceColumn>rep_name</ex:sourceColumn></owl:DatatypeProperty>
