  </owl:Class>

  <owl:Class rdf:about="http://example.org/ontology/sales#Product">
    <rdfs:label>Product</rdfs:label>
    <rdfs:comment>Stores product master data used to analyze bookings by product, family, technology domain, offer type, and business entity.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/ontology/sales#Dimension"/>
    <sales:businessDefinition>Stores product master data used to analyze bookings by product, family, technology domain, offer type, and business entity.</sales:businessDefinition>
    <sales:businessDomain>Products</sales:businessDomain>
    <sales:sourceEntity>Product Dimension</sales:sourceEntity>
    <sales:sourceTable>quotetobooking.dim_product</sales:sourceTable>
