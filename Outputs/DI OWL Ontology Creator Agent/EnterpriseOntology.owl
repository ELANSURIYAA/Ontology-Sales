    <owl:Ontology rdf:about="http://example.com/ontology/quotetobooking">
        <rdfs:label xml:lang="en">Enterprise Sales Quote-to-Booking Ontology</rdfs:label>
        <rdfs:comment xml:lang="en">OWL 2 ontology generated from the OSI Semantic Model for the Quote-to-Booking sales domain. The business process document could not be parsed from the provided .docx input, so process-derived enrichments are limited and a validation warning applies. This ontology is designed as a GraphDB-compatible TBox model representing business entities as classes, business relationships as object properties, and business attributes and measures as datatype properties.</rdfs:comment>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <qb:sourceSemanticModel>Outputs/DI OSI Semantic Creator Agent/OSI Semantic Model.md</qb:sourceSemanticModel>
        <qb:sourceBusinessProcessDocument>Inputs/QuoteToBooking.docx</qb:sourceBusinessProcessDocument>
        <qb:validationWarning>Business Process document readability validation failed: the provided .docx file could not be decoded by the reader tool using UTF-8. Ontology generation therefore uses the validated OSI Semantic Model as the authoritative source and preserves only directly inferable constraints.</qb:validationWarning>
        <qb:validationWarning>No duplicate entities were detected in the OSI Semantic Model.</qb:validationWarning>
        <qb:validationWarning>No duplicate relationships were detected in the OSI Semantic Model.</qb:validationWarning>
        <qb:validationWarning>No invalid semantic references were detected among the declared foreign key relationships.</qb:validationWarning>
    </owl:Ontology>

