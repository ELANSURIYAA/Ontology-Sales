<?xml version="1.0"?>
<rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
    xmlns:skos="http://www.w3.org/2004/02/skos/core#"
    xmlns:ex="http://example.com/ontology/sales#"
    xml:base="http://example.com/ontology/sales">

  <owl:Ontology rdf:about="http://example.com/ontology/sales">
    <rdfs:label xml:lang="en">Enterprise Sales Bookings Ontology</rdfs:label>
    <rdfs:comment xml:lang="en">OWL 2 ontology generated from the OSI Semantic Model for sales bookings and revenue analytics. The business process document could not be read from the repository input, so process-specific enrichments and additional business rule translations were limited to the semantic model content only. This ontology is designed as a TBox-only ontology compatible with GraphDB and Protégé.</rdfs:comment>
    <owl:versionInfo>0.1.0</owl:versionInfo>
    <skos:note>Source Semantic Model: Outputs/DI OSI Semantic Creator YAML Agent/OSI Semantic Model.yaml</skos:note>
    <skos:note>Business Process Document: Inputs/QuoteToBooking.docx</skos:note>
    <skos:note>Validation Warning: Business Process document was not readable due to UTF-8 decoding error; ontology generated using OSI Semantic Model only.</skos:note>
    <skos:note>Business Domain: Sales Bookings and Revenue Analytics</skos:note>
  </owl:Ontology>

