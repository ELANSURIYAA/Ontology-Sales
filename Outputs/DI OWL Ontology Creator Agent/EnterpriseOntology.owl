  <owl:AnnotationProperty rdf:about="http://example.org/ontology/sales#sourceAttribute"/>
  <owl:AnnotationProperty rdf:about="http://example.org/ontology/sales#sourceTable"/>
  <owl:AnnotationProperty rdf:about="http://example.org/ontology/sales#sourceColumn"/>
  <owl:AnnotationProperty rdf:about="http://example.org/ontology/sales#sourceRelationship"/>
  <owl:AnnotationProperty rdf:about="http://example.org/ontology/sales#metricDefinition"/>
  <owl:AnnotationProperty rdf:about="http://example.org/ontology/sales#semanticSource"/>
  <owl:AnnotationProperty rdf:about="http://example.org/ontology/sales#validationWarning"/>

  <owl:Class rdf:about="http://example.org/ontology/sales#DomainConcept">
    <rdfs:label>Domain Concept</rdfs:label>
    <rdfs:comment>Top-level business concept in the enterprise sales ontology.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/ontology/sales#BusinessEntity">
    <rdfs:label>Business Entity</rdfs:label>
    <rdfs:comment>Top-level class for business entities represented in the ontology.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/ontology/sales#DomainConcept"/>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/ontology/sales#Dimension">
    <rdfs:label>Dimension</rdfs:label>
    <rdfs:comment>Analytical dimension entity used to classify or describe booking transactions.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/ontology/sales#BusinessEntity"/>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/ontology/sales#Fact">
    <rdfs:label>Fact</rdfs:label>
    <rdfs:comment>Transactional fact entity used to store measurable business events.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/ontology/sales#BusinessEntity"/>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/ontology/sales#Transaction">
    <rdfs:label>Transaction</rdfs:label>
    <rdfs:comment>Business transaction entity.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/ontology/sales#BusinessEntity"/>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/ontology/sales#Contract">
    <rdfs:label>Contract</rdfs:label>
    <rdfs:comment>Stores descriptive contract attributes used to classify bookings by contract structure, duration, renewal behavior, and coverage level.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/ontology/sales#Dimension"/>
    <businessDefinition xmlns="http://example.org/ontology/sales#">Stores descriptive contract attributes used to classify bookings by contract structure, duration, renewal behavior, and coverage level.</businessDefinition>
    <businessDomain xmlns="http://example.org/ontology/sales#">Contracts</businessDomain>
    <sourceEntity xmlns="http://example.org/ontology/sales#">Contract Dimension</sourceEntity>
    <sourceTable xmlns="http://example.org/ontology/sales#">quotetobooking.dim_contract</sourceTable>
    <sourceGlossary xmlns="http://example.org/ontology/sales#">Outputs/DI Glossary Creator Agent/business_glossary_data_dictionary.md</sourceGlossary>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/ontology/sales#Customer">
    <rdfs:label>Customer</rdfs:label>
    <rdfs:comment>Stores customer master data used to analyze bookings by customer identity, segment, industry, tier, and headquarters location.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/ontology/sales#Dimension"/>
    <businessDefinition xmlns="http://example.org/ontology/sales#">Stores customer master data used to analyze bookings by customer identity, segment, industry, tier, and headquarters location.</businessDefinition>
    <businessDomain xmlns="http://example.org/ontology/sales#">Customers</businessDomain>
    <sourceEntity xmlns="http://example.org/ontology/sales#">Customer Dimension</sourceEntity>
    <sourceTable xmlns="http://example.org/ontology/sales#">quotetobooking.dim_customer</sourceTable>
    <sourceGlossary xmlns="http://example.org/ontology/sales#">Outputs/DI Glossary Creator Agent/business_glossary_data_dictionary.md</sourceGlossary>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/ontology/sales#DateDimension">
    <rdfs:label>Date</rdfs:label>
    <rdfs:comment>Stores calendar and fiscal date attributes used to analyze bookings over time by date, month, quarter, and year.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/ontology/sales#Dimension"/>
    <businessDefinition xmlns="http://example.org/ontology/sales#">Stores calendar and fiscal date attributes used to analyze bookings over time by date, month, quarter, and year.</businessDefinition>
    <businessDomain xmlns="http://example.org/ontology/sales#">Time</businessDomain>
    <sourceEntity xmlns="http://example.org/ontology/sales#">Date Dimension</sourceEntity>
    <sourceTable xmlns="http://example.org/ontology/sales#">quotetobooking.dim_date</sourceTable>
    <sourceGlossary xmlns="http://example.org/ontology/sales#">Outputs/DI Glossary Creator Agent/business_glossary_data_dictionary.md</sourceGlossary>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/ontology/sales#Geography">
    <rdfs:label>Geography</rdfs:label>
    <rdfs:comment>Stores geographic classifications used to analyze bookings by region, theater, and country.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/ontology/sales#Dimension"/>
    <businessDefinition xmlns="http://example.org/ontology/sales#">Stores geographic classifications used to analyze bookings by region, theater, and country.</businessDefinition>
    <businessDomain xmlns="http://example.org/ontology/sales#">Geography</businessDomain>
    <sourceEntity xmlns="http://example.org/ontology/sales#">Geography Dimension</sourceEntity>
    <sourceTable xmlns="http://example.org/ontology/sales#">quotetobooking.dim_geography</sourceTable>
    <sourceGlossary xmlns="http://example.org/ontology/sales#">Outputs/DI Glossary Creator Agent/business_glossary_data_dictionary.md</sourceGlossary>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/ontology/sales#Partner">
    <rdfs:label>Partner</rdfs:label>
    <rdfs:comment>Stores channel partner attributes used to analyze bookings by partner identity, partner type, tier, and route to market.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/ontology/sales#Dimension"/>
    <businessDefinition xmlns="http://example.org/ontology/sales#">Stores channel partner attributes used to analyze bookings by partner identity, partner type, tier, and route to market.</businessDefinition>
    <businessDomain xmlns="http://example.org/ontology/sales#">Partners</businessDomain>
    <sourceEntity xmlns="http://example.org/ontology/sales#">Partner Dimension</sourceEntity>
    <sourceTable xmlns="http://example.org/ontology/sales#">quotetobooking.dim_partner</sourceTable>
    <sourceGlossary xmlns="http://example.org/ontology/sales#">Outputs/DI Glossary Creator Agent/business_glossary_data_dictionary.md</sourceGlossary>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/ontology/sales#Product">
    <rdfs:label>Product</rdfs:label>
    <rdfs:comment>Stores product master data used to analyze bookings by product, family, technology domain, offer type, and business entity.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/ontology/sales#Dimension"/>
    <businessDefinition xmlns="http://example.org/ontology/sales#">Stores product master data used to analyze bookings by product, family, technology domain, offer type, and business entity.</businessDefinition>
    <businessDomain xmlns="http://example.org/ontology/sales#">Products</businessDomain>
    <sourceEntity xmlns="http://example.org/ontology/sales#">Product Dimension</sourceEntity>
    <sourceTable xmlns="http://example.org/ontology/sales#">quotetobooking.dim_product</sourceTable>
    <sourceGlossary xmlns="http://example.org/ontology/sales#">Outputs/DI Glossary Creator Agent/business_glossary_data_dictionary.md</sourceGlossary>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/ontology/sales#SalesRepresentative">
    <rdfs:label>Sales Representative</rdfs:label>
    <rdfs:comment>Stores sales representative attributes used to analyze bookings by seller identity, role, team, and covered segment.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/ontology/sales#Dimension"/>
    <businessDefinition xmlns="http://example.org/ontology/sales#">Stores sales representative attributes used to analyze bookings by seller identity, role, team, and covered segment.</businessDefinition>
    <businessDomain xmlns="http://example.org/ontology/sales#">Sales</businessDomain>
    <sourceEntity xmlns="http://example.org/ontology/sales#">Sales Representative Dimension</sourceEntity>
    <sourceTable xmlns="http://example.org/ontology/sales#">quotetobooking.dim_sales_rep</sourceTable>
    <sourceGlossary xmlns="http://example.org/ontology/sales#">Outputs/DI Glossary Creator Agent/business_glossary_data_dictionary.md</sourceGlossary>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/ontology/sales#Booking">
    <rdfs:label>Booking</rdfs:label>
    <rdfs:comment>Stores transactional booking records for customer orders, including associated dimensions, quantities, pricing, discounts, and contract value metrics.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/ontology/sales#Fact"/>
    <rdfs:subClassOf rdf:resource="http://example.org/ontology/sales#Transaction"/>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://example.org/ontology/sales#hasCustomer"/>
        <owl:someValuesFrom rdf:resource="http://example.org/ontology/sales#Customer"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://example.org/ontology/sales#hasProduct"/>
        <owl:someValuesFrom rdf:resource="http://example.org/ontology/sales#Product"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://example.org/ontology/sales#hasBookingDate"/>
        <owl:someValuesFrom rdf:resource="http://example.org/ontology/sales#DateDimension"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://example.org/ontology/sales#hasCustomer"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onClass rdf:resource="http://example.org/ontology/sales#Customer"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://example.org/ontology/sales#hasProduct"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onClass rdf:resource="http://example.org/ontology/sales#Product"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://example.org/ontology/sales#hasBookingDate"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onClass rdf:resource="http://example.org/ontology/sales#DateDimension"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <businessDefinition xmlns="http://example.org/ontology/sales#">Stores transactional booking records for customer orders, including associated dimensions, quantities, pricing, discounts, and contract value metrics.</businessDefinition>
    <businessDomain xmlns="http://example.org/ontology/sales#">Sales Transactions</businessDomain>
    <sourceEntity xmlns="http://example.org/ontology/sales#">Bookings Fact</sourceEntity>
    <sourceTable xmlns="http://example.org/ontology/sales#">quotetobooking.fact_bookings</sourceTable>
    <sourceGlossary xmlns="http://example.org/ontology/sales#">Outputs/DI Glossary Creator Agent/business_glossary_data_dictionary.md</sourceGlossary>
    <metricDefinition xmlns="http://example.org/ontology/sales#">Associated measures include quantity, unit list price in USD, discount percentage, booking amount in USD, annual contract value in USD, and total contract value in USD.</metricDefinition>
    <validationWarning xmlns="http://example.org/ontology/sales#">Relationship semantics and advanced process-derived constraints could not be fully validated because the process document was unavailable.</validationWarning>
  </owl:Class>

  <owl:AllDisjointClasses>
    <owl:members rdf:parseType="Collection">
      <rdf:Description rdf:about="http://example.org/ontology/sales#Contract"/>
      <rdf:Description rdf:about="http://example.org/ontology/sales#Customer"/>
      <rdf:Description rdf:about="http://example.org/ontology/sales#DateDimension"/>
      <rdf:Description rdf:about="http://example.org/ontology/sales#Geography"/>
      <rdf:Description rdf:about="http://example.org/ontology/sales#Partner"/>
      <rdf:Description rdf:about="http://example.org/ontology/sales#Product"/>
      <rdf:Description rdf:about="http://example.org/ontology/sales#SalesRepresentative"/>
      <rdf:Description rdf:about="http://example.org/ontology/sales#Booking"/>
    </owl:members>
  </owl:AllDisjointClasses>

  <owl:ObjectProperty rdf:about="http://example.org/ontology/sales#hasBookingDate">
    <rdfs:label>has booking date</rdfs:label>
    <rdfs:comment>Links a booking transaction to its booking date dimension record.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology/sales#Booking"/>
    <rdfs:range rdf:resource="http://example.org/ontology/sales#DateDimension"/>
    <owl:inverseOf rdf:resource="http://example.org/ontology/sales#isBookingDateOf"/>
    <sourceRelationship xmlns="http://example.org/ontology/sales#">fact_bookings.date_key -&gt; dim_date.date_key</sourceRelationship>
    <sourceGlossary xmlns="http://example.org/ontology/sales#">Outputs/DI Glossary Creator Agent/business_glossary_data_dictionary.md</sourceGlossary>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.org/ontology/sales#isBookingDateOf">
    <rdfs:label>is booking date of</rdfs:label>
    <rdfs:comment>Inverse of has booking date.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology/sales#DateDimension"/>
    <rdfs:range rdf:resource="http://example.org/ontology/sales#Booking"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.org/ontology/sales#hasCustomer">
    <rdfs:label>has customer</rdfs:label>
    <rdfs:comment>Links a booking transaction to the customer associated with the booking.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology/sales#Booking"/>
    <rdfs:range rdf:resource="http://example.org/ontology/sales#Customer"/>
    <owl:inverseOf rdf:resource="http://example.org/ontology/sales#isCustomerForBooking"/>
    <sourceRelationship xmlns="http://example.org/ontology/sales#">fact_bookings.customer_key -&gt; dim_customer.customer_key</sourceRelationship>
    <sourceGlossary xmlns="http://example.org/ontology/sales#">Outputs/DI Glossary Creator Agent/business_glossary_data_dictionary.md</sourceGlossary>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.org/ontology/sales#isCustomerForBooking">
    <rdfs:label>is customer for booking</rdfs:label>
    <rdfs:comment>Inverse of has customer.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology/sales#Customer"/>
    <rdfs:range rdf:resource="http://example.org/ontology/sales#Booking"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.org/ontology/sales#hasProduct">
    <rdfs:label>has product</rdfs:label>
    <rdfs:comment>Links a booking transaction to the product being booked.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology/sales#Booking"/>
    <rdfs:range rdf:resource="http://example.org/ontology/sales#Product"/>
    <owl:inverseOf rdf:resource="http://example.org/ontology/sales#isProductForBooking"/>
    <sourceRelationship xmlns="http://example.org/ontology/sales#">fact_bookings.product_key -&gt; dim_product.product_key</sourceRelationship>
    <sourceGlossary xmlns="http://example.org/ontology/sales#">Outputs/DI Glossary Creator Agent/business_glossary_data_dictionary.md</sourceGlossary>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.org/ontology/sales#isProductForBooking">
    <rdfs:label>is product for booking</rdfs:label>
    <rdfs:comment>Inverse of has product.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology/sales#Product"/>
    <rdfs:range rdf:resource="http://example.org/ontology/sales#Booking"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.org/ontology/sales#hasPartner">
    <rdfs:label>has partner</rdfs:label>
    <rdfs:comment>Links a booking transaction to the partner involved in the sale.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology/sales#Booking"/>
    <rdfs:range rdf:resource="http://example.org/ontology/sales#Partner"/>
    <owl:inverseOf rdf:resource="http://example.org/ontology/sales#isPartnerForBooking"/>
    <sourceRelationship xmlns="http://example.org/ontology/sales#">fact_bookings.partner_key -&gt; dim_partner.partner_key</sourceRelationship>
    <sourceGlossary xmlns="http://example.org/ontology/sales#">Outputs/DI Glossary Creator Agent/business_glossary_data_dictionary.md</sourceGlossary>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.org/ontology/sales#isPartnerForBooking">
    <rdfs:label>is partner for booking</rdfs:label>
    <rdfs:comment>Inverse of has partner.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology/sales#Partner"/>
    <rdfs:range rdf:resource="http://example.org/ontology/sales#Booking"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.org/ontology/sales#hasGeography">
    <rdfs:label>has geography</rdfs:label>
    <rdfs:comment>Links a booking transaction to the associated geography classification.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology/sales#Booking"/>
    <rdfs:range rdf:resource="http://example.org/ontology/sales#Geography"/>
    <owl:inverseOf rdf:resource="http://example.org/ontology/sales#isGeographyForBooking"/>
    <sourceRelationship xmlns="http://example.org/ontology/sales#">fact_bookings.geography_key -&gt; dim_geography.geography_key</sourceRelationship>
    <sourceGlossary xmlns="http://example.org/ontology/sales#">Outputs/DI Glossary Creator Agent/business_glossary_data_dictionary.md</sourceGlossary>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.org/ontology/sales#isGeographyForBooking">
    <rdfs:label>is geography for booking</rdfs:label>
    <rdfs:comment>Inverse of has geography.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology/sales#Geography"/>
    <rdfs:range rdf:resource="http://example.org/ontology/sales#Booking"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.org/ontology/sales#hasSalesRepresentative">
    <rdfs:label>has sales representative</rdfs:label>
    <rdfs:comment>Links a booking transaction to the sales representative associated with the booking.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology/sales#Booking"/>
    <rdfs:range rdf:resource="http://example.org/ontology/sales#SalesRepresentative"/>
    <owl:inverseOf rdf:resource="http://example.org/ontology/sales#isSalesRepresentativeForBooking"/>
    <sourceRelationship xmlns="http://example.org/ontology/sales#">fact_bookings.sales_rep_key -&gt; dim_sales_rep.sales_rep_key</sourceRelationship>
    <sourceGlossary xmlns="http://example.org/ontology/sales#">Outputs/DI Glossary Creator Agent/business_glossary_data_dictionary.md</sourceGlossary>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.org/ontology/sales#isSalesRepresentativeForBooking">
    <rdfs:label>is sales representative for booking</rdfs:label>
    <rdfs:comment>Inverse of has sales representative.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology/sales#SalesRepresentative"/>
    <rdfs:range rdf:resource="http://example.org/ontology/sales#Booking"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.org/ontology/sales#hasContract">
    <rdfs:label>has contract</rdfs:label>
    <rdfs:comment>Links a booking transaction to the contract classification associated with the booking.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology/sales#Booking"/>
    <rdfs:range rdf:resource="http://example.org/ontology/sales#Contract"/>
    <owl:inverseOf rdf:resource="http://example.org/ontology/sales#isContractForBooking"/>
    <sourceRelationship xmlns="http://example.org/ontology/sales#">fact_bookings.contract_key -&gt; dim_contract.contract_key</sourceRelationship>
    <sourceGlossary xmlns="http://example.org/ontology/sales#">Outputs/DI Glossary Creator Agent/business_glossary_data_dictionary.md</sourceGlossary>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.org/ontology/sales#isContractForBooking">
    <rdfs:label>is contract for booking</rdfs:label>
    <rdfs:comment>Inverse of has contract.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology/sales#Contract"/>
    <rdfs:range rdf:resource="http://example.org/ontology/sales#Booking"/>
  </owl:ObjectProperty>

  <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales#contractKey">
    <rdfs:label>contract key</rdfs:label>
    <rdfs:comment>Unique surrogate key for the contract record used to join contract details to booking transactions.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology/sales#Contract"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <sourceTable xmlns="http://example.org/ontology/sales#">quotetobooking.dim_contract</sourceTable>
    <sourceColumn xmlns="http://example.org/ontology/sales#">contract_key</sourceColumn>
    <sourceAttribute xmlns="http://example.org/ontology/sales#">Contract Key</sourceAttribute>
    <businessDefinition xmlns="http://example.org/ontology/sales#">Unique surrogate key for the contract record used to join contract details to booking transactions.</businessDefinition>
    <businessDomain xmlns="http://example.org/ontology/sales#">Contracts</businessDomain>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales#contractType"><rdfs:label>contract type</rdfs:label><rdfs:comment>Type of customer contract or service agreement associated with the booking.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontology/sales#Contract"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><sourceTable xmlns="http://example.org/ontology/sales#">quotetobooking.dim_contract</sourceTable><sourceColumn xmlns="http://example.org/ontology/sales#">contract_type</sourceColumn><sourceAttribute xmlns="http://example.org/ontology/sales#">Contract Type</sourceAttribute><businessDefinition xmlns="http://example.org/ontology/sales#">Type of customer contract or service agreement associated with the booking.</businessDefinition><businessDomain xmlns="http://example.org/ontology/sales#">Contracts</businessDomain></owl:DatatypeProperty>
