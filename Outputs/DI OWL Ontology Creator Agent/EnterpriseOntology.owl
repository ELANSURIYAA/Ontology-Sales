    <ex:sourceColumn>sales_team</ex:sourceColumn>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://example.com/ontology/sales#segmentCovered">
    <rdfs:domain rdf:resource="http://example.com/ontology/sales#SalesRepresentative"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>segment covered</rdfs:label>
    <rdfs:comment>Customer segment or market segment covered by the sales representative.</rdfs:comment>
    <ex:sourceTable>quotetobooking.dim_sales_rep</ex:sourceTable>
    <ex:sourceColumn>segment_covered</ex:sourceColumn>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://example.com/ontology/sales#contractKeyDim">
    <rdfs:domain rdf:resource="http://example.com/ontology/sales#Contract"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label>contract key</rdfs:label>
    <rdfs:comment>Surrogate key that uniquely identifies a contract record in the contract dimension.</rdfs:comment>
    <ex:sourceTable>quotetobooking.dim_contract</ex:sourceTable>
    <ex:sourceColumn>contract_key</ex:sourceColumn>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://example.com/ontology/sales#contractType">
    <rdfs:domain rdf:resource="http://example.com/ontology/sales#Contract"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>contract type</rdfs:label>
    <rdfs:comment>Type of commercial agreement or support entitlement, such as Enterprise Agreement, SaaS Subscription, or Solution Support.</rdfs:comment>
    <ex:sourceTable>quotetobooking.dim_contract</ex:sourceTable>
    <ex:sourceColumn>contract_type</ex:sourceColumn>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://example.com/ontology/sales#termMonths">
    <rdfs:domain rdf:resource="http://example.com/ontology/sales#Contract"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label>term months</rdfs:label>
    <rdfs:comment>Number of months covered by the contract or subscription term.</rdfs:comment>
    <ex:sourceTable>quotetobooking.dim_contract</ex:sourceTable>
    <ex:sourceColumn>term_months</ex:sourceColumn>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://example.com/ontology/sales#autoRenewFlag">
    <rdfs:domain rdf:resource="http://example.com/ontology/sales#Contract"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label>auto renew flag</rdfs:label>
    <rdfs:comment>Indicator showing whether the contract is set to renew automatically at the end of its term.</rdfs:comment>
    <ex:sourceTable>quotetobooking.dim_contract</ex:sourceTable>
    <ex:sourceColumn>auto_renew_flag</ex:sourceColumn>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://example.com/ontology/sales#coverageLevel">
    <rdfs:domain rdf:resource="http://example.com/ontology/sales#Contract"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>coverage level</rdfs:label>
    <rdfs:comment>Service or support coverage level provided under the contract.</rdfs:comment>
    <ex:sourceTable>quotetobooking.dim_contract</ex:sourceTable>
    <ex:sourceColumn>coverage_level</ex:sourceColumn>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://example.com/ontology/sales#dateKeyDim">
    <rdfs:domain rdf:resource="http://example.com/ontology/sales#DateDimension"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label>date key</rdfs:label>
    <rdfs:comment>Intelligent date key in YYYYMMDD form used to join booking records to the date dimension.</rdfs:comment>
    <ex:sourceTable>quotetobooking.dim_date</ex:sourceTable>
    <ex:sourceColumn>date_key</ex:sourceColumn>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://example.com/ontology/sales#fullDate">
    <rdfs:domain rdf:resource="http://example.com/ontology/sales#DateDimension"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <rdfs:label>full date</rdfs:label>
    <rdfs:comment>Actual calendar date represented by the date record.</rdfs:comment>
    <ex:sourceTable>quotetobooking.dim_date</ex:sourceTable>
    <ex:sourceColumn>full_date</ex:sourceColumn>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://example.com/ontology/sales#monthName">
    <rdfs:domain rdf:resource="http://example.com/ontology/sales#DateDimension"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>month name</rdfs:label>
    <rdfs:comment>Name of the calendar month for the date.</rdfs:comment>
    <ex:sourceTable>quotetobooking.dim_date</ex:sourceTable>
    <ex:sourceColumn>month_name</ex:sourceColumn>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://example.com/ontology/sales#calendarYear">
    <rdfs:domain rdf:resource="http://example.com/ontology/sales#DateDimension"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label>calendar year</rdfs:label>
    <rdfs:comment>Calendar year associated with the date.</rdfs:comment>
    <ex:sourceTable>quotetobooking.dim_date</ex:sourceTable>
    <ex:sourceColumn>calendar_year</ex:sourceColumn>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://example.com/ontology/sales#fiscalYear">
    <rdfs:domain rdf:resource="http://example.com/ontology/sales#DateDimension"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>fiscal year</rdfs:label>
    <rdfs:comment>Fiscal year used for financial and sales reporting.</rdfs:comment>
    <ex:sourceTable>quotetobooking.dim_date</ex:sourceTable>
    <ex:sourceColumn>fiscal_year</ex:sourceColumn>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://example.com/ontology/sales#fiscalQuarter">
    <rdfs:domain rdf:resource="http://example.com/ontology/sales#DateDimension"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>fiscal quarter</rdfs:label>
    <rdfs:comment>Fiscal quarter used for period-based reporting and analysis.</rdfs:comment>
    <ex:sourceTable>quotetobooking.dim_date</ex:sourceTable>
    <ex:sourceColumn>fiscal_quarter</ex:sourceColumn>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://example.com/ontology/sales#fiscalPeriodSeq">
    <rdfs:domain rdf:resource="http://example.com/ontology/sales#DateDimension"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label>fiscal period seq</rdfs:label>
    <rdfs:comment>Sequential number representing the fiscal reporting period in order.</rdfs:comment>
    <ex:sourceTable>quotetobooking.dim_date</ex:sourceTable>
    <ex:sourceColumn>fiscal_period_seq</ex:sourceColumn>
  </owl:DatatypeProperty>

</rdf:RDF>