    <skos:definition>Represents business entities, relationships, attributes, measures, and source mappings for the Sales Bookings and Revenue Analytics domain.</skos:definition>
    <onto:baseURI>http://example.org/ontology/sales-bookings#</onto:baseURI>
    <onto:sourceGlossary>Outputs/DI Glossary Creator Agent/business_glossary_data_dictionary.md</onto:sourceGlossary>
    <onto:sourceBusinessProcessDocument>Inputs/Business Process Metrics Relationships.docx</onto:sourceBusinessProcessDocument>
    <onto:businessDomain>Sales Bookings and Revenue Analytics</onto:businessDomain>
    <onto:semanticSource>DI Glossary Creator Agent output</onto:semanticSource>
    <onto:validationWarning>Business Process, Metrics &amp; Relationships document was not retrievable from the repository path provided; cross-source validation and process/metric enrichment could not be completed.</onto:validationWarning>
    <onto:graphDBCompatibility>Designed as RDF/XML OWL 2 TBox for GraphDB and Protégé import.</onto:graphDBCompatibility>
  </owl:Ontology>

