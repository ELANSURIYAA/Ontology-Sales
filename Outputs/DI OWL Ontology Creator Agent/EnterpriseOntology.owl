<rdf:RDF
    xmlns="http://example.org/ontology/sales-bookings#"
    xml:base="http://example.org/ontology/sales-bookings"
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
    xmlns:skos="http://www.w3.org/2004/02/skos/core#"
    xmlns:dc="http://purl.org/dc/elements/1.1/"
    xmlns:dcterms="http://purl.org/dc/terms/"
    xmlns:oboInOwl="http://www.geneontology.org/formats/oboInOwl#"
    xmlns:ex="http://example.org/ontology/sales-bookings#">

    <owl:Ontology rdf:about="http://example.org/ontology/sales-bookings">
        <rdfs:label xml:lang="en">Sales Bookings and Revenue Enterprise Ontology</rdfs:label>
        <rdfs:comment xml:lang="en">OWL 2 ontology generated from the OSI Semantic Model for Sales Bookings and Revenue Analytics. The business process document could not be read from the repository, so the ontology is generated from the validated OSI Semantic Model only. This ontology is designed as a GraphDB-compatible TBox ontology for enterprise knowledge graph construction, semantic querying, and reasoning.</rdfs:comment>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <dc:source>Outputs/DI OSI Semantic Creator Agent/OSI Semantic Model.md</dc:source>
        <dc:source>Inputs/QuoteToBooking.docx</dc:source>
        <dcterms:created>2026-07-28</dcterms:created>
        <dcterms:creator>DI OWL Ontology Creator Agent</dcterms:creator>
        <dcterms:description>Ontology schema representing business entities, attributes, measures, and relationships for quote-to-booking analytics.</dcterms:description>
        <oboInOwl:hasDbXref>Business Domain: Sales Bookings and Revenue Analytics</oboInOwl:hasDbXref>
    </owl:Ontology>

    <owl:AnnotationProperty rdf:about="http://example.org/ontology/sales-bookings#businessDefinition">
        <rdfs:label>business definition</rdfs:label>
    </owl:AnnotationProperty>

    <owl:AnnotationProperty rdf:about="http://example.org/ontology/sales-bookings#businessDescription">
        <rdfs:label>business description</rdfs:label>
    </owl:AnnotationProperty>

    <owl:AnnotationProperty rdf:about="http://example.org/ontology/sales-bookings#sourceTable">
        <rdfs:label>source table</rdfs:label>
    </owl:AnnotationProperty>

    <owl:AnnotationProperty rdf:about="http://example.org/ontology/sales-bookings#sourceColumn">
        <rdfs:label>source column</rdfs:label>
    </owl:AnnotationProperty>

    <owl:AnnotationProperty rdf:about="http://example.org/ontology/sales-bookings#sourceEntity">
        <rdfs:label>source entity</rdfs:label>
    </owl:AnnotationProperty>

    <owl:AnnotationProperty rdf:about="http://example.org/ontology/sales-bookings#sourceRelationship">
        <rdfs:label>source relationship</rdfs:label>
    </owl:AnnotationProperty>

    <owl:AnnotationProperty rdf:about="http://example.org/ontology/sales-bookings#businessDomain">
        <rdfs:label>business domain</rdfs:label>
    </owl:AnnotationProperty>

    <owl:AnnotationProperty rdf:about="http://example.org/ontology/sales-bookings#sourceSemanticModel">
        <rdfs:label>source semantic model</rdfs:label>
    </owl:AnnotationProperty>

    <owl:Class rdf:about="http://example.org/ontology/sales-bookings#Contract">
        <rdfs:label>Contract</rdfs:label>
        <rdfs:comment>Stores the business attributes of commercial agreements associated with bookings, including contract type, term, renewal behavior, and support coverage level.</rdfs:comment>
        <ex:businessDefinition>Stores the business attributes of commercial agreements associated with bookings, including contract type, term, renewal behavior, and support coverage level.</ex:businessDefinition>
        <ex:sourceTable>QuoteToBooking.dim_contract</ex:sourceTable>
        <ex:sourceEntity>ENT001</ex:sourceEntity>
        <ex:businessDomain>Sales Bookings and Revenue Analytics</ex:businessDomain>
        <ex:sourceSemanticModel>OSI Semantic Model.md</ex:sourceSemanticModel>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/sales-bookings#Customer">
        <rdfs:label>Customer</rdfs:label>
        <rdfs:comment>Stores descriptive information about customers that place orders and generate bookings, including segment, industry, account tier, and headquarters location.</rdfs:comment>
        <ex:businessDefinition>Stores descriptive information about customers that place orders and generate bookings, including segment, industry, account tier, and headquarters location.</ex:businessDefinition>
        <ex:sourceTable>QuoteToBooking.dim_customer</ex:sourceTable>
        <ex:sourceEntity>ENT002</ex:sourceEntity>
        <ex:businessDomain>Sales Bookings and Revenue Analytics</ex:businessDomain>
        <ex:sourceSemanticModel>OSI Semantic Model.md</ex:sourceSemanticModel>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/sales-bookings#Date">
        <rdfs:label>Date</rdfs:label>
        <rdfs:comment>Stores calendar and fiscal date attributes used to analyze bookings over time.</rdfs:comment>
        <ex:businessDefinition>Stores calendar and fiscal date attributes used to analyze bookings over time.</ex:businessDefinition>
        <ex:sourceTable>QuoteToBooking.dim_date</ex:sourceTable>
        <ex:sourceEntity>ENT003</ex:sourceEntity>
        <ex:businessDomain>Sales Bookings and Revenue Analytics</ex:businessDomain>
        <ex:sourceSemanticModel>OSI Semantic Model.md</ex:sourceSemanticModel>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/sales-bookings#Geography">
        <rdfs:label>Geography</rdfs:label>
        <rdfs:comment>Stores geographic attributes used to analyze bookings by sales region, theater, and country.</rdfs:comment>
        <ex:businessDefinition>Stores geographic attributes used to analyze bookings by sales region, theater, and country.</ex:businessDefinition>
        <ex:sourceTable>QuoteToBooking.dim_geography</ex:sourceTable>
        <ex:sourceEntity>ENT004</ex:sourceEntity>
        <ex:businessDomain>Sales Bookings and Revenue Analytics</ex:businessDomain>
        <ex:sourceSemanticModel>OSI Semantic Model.md</ex:sourceSemanticModel>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/sales-bookings#Partner">
        <rdfs:label>Partner</rdfs:label>
        <rdfs:comment>Stores information about channel and direct partners involved in the sales process, including partner type, partner tier, and route to market.</rdfs:comment>
        <ex:businessDefinition>Stores information about channel and direct partners involved in the sales process, including partner type, partner tier, and route to market.</ex:businessDefinition>
        <ex:sourceTable>QuoteToBooking.dim_partner</ex:sourceTable>
        <ex:sourceEntity>ENT005</ex:sourceEntity>
        <ex:businessDomain>Sales Bookings and Revenue Analytics</ex:businessDomain>
        <ex:sourceSemanticModel>OSI Semantic Model.md</ex:sourceSemanticModel>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/sales-bookings#Product">
        <rdfs:label>Product</rdfs:label>
        <rdfs:comment>Stores descriptive information about products and offers sold to customers, including product family, technology domain, offer type, and business entity.</rdfs:comment>
        <ex:businessDefinition>Stores descriptive information about products and offers sold to customers, including product family, technology domain, offer type, and business entity.</ex:businessDefinition>
        <ex:sourceTable>QuoteToBooking.dim_product</ex:sourceTable>
        <ex:sourceEntity>ENT006</ex:sourceEntity>
        <ex:businessDomain>Sales Bookings and Revenue Analytics</ex:businessDomain>
        <ex:sourceSemanticModel>OSI Semantic Model.md</ex:sourceSemanticModel>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/sales-bookings#SalesRepresentative">
        <rdfs:label>Sales Representative</rdfs:label>
        <rdfs:comment>Stores information about sales personnel responsible for managing customer relationships and booking transactions.</rdfs:comment>
        <ex:businessDefinition>Stores information about sales personnel responsible for managing customer relationships and booking transactions.</ex:businessDefinition>
        <ex:sourceTable>QuoteToBooking.dim_sales_rep</ex:sourceTable>
        <ex:sourceEntity>ENT007</ex:sourceEntity>
        <ex:businessDomain>Sales Bookings and Revenue Analytics</ex:businessDomain>
        <ex:sourceSemanticModel>OSI Semantic Model.md</ex:sourceSemanticModel>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/sales-bookings#BookingTransaction">
        <rdfs:label>Booking Transaction</rdfs:label>
        <rdfs:comment>Stores individual completed sales booking transactions with related financial measures and links to customer, product, partner, geography, sales representative, contract, and date dimensions.</rdfs:comment>
        <ex:businessDefinition>Stores individual completed sales booking transactions with related financial measures and links to customer, product, partner, geography, sales representative, contract, and date dimensions.</ex:businessDefinition>
        <ex:sourceTable>QuoteToBooking.fact_bookings</ex:sourceTable>
        <ex:sourceEntity>ENT008</ex:sourceEntity>
        <ex:businessDomain>Sales Bookings and Revenue Analytics</ex:businessDomain>
        <ex:sourceSemanticModel>OSI Semantic Model.md</ex:sourceSemanticModel>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/ontology/sales-bookings#hasContract"/>
                <owl:someValuesFrom rdf:resource="http://example.org/ontology/sales-bookings#Contract"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/ontology/sales-bookings#hasCustomer"/>
                <owl:someValuesFrom rdf:resource="http://example.org/ontology/sales-bookings#Customer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/ontology/sales-bookings#hasBookingDate"/>
                <owl:someValuesFrom rdf:resource="http://example.org/ontology/sales-bookings#Date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/ontology/sales-bookings#hasGeography"/>
                <owl:someValuesFrom rdf:resource="http://example.org/ontology/sales-bookings#Geography"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/ontology/sales-bookings#hasPartner"/>
                <owl:someValuesFrom rdf:resource="http://example.org/ontology/sales-bookings#Partner"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/ontology/sales-bookings#hasProduct"/>
                <owl:someValuesFrom rdf:resource="http://example.org/ontology/sales-bookings#Product"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/ontology/sales-bookings#hasSalesRepresentative"/>
                <owl:someValuesFrom rdf:resource="http://example.org/ontology/sales-bookings#SalesRepresentative"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/ontology/sales-bookings#hasCustomer"/>
                <owl:allValuesFrom rdf:resource="http://example.org/ontology/sales-bookings#Customer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/ontology/sales-bookings#hasProduct"/>
                <owl:allValuesFrom rdf:resource="http://example.org/ontology/sales-bookings#Product"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:AllDisjointClasses>
        <owl:members rdf:parseType="Collection">
            <rdf:Description rdf:about="http://example.org/ontology/sales-bookings#Contract"/>
            <rdf:Description rdf:about="http://example.org/ontology/sales-bookings#Customer"/>
            <rdf:Description rdf:about="http://example.org/ontology/sales-bookings#Date"/>
            <rdf:Description rdf:about="http://example.org/ontology/sales-bookings#Geography"/>
            <rdf:Description rdf:about="http://example.org/ontology/sales-bookings#Partner"/>
            <rdf:Description rdf:about="http://example.org/ontology/sales-bookings#Product"/>
            <rdf:Description rdf:about="http://example.org/ontology/sales-bookings#SalesRepresentative"/>
            <rdf:Description rdf:about="http://example.org/ontology/sales-bookings#BookingTransaction"/>
        </owl:members>
    </owl:AllDisjointClasses>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/sales-bookings#hasContract">
        <rdfs:label>has contract</rdfs:label>
        <rdfs:comment>Relates a booking transaction to the contract associated with the booking.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings#BookingTransaction"/>
        <rdfs:range rdf:resource="http://example.org/ontology/sales-bookings#Contract"/>
        <owl:inverseOf rdf:resource="http://example.org/ontology/sales-bookings#isContractOfBookingTransaction"/>
        <ex:sourceRelationship>REL001</ex:sourceRelationship>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/sales-bookings#isContractOfBookingTransaction">
        <rdfs:label>is contract of booking transaction</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings#Contract"/>
        <rdfs:range rdf:resource="http://example.org/ontology/sales-bookings#BookingTransaction"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/sales-bookings#hasCustomer">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label>has customer</rdfs:label>
        <rdfs:comment>Relates a booking transaction to the customer placing the order and generating the booking.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings#BookingTransaction"/>
        <rdfs:range rdf:resource="http://example.org/ontology/sales-bookings#Customer"/>
        <owl:inverseOf rdf:resource="http://example.org/ontology/sales-bookings#isCustomerOfBookingTransaction"/>
        <ex:sourceRelationship>REL002</ex:sourceRelationship>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/sales-bookings#isCustomerOfBookingTransaction">
        <rdfs:label>is customer of booking transaction</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings#Customer"/>
        <rdfs:range rdf:resource="http://example.org/ontology/sales-bookings#BookingTransaction"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/sales-bookings#hasBookingDate">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label>has booking date</rdfs:label>
        <rdfs:comment>Relates a booking transaction to the reporting date used to analyze bookings over time.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings#BookingTransaction"/>
        <rdfs:range rdf:resource="http://example.org/ontology/sales-bookings#Date"/>
        <owl:inverseOf rdf:resource="http://example.org/ontology/sales-bookings#isBookingDateOfTransaction"/>
        <ex:sourceRelationship>REL003</ex:sourceRelationship>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/sales-bookings#isBookingDateOfTransaction">
        <rdfs:label>is booking date of transaction</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings#Date"/>
        <rdfs:range rdf:resource="http://example.org/ontology/sales-bookings#BookingTransaction"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/sales-bookings#hasGeography">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label>has geography</rdfs:label>
        <rdfs:comment>Relates a booking transaction to the geography used for regional sales analysis.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings#BookingTransaction"/>
        <rdfs:range rdf:resource="http://example.org/ontology/sales-bookings#Geography"/>
        <owl:inverseOf rdf:resource="http://example.org/ontology/sales-bookings#isGeographyOfBookingTransaction"/>
        <ex:sourceRelationship>REL004</ex:sourceRelationship>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/sales-bookings#isGeographyOfBookingTransaction">
        <rdfs:label>is geography of booking transaction</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings#Geography"/>
        <rdfs:range rdf:resource="http://example.org/ontology/sales-bookings#BookingTransaction"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/sales-bookings#hasPartner">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label>has partner</rdfs:label>
        <rdfs:comment>Relates a booking transaction to the partner involved in the sales process.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings#BookingTransaction"/>
        <rdfs:range rdf:resource="http://example.org/ontology/sales-bookings#Partner"/>
        <owl:inverseOf rdf:resource="http://example.org/ontology/sales-bookings#isPartnerOfBookingTransaction"/>
        <ex:sourceRelationship>REL005</ex:sourceRelationship>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/sales-bookings#isPartnerOfBookingTransaction">
        <rdfs:label>is partner of booking transaction</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings#Partner"/>
        <rdfs:range rdf:resource="http://example.org/ontology/sales-bookings#BookingTransaction"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/sales-bookings#hasProduct">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label>has product</rdfs:label>
        <rdfs:comment>Relates a booking transaction to the product or offer sold to the customer.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings#BookingTransaction"/>
        <rdfs:range rdf:resource="http://example.org/ontology/sales-bookings#Product"/>
        <owl:inverseOf rdf:resource="http://example.org/ontology/sales-bookings#isProductOfBookingTransaction"/>
        <ex:sourceRelationship>REL006</ex:sourceRelationship>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/sales-bookings#isProductOfBookingTransaction">
        <rdfs:label>is product of booking transaction</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings#Product"/>
        <rdfs:range rdf:resource="http://example.org/ontology/sales-bookings#BookingTransaction"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/sales-bookings#hasSalesRepresentative">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label>has sales representative</rdfs:label>
        <rdfs:comment>Relates a booking transaction to the sales representative responsible for the transaction.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings#BookingTransaction"/>
        <rdfs:range rdf:resource="http://example.org/ontology/sales-bookings#SalesRepresentative"/>
        <owl:inverseOf rdf:resource="http://example.org/ontology/sales-bookings#isSalesRepresentativeOfBookingTransaction"/>
        <ex:sourceRelationship>REL007</ex:sourceRelationship>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/sales-bookings#isSalesRepresentativeOfBookingTransaction">
        <rdfs:label>is sales representative of booking transaction</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings#SalesRepresentative"/>
        <rdfs:range rdf:resource="http://example.org/ontology/sales-bookings#BookingTransaction"/>
    </owl:ObjectProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales-bookings#contractKey">
        <rdfs:label>contract key</rdfs:label>
        <rdfs:comment>Surrogate key that uniquely identifies a contract record in the contract dimension.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings#Contract"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <ex:sourceTable>QuoteToBooking.dim_contract</ex:sourceTable>
        <ex:sourceColumn>contract_key</ex:sourceColumn>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales-bookings#contractType"><rdfs:label>contract type</rdfs:label><rdfs:comment>Describes the type of commercial agreement attached to the booking, such as SaaS subscription, Enterprise Agreement, or support contract.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings#Contract"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ex:sourceTable>QuoteToBooking.dim_contract</ex:sourceTable><ex:sourceColumn>contract_type</ex:sourceColumn></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales-bookings#contractTermMonths"><rdfs:label>contract term months</rdfs:label><rdfs:comment>Indicates the duration of the contract in months.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings#Contract"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/><ex:sourceTable>QuoteToBooking.dim_contract</ex:sourceTable><ex:sourceColumn>term_months</ex:sourceColumn></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales-bookings#autoRenewFlag"><rdfs:label>auto renew flag</rdfs:label><rdfs:comment>Indicates whether the contract is set to renew automatically at the end of its term.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings#Contract"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ex:sourceTable>QuoteToBooking.dim_contract</ex:sourceTable><ex:sourceColumn>auto_renew_flag</ex:sourceColumn></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales-bookings#coverageLevel"><rdfs:label>coverage level</rdfs:label><rdfs:comment>Describes the level of service or support coverage provided under the contract.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings#Contract"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ex:sourceTable>QuoteToBooking.dim_contract</ex:sourceTable><ex:sourceColumn>coverage_level</ex:sourceColumn></owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales-bookings#customerKey"><rdfs:label>customer key</rdfs:label><rdfs:comment>Surrogate key that uniquely identifies a customer record in the customer dimension.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings#Customer"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/><ex:sourceTable>QuoteToBooking.dim_customer</ex:sourceTable><ex:sourceColumn>customer_key</ex:sourceColumn></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales-bookings#customerId"><rdfs:label>customer id</rdfs:label><rdfs:comment>Business identifier assigned to the customer account.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings#Customer"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ex:sourceTable>QuoteToBooking.dim_customer</ex:sourceTable><ex:sourceColumn>customer_id</ex:sourceColumn></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales-bookings#customerName"><rdfs:label>customer name</rdfs:label><rdfs:comment>Official name of the customer organization that purchased products or services.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings#Customer"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ex:sourceTable>QuoteToBooking.dim_customer</ex:sourceTable><ex:sourceColumn>customer_name</ex:sourceColumn></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales-bookings#customerSegment"><rdfs:label>customer segment</rdfs:label><rdfs:comment>Classifies the customer into a business segment such as Enterprise, Service Provider, or Public Sector.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings#Customer"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ex:sourceTable>QuoteToBooking.dim_customer</ex:sourceTable><ex:sourceColumn>segment</ex:sourceColumn></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales-bookings#industry"><rdfs:label>industry</rdfs:label><rdfs:comment>Identifies the industry in which the customer operates.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings#Customer"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ex:sourceTable>QuoteToBooking.dim_customer</ex:sourceTable><ex:sourceColumn>industry</ex:sourceColumn></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales-bookings#accountTier"><rdfs:label>account tier</rdfs:label><rdfs:comment>Indicates the strategic importance or service tier of the customer account.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings#Customer"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ex:sourceTable>QuoteToBooking.dim_customer</ex:sourceTable><ex:sourceColumn>account_tier</ex:sourceColumn></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales-bookings#headquartersCountry"><rdfs:label>headquarters country</rdfs:label><rdfs:comment>Country where the customer organization's headquarters is located.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings#Customer"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ex:sourceTable>QuoteToBooking.dim_customer</ex:sourceTable><ex:sourceColumn>hq_country</ex:sourceColumn></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales-bookings#headquartersRegion"><rdfs:label>headquarters region</rdfs:label><rdfs:comment>Global region where the customer organization's headquarters is located.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings#Customer"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ex:sourceTable>QuoteToBooking.dim_customer</ex:sourceTable><ex:sourceColumn>hq_region</ex:sourceColumn></owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales-bookings#dateKey"><rdfs:label>date key</rdfs:label><rdfs:comment>Encoded key that uniquely identifies a reporting date in the date dimension.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings#Date"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/><ex:sourceTable>QuoteToBooking.dim_date</ex:sourceTable><ex:sourceColumn>date_key</ex:sourceColumn></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales-bookings#fullDate"><rdfs:label>full date</rdfs:label><rdfs:comment>Actual calendar date represented by the date record.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings#Date"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/><ex:sourceTable>QuoteToBooking.dim_date</ex:sourceTable><ex:sourceColumn>full_date</ex:sourceColumn></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales-bookings#monthName"><rdfs:label>month name</rdfs:label><rdfs:comment>Name of the calendar month for the date.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings#Date"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ex:sourceTable>QuoteToBooking.dim_date</ex:sourceTable><ex:sourceColumn>month_name</ex:sourceColumn></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales-bookings#calendarYear"><rdfs:label>calendar year</rdfs:label><rdfs:comment>Four-digit calendar year associated with the date.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings#Date"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/><ex:sourceTable>QuoteToBooking.dim_date</ex:sourceTable><ex:sourceColumn>calendar_year</ex:sourceColumn></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales-bookings#fiscalYear"><rdfs:label>fiscal year</rdfs:label><rdfs:comment>Fiscal year used by the business for financial and performance reporting.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings#Date"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ex:sourceTable>QuoteToBooking.dim_date</ex:sourceTable><ex:sourceColumn>fiscal_year</ex:sourceColumn></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales-bookings#fiscalQuarter"><rdfs:label>fiscal quarter</rdfs:label><rdfs:comment>Fiscal quarter used by the business for periodic reporting and analysis.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings#Date"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ex:sourceTable>QuoteToBooking.dim_date</ex:sourceTable><ex:sourceColumn>fiscal_quarter</ex:sourceColumn></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales-bookings#fiscalPeriodSequence"><rdfs:label>fiscal period sequence</rdfs:label><rdfs:comment>Sequential number representing the fiscal reporting period in ordered time analysis.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings#Date"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/><ex:sourceTable>QuoteToBooking.dim_date</ex:sourceTable><ex:sourceColumn>fiscal_period_seq</ex:sourceColumn></owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales-bookings#geographyKey"><rdfs:label>geography key</rdfs:label><rdfs:comment>Surrogate key that uniquely identifies a geography record in the geography dimension.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings#Geography"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/><ex:sourceTable>QuoteToBooking.dim_geography</ex:sourceTable><ex:sourceColumn>geography_key</ex:sourceColumn></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales-bookings#salesRegion"><rdfs:label>sales region</rdfs:label><rdfs:comment>High-level geographic region used for reporting and performance analysis.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings#Geography"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ex:sourceTable>QuoteToBooking.dim_geography</ex:sourceTable><ex:sourceColumn>region</ex:sourceColumn></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales-bookings#salesTheater"><rdfs:label>sales theater</rdfs:label><rdfs:comment>Subregional sales area or theater used to organize market coverage and reporting.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings#Geography"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ex:sourceTable>QuoteToBooking.dim_geography</ex:sourceTable><ex:sourceColumn>theater</ex:sourceColumn></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales-bookings#country"><rdfs:label>country</rdfs:label><rdfs:comment>Country associated with the geography record.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings#Geography"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><ex:sourceTable>QuoteToBooking.dim_geography</ex:sourceTable><ex:sourceColumn>country</ex:sourceColumn></owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales-bookings#partnerKey"><rdfs:label>partner key</rdfs:label><rdfs:comment>Surrogate key that uniquely identifies a partner record in the partner dimension.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings#Partner"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/><ex:sourceTable>QuoteToBooking.dim_partner</ex:sourceTable><ex:sourceColumn>partner_key</ex:sourceColumn></owl:DatatypeProperty>
