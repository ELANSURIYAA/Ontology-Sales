    <rdfs:label>source semantic model</rdfs:label>
  </owl:AnnotationProperty>

  <owl:Class rdf:about="http://example.com/ontology/sales#DomainConcept">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:label>Domain Concept</rdfs:label>
    <rdfs:comment>Top-level business domain concept class for the enterprise sales ontology.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://example.com/ontology/sales#BusinessEntity">
    <rdfs:subClassOf rdf:resource="http://example.com/ontology/sales#DomainConcept"/>
    <rdfs:label>Business Entity</rdfs:label>
    <rdfs:comment>General class for core business entities represented in the semantic model.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://example.com/ontology/sales#Transaction">
    <rdfs:subClassOf rdf:resource="http://example.com/ontology/sales#BusinessEntity"/>
    <rdfs:label>Transaction</rdfs:label>
    <rdfs:comment>General class for transactional business records.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://example.com/ontology/sales#Dimension">
    <rdfs:subClassOf rdf:resource="http://example.com/ontology/sales#BusinessEntity"/>
    <rdfs:label>Dimension</rdfs:label>
    <rdfs:comment>General class for analytic dimensions that contextualize transactions.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://example.com/ontology/sales#TimeDimension">
    <rdfs:subClassOf rdf:resource="http://example.com/ontology/sales#Dimension"/>
    <rdfs:label>Time Dimension</rdfs:label>
    <rdfs:comment>General class for temporal and reporting period dimensions.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://example.com/ontology/sales#Booking">
    <rdfs:subClassOf rdf:resource="http://example.com/ontology/sales#Transaction"/>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://example.com/ontology/sales#hasCustomer"/>
        <owl:someValuesFrom rdf:resource="http://example.com/ontology/sales#Customer"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://example.com/ontology/sales#hasProduct"/>
        <owl:someValuesFrom rdf:resource="http://example.com/ontology/sales#Product"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://example.com/ontology/sales#hasPartner"/>
        <owl:someValuesFrom rdf:resource="http://example.com/ontology/sales#Partner"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://example.com/ontology/sales#hasGeography"/>
        <owl:someValuesFrom rdf:resource="http://example.com/ontology/sales#Geography"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://example.com/ontology/sales#hasSalesRepresentative"/>
        <owl:someValuesFrom rdf:resource="http://example.com/ontology/sales#SalesRepresentative"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://example.com/ontology/sales#hasContract"/>
        <owl:someValuesFrom rdf:resource="http://example.com/ontology/sales#Contract"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://example.com/ontology/sales#hasBookingDate"/>
        <owl:someValuesFrom rdf:resource="http://example.com/ontology/sales#DateDimension"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://example.com/ontology/sales#hasCustomer"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onClass rdf:resource="http://example.com/ontology/sales#Customer"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://example.com/ontology/sales#hasProduct"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onClass rdf:resource="http://example.com/ontology/sales#Product"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://example.com/ontology/sales#hasPartner"/>
        <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
        <owl:onClass rdf:resource="http://example.com/ontology/sales#Partner"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://example.com/ontology/sales#hasGeography"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onClass rdf:resource="http://example.com/ontology/sales#Geography"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://example.com/ontology/sales#hasSalesRepresentative"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onClass rdf:resource="http://example.com/ontology/sales#SalesRepresentative"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://example.com/ontology/sales#hasContract"/>
        <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
        <owl:onClass rdf:resource="http://example.com/ontology/sales#Contract"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://example.com/ontology/sales#hasBookingDate"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onClass rdf:resource="http://example.com/ontology/sales#DateDimension"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:label>Booking</rdfs:label>
    <rdfs:comment>Completed sales booking transaction captured at booking transaction grain with financial measures, quantities, renewal status, and links to related business dimensions.</rdfs:comment>
    <ex:businessDefinition>Captures individual completed sales booking transactions and their associated financial measures, quantities, renewal status, and links to related business dimensions.</ex:businessDefinition>
    <ex:sourceEntity>bookings</ex:sourceEntity>
    <ex:sourceTable>quotetobooking.fact_bookings</ex:sourceTable>
    <ex:businessDomain>Sales Bookings and Revenue Analytics</ex:businessDomain>
    <ex:sourceSemanticModel>sales_bookings_and_revenue_analytics</ex:sourceSemanticModel>
  </owl:Class>

  <owl:Class rdf:about="http://example.com/ontology/sales#Customer">
    <rdfs:subClassOf rdf:resource="http://example.com/ontology/sales#Dimension"/>
    <rdfs:label>Customer</rdfs:label>
    <rdfs:comment>Customer organization that places orders and is described by identity, segment, industry, account tier, and headquarters location.</rdfs:comment>
    <ex:businessDefinition>Stores descriptive information about customers that place orders, including identity, segment, industry, account tier, and headquarters location.</ex:businessDefinition>
    <ex:sourceEntity>customers</ex:sourceEntity>
    <ex:sourceTable>quotetobooking.dim_customer</ex:sourceTable>
    <ex:businessDomain>Sales Bookings and Revenue Analytics</ex:businessDomain>
  </owl:Class>

  <owl:Class rdf:about="http://example.com/ontology/sales#Product">
    <rdfs:subClassOf rdf:resource="http://example.com/ontology/sales#Dimension"/>
    <rdfs:label>Product</rdfs:label>
    <rdfs:comment>Product or offer sold to customers, including product identity, family, technology domain, offer type, and business entity.</rdfs:comment>
    <ex:businessDefinition>Stores descriptive information about products and offers sold to customers, including product identity, family, technology domain, offer type, and business entity.</ex:businessDefinition>
    <ex:sourceEntity>products</ex:sourceEntity>
    <ex:sourceTable>quotetobooking.dim_product</ex:sourceTable>
    <ex:businessDomain>Sales Bookings and Revenue Analytics</ex:businessDomain>
  </owl:Class>

  <owl:Class rdf:about="http://example.com/ontology/sales#Partner">
    <rdfs:subClassOf rdf:resource="http://example.com/ontology/sales#Dimension"/>
    <rdfs:label>Partner</rdfs:label>
    <rdfs:comment>Direct or indirect sales partner involved in fulfilling customer bookings.</rdfs:comment>
    <ex:businessDefinition>Stores information about direct and indirect sales partners involved in fulfilling customer bookings, including partner identity, type, tier, and route to market.</ex:businessDefinition>
    <ex:sourceEntity>partners</ex:sourceEntity>
    <ex:sourceTable>quotetobooking.dim_partner</ex:sourceTable>
    <ex:businessDomain>Sales Bookings and Revenue Analytics</ex:businessDomain>
  </owl:Class>

  <owl:Class rdf:about="http://example.com/ontology/sales#Geography">
    <rdfs:subClassOf rdf:resource="http://example.com/ontology/sales#Dimension"/>
    <rdfs:label>Geography</rdfs:label>
    <rdfs:comment>Geographic sales territory used to analyze bookings by region, theater, and country.</rdfs:comment>
    <ex:businessDefinition>Stores geographic sales territory attributes used to analyze bookings by region, theater, and country.</ex:businessDefinition>
    <ex:sourceEntity>geographies</ex:sourceEntity>
    <ex:sourceTable>quotetobooking.dim_geography</ex:sourceTable>
    <ex:businessDomain>Sales Bookings and Revenue Analytics</ex:businessDomain>
  </owl:Class>

  <owl:Class rdf:about="http://example.com/ontology/sales#SalesRepresentative">
    <rdfs:subClassOf rdf:resource="http://example.com/ontology/sales#Dimension"/>
    <rdfs:label>Sales Representative</rdfs:label>
    <rdfs:comment>Sales person responsible for managing customer relationships and booking transactions.</rdfs:comment>
    <ex:businessDefinition>Stores information about the sales person responsible for managing customer relationships and booking transactions, including role, team, and segment coverage.</ex:businessDefinition>
    <ex:sourceEntity>sales_representatives</ex:sourceEntity>
    <ex:sourceTable>quotetobooking.dim_sales_rep</ex:sourceTable>
    <ex:businessDomain>Sales Bookings and Revenue Analytics</ex:businessDomain>
  </owl:Class>

  <owl:Class rdf:about="http://example.com/ontology/sales#Contract">
    <rdfs:subClassOf rdf:resource="http://example.com/ontology/sales#Dimension"/>
    <rdfs:label>Contract</rdfs:label>
    <rdfs:comment>Commercial agreement or service coverage terms associated with a booking.</rdfs:comment>
    <ex:businessDefinition>Describes the commercial agreement or service coverage terms associated with a booking, including contract type, duration, renewal behavior, and support coverage level.</ex:businessDefinition>
    <ex:sourceEntity>contracts</ex:sourceEntity>
    <ex:sourceTable>quotetobooking.dim_contract</ex:sourceTable>
    <ex:businessDomain>Sales Bookings and Revenue Analytics</ex:businessDomain>
  </owl:Class>

  <owl:Class rdf:about="http://example.com/ontology/sales#DateDimension">
    <rdfs:subClassOf rdf:resource="http://example.com/ontology/sales#TimeDimension"/>
    <rdfs:label>Date Dimension</rdfs:label>
    <rdfs:comment>Calendar and fiscal time attributes used to analyze bookings across reporting periods, years, quarters, and months.</rdfs:comment>
    <ex:businessDefinition>Provides calendar and fiscal time attributes used to analyze bookings across reporting periods, years, quarters, and months.</ex:businessDefinition>
    <ex:sourceEntity>dates</ex:sourceEntity>
    <ex:sourceTable>quotetobooking.dim_date</ex:sourceTable>
    <ex:businessDomain>Sales Bookings and Revenue Analytics</ex:businessDomain>
  </owl:Class>

  <owl:AllDisjointClasses>
    <owl:members rdf:parseType="Collection">
      <rdf:Description rdf:about="http://example.com/ontology/sales#Customer"/>
      <rdf:Description rdf:about="http://example.com/ontology/sales#Product"/>
      <rdf:Description rdf:about="http://example.com/ontology/sales#Partner"/>
      <rdf:Description rdf:about="http://example.com/ontology/sales#Geography"/>
      <rdf:Description rdf:about="http://example.com/ontology/sales#SalesRepresentative"/>
      <rdf:Description rdf:about="http://example.com/ontology/sales#Contract"/>
      <rdf:Description rdf:about="http://example.com/ontology/sales#DateDimension"/>
    </owl:members>
  </owl:AllDisjointClasses>

  <owl:ObjectProperty rdf:about="http://example.com/ontology/sales#hasCustomer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://example.com/ontology/sales#Booking"/>
    <rdfs:range rdf:resource="http://example.com/ontology/sales#Customer"/>
    <owl:inverseOf rdf:resource="http://example.com/ontology/sales#isCustomerOfBooking"/>
    <rdfs:label>has customer</rdfs:label>
    <rdfs:comment>Relates a booking transaction to the customer dimension record associated with the booking.</rdfs:comment>
    <ex:sourceRelationship>bookings_to_customers</ex:sourceRelationship>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.com/ontology/sales#isCustomerOfBooking">
    <rdfs:domain rdf:resource="http://example.com/ontology/sales#Customer"/>
    <rdfs:range rdf:resource="http://example.com/ontology/sales#Booking"/>
    <rdfs:label>is customer of booking</rdfs:label>
    <rdfs:comment>Inverse relation from customer to bookings associated with that customer.</rdfs:comment>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.com/ontology/sales#hasProduct">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://example.com/ontology/sales#Booking"/>
    <rdfs:range rdf:resource="http://example.com/ontology/sales#Product"/>
    <owl:inverseOf rdf:resource="http://example.com/ontology/sales#isProductOfBooking"/>
    <rdfs:label>has product</rdfs:label>
    <rdfs:comment>Relates a booking transaction to the product dimension record associated with the booking.</rdfs:comment>
    <ex:sourceRelationship>bookings_to_products</ex:sourceRelationship>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.com/ontology/sales#isProductOfBooking">
    <rdfs:domain rdf:resource="http://example.com/ontology/sales#Product"/>
    <rdfs:range rdf:resource="http://example.com/ontology/sales#Booking"/>
    <rdfs:label>is product of booking</rdfs:label>
    <rdfs:comment>Inverse relation from product to bookings associated with that product.</rdfs:comment>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.com/ontology/sales#hasPartner">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://example.com/ontology/sales#Booking"/>
    <rdfs:range rdf:resource="http://example.com/ontology/sales#Partner"/>
    <owl:inverseOf rdf:resource="http://example.com/ontology/sales#isPartnerOfBooking"/>
    <rdfs:label>has partner</rdfs:label>
    <rdfs:comment>Relates a booking transaction to the partner dimension record associated with the booking.</rdfs:comment>
    <ex:sourceRelationship>bookings_to_partners</ex:sourceRelationship>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.com/ontology/sales#isPartnerOfBooking">
    <rdfs:domain rdf:resource="http://example.com/ontology/sales#Partner"/>
    <rdfs:range rdf:resource="http://example.com/ontology/sales#Booking"/>
    <rdfs:label>is partner of booking</rdfs:label>
    <rdfs:comment>Inverse relation from partner to bookings associated with that partner.</rdfs:comment>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.com/ontology/sales#hasGeography">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://example.com/ontology/sales#Booking"/>
    <rdfs:range rdf:resource="http://example.com/ontology/sales#Geography"/>
    <owl:inverseOf rdf:resource="http://example.com/ontology/sales#isGeographyOfBooking"/>
    <rdfs:label>has geography</rdfs:label>
    <rdfs:comment>Relates a booking transaction to the geography dimension record associated with the booking.</rdfs:comment>
    <ex:sourceRelationship>bookings_to_geographies</ex:sourceRelationship>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.com/ontology/sales#isGeographyOfBooking">
    <rdfs:domain rdf:resource="http://example.com/ontology/sales#Geography"/>
    <rdfs:range rdf:resource="http://example.com/ontology/sales#Booking"/>
    <rdfs:label>is geography of booking</rdfs:label>
    <rdfs:comment>Inverse relation from geography to bookings associated with that geography.</rdfs:comment>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.com/ontology/sales#hasSalesRepresentative">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://example.com/ontology/sales#Booking"/>
    <rdfs:range rdf:resource="http://example.com/ontology/sales#SalesRepresentative"/>
    <owl:inverseOf rdf:resource="http://example.com/ontology/sales#isSalesRepresentativeOfBooking"/>
    <rdfs:label>has sales representative</rdfs:label>
    <rdfs:comment>Relates a booking transaction to the sales representative dimension record associated with the booking.</rdfs:comment>
    <ex:sourceRelationship>bookings_to_sales_representatives</ex:sourceRelationship>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.com/ontology/sales#isSalesRepresentativeOfBooking">
    <rdfs:domain rdf:resource="http://example.com/ontology/sales#SalesRepresentative"/>
    <rdfs:range rdf:resource="http://example.com/ontology/sales#Booking"/>
    <rdfs:label>is sales representative of booking</rdfs:label>
    <rdfs:comment>Inverse relation from sales representative to bookings associated with that sales representative.</rdfs:comment>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.com/ontology/sales#hasContract">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://example.com/ontology/sales#Booking"/>
    <rdfs:range rdf:resource="http://example.com/ontology/sales#Contract"/>
    <owl:inverseOf rdf:resource="http://example.com/ontology/sales#isContractOfBooking"/>
    <rdfs:label>has contract</rdfs:label>
    <rdfs:comment>Relates a booking transaction to the contract dimension record associated with the booking.</rdfs:comment>
    <ex:sourceRelationship>bookings_to_contracts</ex:sourceRelationship>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.com/ontology/sales#isContractOfBooking">
    <rdfs:domain rdf:resource="http://example.com/ontology/sales#Contract"/>
    <rdfs:range rdf:resource="http://example.com/ontology/sales#Booking"/>
    <rdfs:label>is contract of booking</rdfs:label>
    <rdfs:comment>Inverse relation from contract to bookings associated with that contract.</rdfs:comment>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.com/ontology/sales#hasBookingDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://example.com/ontology/sales#Booking"/>
    <rdfs:range rdf:resource="http://example.com/ontology/sales#DateDimension"/>
    <owl:inverseOf rdf:resource="http://example.com/ontology/sales#isBookingDateOf"/>
    <rdfs:label>has booking date</rdfs:label>
    <rdfs:comment>Relates a booking transaction to the reporting date dimension record associated with the booking.</rdfs:comment>
    <ex:sourceRelationship>bookings_to_dates</ex:sourceRelationship>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.com/ontology/sales#isBookingDateOf">
    <rdfs:domain rdf:resource="http://example.com/ontology/sales#DateDimension"/>
    <rdfs:range rdf:resource="http://example.com/ontology/sales#Booking"/>
    <rdfs:label>is booking date of</rdfs:label>
    <rdfs:comment>Inverse relation from date dimension to bookings associated with that reporting date.</rdfs:comment>
  </owl:ObjectProperty>

  <owl:DatatypeProperty rdf:about="http://example.com/ontology/sales#bookingId">
    <rdfs:domain rdf:resource="http://example.com/ontology/sales#Booking"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>booking id</rdfs:label>
    <rdfs:comment>Unique identifier for an individual booking transaction record.</rdfs:comment>
    <ex:sourceTable>quotetobooking.fact_bookings</ex:sourceTable>
    <ex:sourceColumn>booking_id</ex:sourceColumn>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://example.com/ontology/sales#orderNumber">
    <rdfs:domain rdf:resource="http://example.com/ontology/sales#Booking"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>order number</rdfs:label>
    <rdfs:comment>Sales order number associated with the booking transaction.</rdfs:comment>
    <ex:sourceTable>quotetobooking.fact_bookings</ex:sourceTable>
    <ex:sourceColumn>order_number</ex:sourceColumn>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://example.com/ontology/sales#orderLineNumber">
    <rdfs:domain rdf:resource="http://example.com/ontology/sales#Booking"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label>order line number</rdfs:label>
    <rdfs:comment>Line number within the sales order representing the booked item or service.</rdfs:comment>
