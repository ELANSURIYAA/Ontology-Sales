<?xml version="1.0"?>
<rdf:RDF xmlns="http://example.com/ontology/quote-to-booking#"
     xml:base="http://example.com/ontology/quote-to-booking"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#">

  <owl:Ontology rdf:about="http://example.com/ontology/quote-to-booking">
    <rdfs:label>Enterprise Sales Quote to Booking Ontology</rdfs:label>
    <rdfs:comment>OWL 2 ontology generated from the OSI Semantic Model for Sales Bookings and Revenue Analytics. The business process document could not be decoded from the repository, so business rules and contextual enrichments are limited to semantics explicitly present in the OSI Semantic Model. Validation warnings: business process document unreadable; no duplicate entities detected; required entities, attributes, measures, and foreign key relationships are present in the semantic model.</rdfs:comment>
    <owl:versionInfo>1.0.0</owl:versionInfo>
  </owl:Ontology>

  <owl:Class rdf:about="#BusinessEntity">
    <rdfs:label>Business Entity</rdfs:label>
    <rdfs:comment>Top-level class for business entities represented in the sales bookings semantic model.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#Attribute">
    <rdfs:label>Attribute</rdfs:label>
    <rdfs:comment>Metadata class representing a business attribute, identifier, date field, status value, or numeric field.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#Measure">
    <rdfs:label>Measure</rdfs:label>
    <rdfs:comment>Metadata class representing a quantitative business measure defined in the semantic model.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#BusinessRule">
    <rdfs:label>Business Rule</rdfs:label>
    <rdfs:comment>Metadata class representing business rules captured from the semantic model and available documentation.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#GlossaryTerm">
    <rdfs:label>Glossary Term</rdfs:label>
    <rdfs:comment>Metadata class representing business terminology and definitions for semantic exploration.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#Contract">
    <rdfs:subClassOf rdf:resource="#BusinessEntity"/>
    <rdfs:label>Contract</rdfs:label>
    <rdfs:comment>Stores the business attributes of commercial agreements associated with bookings, including contract type, term, renewal behavior, and support coverage level.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#Customer">
    <rdfs:subClassOf rdf:resource="#BusinessEntity"/>
    <rdfs:label>Customer</rdfs:label>
    <rdfs:comment>Stores descriptive information about customers that place orders and generate bookings, including segment, industry, account tier, and headquarters location.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#Date">
    <rdfs:subClassOf rdf:resource="#BusinessEntity"/>
    <rdfs:label>Date</rdfs:label>
    <rdfs:comment>Stores calendar and fiscal date attributes used to analyze bookings over time.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#Geography">
    <rdfs:subClassOf rdf:resource="#BusinessEntity"/>
    <rdfs:label>Geography</rdfs:label>
    <rdfs:comment>Stores geographic attributes used to analyze bookings by sales region, theater, and country.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#Partner">
    <rdfs:subClassOf rdf:resource="#BusinessEntity"/>
    <rdfs:label>Partner</rdfs:label>
    <rdfs:comment>Stores information about channel and direct partners involved in the sales process, including partner type, partner tier, and route to market.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#Product">
    <rdfs:subClassOf rdf:resource="#BusinessEntity"/>
    <rdfs:label>Product</rdfs:label>
    <rdfs:comment>Stores descriptive information about products and offers sold to customers, including product family, technology domain, offer type, and business entity.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#SalesRepresentative">
    <rdfs:subClassOf rdf:resource="#BusinessEntity"/>
    <rdfs:label>Sales Representative</rdfs:label>
    <rdfs:comment>Stores information about sales personnel responsible for managing customer relationships and booking transactions.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#BookingTransaction">
    <rdfs:subClassOf rdf:resource="#BusinessEntity"/>
    <rdfs:label>Booking Transaction</rdfs:label>
    <rdfs:comment>Stores individual completed sales booking transactions with related financial measures and links to customer, product, partner, geography, sales representative, contract, and date dimensions.</rdfs:comment>
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="#BusinessEntity"/>
          <owl:Restriction>
            <owl:onProperty rdf:resource="#hasCustomer"/>
            <owl:someValuesFrom rdf:resource="#Customer"/>
          </owl:Restriction>
          <owl:Restriction>
            <owl:onProperty rdf:resource="#hasProduct"/>
            <owl:someValuesFrom rdf:resource="#Product"/>
          </owl:Restriction>
          <owl:Restriction>
            <owl:onProperty rdf:resource="#hasDate"/>
            <owl:someValuesFrom rdf:resource="#Date"/>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="#hasCustomer"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onClass rdf:resource="#Customer"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="#hasProduct"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onClass rdf:resource="#Product"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="#hasDate"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onClass rdf:resource="#Date"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="#hasContract"/>
        <owl:allValuesFrom rdf:resource="#Contract"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="#hasPartner"/>
        <owl:allValuesFrom rdf:resource="#Partner"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="#hasGeography"/>
        <owl:allValuesFrom rdf:resource="#Geography"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="#hasSalesRepresentative"/>
        <owl:allValuesFrom rdf:resource="#SalesRepresentative"/>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>

  <owl:AllDisjointClasses>
    <owl:members rdf:parseType="Collection">
      <rdf:Description rdf:about="#Contract"/>
      <rdf:Description rdf:about="#Customer"/>
      <rdf:Description rdf:about="#Date"/>
      <rdf:Description rdf:about="#Geography"/>
      <rdf:Description rdf:about="#Partner"/>
      <rdf:Description rdf:about="#Product"/>
      <rdf:Description rdf:about="#SalesRepresentative"/>
      <rdf:Description rdf:about="#BookingTransaction"/>
    </owl:members>
  </owl:AllDisjointClasses>

  <owl:ObjectProperty rdf:about="#hasContract">
    <rdfs:label>has contract</rdfs:label>
    <rdfs:comment>Relates a booking transaction to its associated contract.</rdfs:comment>
    <rdfs:domain rdf:resource="#BookingTransaction"/>
    <rdfs:range rdf:resource="#Contract"/>
    <owl:inverseOf rdf:resource="#isContractOf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#isContractOf">
    <rdfs:label>is contract of</rdfs:label>
    <rdfs:comment>Inverse of has contract.</rdfs:comment>
    <rdfs:domain rdf:resource="#Contract"/>
    <rdfs:range rdf:resource="#BookingTransaction"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#hasCustomer">
    <rdfs:label>has customer</rdfs:label>
    <rdfs:comment>Relates a booking transaction to the customer that placed the order.</rdfs:comment>
    <rdfs:domain rdf:resource="#BookingTransaction"/>
    <rdfs:range rdf:resource="#Customer"/>
    <owl:inverseOf rdf:resource="#isCustomerOfBooking"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#isCustomerOfBooking">
    <rdfs:label>is customer of booking</rdfs:label>
    <rdfs:comment>Inverse of has customer.</rdfs:comment>
    <rdfs:domain rdf:resource="#Customer"/>
    <rdfs:range rdf:resource="#BookingTransaction"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#hasDate">
    <rdfs:label>has date</rdfs:label>
    <rdfs:comment>Relates a booking transaction to its reporting date.</rdfs:comment>
    <rdfs:domain rdf:resource="#BookingTransaction"/>
    <rdfs:range rdf:resource="#Date"/>
    <owl:inverseOf rdf:resource="#isDateOfBooking"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#isDateOfBooking">
    <rdfs:label>is date of booking</rdfs:label>
    <rdfs:comment>Inverse of has date.</rdfs:comment>
    <rdfs:domain rdf:resource="#Date"/>
    <rdfs:range rdf:resource="#BookingTransaction"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#hasGeography">
    <rdfs:label>has geography</rdfs:label>
    <rdfs:comment>Relates a booking transaction to the geography used for reporting.</rdfs:comment>
    <rdfs:domain rdf:resource="#BookingTransaction"/>
    <rdfs:range rdf:resource="#Geography"/>
    <owl:inverseOf rdf:resource="#isGeographyOfBooking"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#isGeographyOfBooking">
    <rdfs:label>is geography of booking</rdfs:label>
    <rdfs:comment>Inverse of has geography.</rdfs:comment>
    <rdfs:domain rdf:resource="#Geography"/>
    <rdfs:range rdf:resource="#BookingTransaction"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#hasPartner">
    <rdfs:label>has partner</rdfs:label>
    <rdfs:comment>Relates a booking transaction to the partner involved in the transaction.</rdfs:comment>
    <rdfs:domain rdf:resource="#BookingTransaction"/>
    <rdfs:range rdf:resource="#Partner"/>
    <owl:inverseOf rdf:resource="#isPartnerOfBooking"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#isPartnerOfBooking">
    <rdfs:label>is partner of booking</rdfs:label>
    <rdfs:comment>Inverse of has partner.</rdfs:comment>
    <rdfs:domain rdf:resource="#Partner"/>
    <rdfs:range rdf:resource="#BookingTransaction"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#hasProduct">
    <rdfs:label>has product</rdfs:label>
    <rdfs:comment>Relates a booking transaction to the product sold.</rdfs:comment>
    <rdfs:domain rdf:resource="#BookingTransaction"/>
    <rdfs:range rdf:resource="#Product"/>
    <owl:inverseOf rdf:resource="#isProductOfBooking"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#isProductOfBooking">
    <rdfs:label>is product of booking</rdfs:label>
    <rdfs:comment>Inverse of has product.</rdfs:comment>
    <rdfs:domain rdf:resource="#Product"/>
    <rdfs:range rdf:resource="#BookingTransaction"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#hasSalesRepresentative">
    <rdfs:label>has sales representative</rdfs:label>
    <rdfs:comment>Relates a booking transaction to the sales representative responsible for the booking.</rdfs:comment>
    <rdfs:domain rdf:resource="#BookingTransaction"/>
    <rdfs:range rdf:resource="#SalesRepresentative"/>
    <owl:inverseOf rdf:resource="#isSalesRepresentativeOfBooking"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#isSalesRepresentativeOfBooking">
    <rdfs:label>is sales representative of booking</rdfs:label>
    <rdfs:comment>Inverse of has sales representative.</rdfs:comment>
    <rdfs:domain rdf:resource="#SalesRepresentative"/>
    <rdfs:range rdf:resource="#BookingTransaction"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#hasAttribute">
    <rdfs:label>has attribute</rdfs:label>
    <rdfs:comment>Connects a business entity to attribute metadata individuals representing its business fields.</rdfs:comment>
    <rdfs:domain rdf:resource="#BusinessEntity"/>
    <rdfs:range rdf:resource="#Attribute"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#hasMeasure">
    <rdfs:label>has measure</rdfs:label>
    <rdfs:comment>Connects a business entity to measure metadata individuals.</rdfs:comment>
    <rdfs:domain rdf:resource="#BusinessEntity"/>
    <rdfs:range rdf:resource="#Measure"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#hasBusinessRule">
    <rdfs:label>has business rule</rdfs:label>
    <rdfs:comment>Connects a business entity to business rule metadata individuals.</rdfs:comment>
    <rdfs:domain rdf:resource="#BusinessEntity"/>
    <rdfs:range rdf:resource="#BusinessRule"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#hasGlossaryTerm">
    <rdfs:label>has glossary term</rdfs:label>
    <rdfs:comment>Connects a business entity to glossary term metadata individuals.</rdfs:comment>
    <rdfs:domain rdf:resource="#BusinessEntity"/>
    <rdfs:range rdf:resource="#GlossaryTerm"/>
  </owl:ObjectProperty>

  <owl:DatatypeProperty rdf:about="#sourceTable">
    <rdfs:label>source table</rdfs:label>
    <rdfs:comment>Technical source table from the semantic model.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#sourceColumn">
    <rdfs:label>source column</rdfs:label>
    <rdfs:comment>Technical source column from the semantic model.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#businessDefinition">
    <rdfs:label>business definition</rdfs:label>
    <rdfs:comment>Business definition carried from the semantic model.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#semanticDefinition">
    <rdfs:label>semantic definition</rdfs:label>
    <rdfs:comment>Semantic definition used in the metadata layer for browsing and exploration.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#dataType">
    <rdfs:label>data type</rdfs:label>
    <rdfs:comment>Declared source-system data type of an attribute or measure metadata individual.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#sourceEntity">
    <rdfs:label>source entity</rdfs:label>
    <rdfs:comment>Business entity from which the metadata individual originates.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#aggregationType">
    <rdfs:label>aggregation type</rdfs:label>
    <rdfs:comment>Aggregation behavior associated with a business measure.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#contractKey">
    <rdfs:label>Contract Key</rdfs:label>
    <rdfs:comment>Surrogate key that uniquely identifies a contract record in the contract dimension.</rdfs:comment>
    <rdfs:domain rdf:resource="#Contract"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <sourceTable>QuoteToBooking.dim_contract</sourceTable>
    <sourceColumn>contract_key</sourceColumn>
    <businessDefinition>Surrogate key that uniquely identifies a contract record in the contract dimension.</businessDefinition>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#contractType">
    <rdfs:label>Contract Type</rdfs:label>
    <rdfs:comment>Describes the type of commercial agreement attached to the booking, such as SaaS subscription, Enterprise Agreement, or support contract.</rdfs:comment>
    <rdfs:domain rdf:resource="#Contract"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <sourceTable>QuoteToBooking.dim_contract</sourceTable>
    <sourceColumn>contract_type</sourceColumn>
    <businessDefinition>Describes the type of commercial agreement attached to the booking, such as SaaS subscription, Enterprise Agreement, or support contract.</businessDefinition>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#termMonths">
    <rdfs:label>Contract Term Months</rdfs:label>
    <rdfs:comment>Indicates the duration of the contract in months.</rdfs:comment>
    <rdfs:domain rdf:resource="#Contract"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <sourceTable>QuoteToBooking.dim_contract</sourceTable>
    <sourceColumn>term_months</sourceColumn>
    <businessDefinition>Indicates the duration of the contract in months.</businessDefinition>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#autoRenewFlag">
    <rdfs:label>Auto Renew Flag</rdfs:label>
    <rdfs:comment>Indicates whether the contract is set to renew automatically at the end of its term.</rdfs:comment>
    <rdfs:domain rdf:resource="#Contract"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <sourceTable>QuoteToBooking.dim_contract</sourceTable>
    <sourceColumn>auto_renew_flag</sourceColumn>
    <businessDefinition>Indicates whether the contract is set to renew automatically at the end of its term.</businessDefinition>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#coverageLevel">
    <rdfs:label>Coverage Level</rdfs:label>
    <rdfs:comment>Describes the level of service or support coverage provided under the contract.</rdfs:comment>
    <rdfs:domain rdf:resource="#Contract"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <sourceTable>QuoteToBooking.dim_contract</sourceTable>
    <sourceColumn>coverage_level</sourceColumn>
    <businessDefinition>Describes the level of service or support coverage provided under the contract.</businessDefinition>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#customerKey">
    <rdfs:label>Customer Key</rdfs:label>
    <rdfs:comment>Surrogate key that uniquely identifies a customer record in the customer dimension.</rdfs:comment>
    <rdfs:domain rdf:resource="#Customer"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <sourceTable>QuoteToBooking.dim_customer</sourceTable>
    <sourceColumn>customer_key</sourceColumn>
    <businessDefinition>Surrogate key that uniquely identifies a customer record in the customer dimension.</businessDefinition>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#customerId">
    <rdfs:label>Customer ID</rdfs:label>
    <rdfs:comment>Business identifier assigned to the customer account.</rdfs:comment>
    <rdfs:domain rdf:resource="#Customer"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <sourceTable>QuoteToBooking.dim_customer</sourceTable>
    <sourceColumn>customer_id</sourceColumn>
    <businessDefinition>Business identifier assigned to the customer account.</businessDefinition>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#customerName">
    <rdfs:label>Customer Name</rdfs:label>
    <rdfs:comment>Official name of the customer organization that purchased products or services.</rdfs:comment>
    <rdfs:domain rdf:resource="#Customer"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <sourceTable>QuoteToBooking.dim_customer</sourceTable>
    <sourceColumn>customer_name</sourceColumn>
    <businessDefinition>Official name of the customer organization that purchased products or services.</businessDefinition>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#segment">
    <rdfs:label>Customer Segment</rdfs:label>
    <rdfs:comment>Classifies the customer into a business segment such as Enterprise, Service Provider, or Public Sector.</rdfs:comment>
    <rdfs:domain rdf:resource="#Customer"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <sourceTable>QuoteToBooking.dim_customer</sourceTable>
    <sourceColumn>segment</sourceColumn>
    <businessDefinition>Classifies the customer into a business segment such as Enterprise, Service Provider, or Public Sector.</businessDefinition>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#industry">
    <rdfs:label>Industry</rdfs:label>
    <rdfs:comment>Identifies the industry in which the customer operates.</rdfs:comment>
    <rdfs:domain rdf:resource="#Customer"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <sourceTable>QuoteToBooking.dim_customer</sourceTable>
    <sourceColumn>industry</sourceColumn>
    <businessDefinition>Identifies the industry in which the customer operates.</businessDefinition>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#accountTier">
    <rdfs:label>Account Tier</rdfs:label>
    <rdfs:comment>Indicates the strategic importance or service tier of the customer account.</rdfs:comment>
    <rdfs:domain rdf:resource="#Customer"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <sourceTable>QuoteToBooking.dim_customer</sourceTable>
    <sourceColumn>account_tier</sourceColumn>
    <businessDefinition>Indicates the strategic importance or service tier of the customer account.</businessDefinition>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#hqCountry">
    <rdfs:label>Headquarters Country</rdfs:label>
    <rdfs:comment>Country where the customer organization's headquarters is located.</rdfs:comment>
    <rdfs:domain rdf:resource="#Customer"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <sourceTable>QuoteToBooking.dim_customer</sourceTable>
    <sourceColumn>hq_country</sourceColumn>
    <businessDefinition>Country where the customer organization's headquarters is located.</businessDefinition>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#hqRegion">
    <rdfs:label>Headquarters Region</rdfs:label>
    <rdfs:comment>Global region where the customer organization's headquarters is located.</rdfs:comment>
    <rdfs:domain rdf:resource="#Customer"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <sourceTable>QuoteToBooking.dim_customer</sourceTable>
    <sourceColumn>hq_region</sourceColumn>
    <businessDefinition>Global region where the customer organization's headquarters is located.</businessDefinition>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#dateKey">
    <rdfs:label>Date Key</rdfs:label>
    <rdfs:comment>Encoded key that uniquely identifies a reporting date in the date dimension.</rdfs:comment>
    <rdfs:domain rdf:resource="#Date"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <sourceTable>QuoteToBooking.dim_date</sourceTable>
    <sourceColumn>date_key</sourceColumn>
    <businessDefinition>Encoded key that uniquely identifies a reporting date in the date dimension.</businessDefinition>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#fullDate">
    <rdfs:label>Full Date</rdfs:label>
    <rdfs:comment>Actual calendar date represented by the date record.</rdfs:comment>
    <rdfs:domain rdf:resource="#Date"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <sourceTable>QuoteToBooking.dim_date</sourceTable>
    <sourceColumn>full_date</sourceColumn>
    <businessDefinition>Actual calendar date represented by the date record.</businessDefinition>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#monthName">
    <rdfs:label>Month Name</rdfs:label>
    <rdfs:comment>Name of the calendar month for the date.</rdfs:comment>
    <rdfs:domain rdf:resource="#Date"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <sourceTable>QuoteToBooking.dim_date</sourceTable>
    <sourceColumn>month_name</sourceColumn>
    <businessDefinition>Name of the calendar month for the date.</businessDefinition>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#calendarYear">
    <rdfs:label>Calendar Year</rdfs:label>
    <rdfs:comment>Four-digit calendar year associated with the date.</rdfs:comment>
