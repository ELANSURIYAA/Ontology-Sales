    <rdfs:comment>Number of months covered by the contract term.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology/sales#Contract"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <sales:businessDefinition>Number of months covered by the contract term.</sales:businessDefinition>
