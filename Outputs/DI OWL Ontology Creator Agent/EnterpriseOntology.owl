  <owl:Class rdf:about="http://example.org/ontology/enterprise-sales#BookingTransaction">
    <rdfs:label>Booking Transaction</rdfs:label>
    <rdfs:comment>Captures individual completed sales booking transactions and their associated financial measures, quantities, renewal status, and links to related business dimensions.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/ontology/enterprise-sales#Fact"/>
    <rdfs:subClassOf rdf:resource="http://example.org/ontology/enterprise-sales#Transaction"/>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://example.org/ontology/enterprise-sales#hasCustomer"/>
        <owl:someValuesFrom rdf:resource="http://example.org/ontology/enterprise-sales#Customer"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://example.org/ontology/enterprise-sales#hasProduct"/>
        <owl:someValuesFrom rdf:resource="http://example.org/ontology/enterprise-sales#Product"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://example.org/ontology/enterprise-sales#hasDate"/>
        <owl:someValuesFrom rdf:resource="http://example.org/ontology/enterprise-sales#Date"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <eo:businessDefinition>Captures individual completed sales booking transactions and their associated financial measures, quantities, renewal status, and links to related business dimensions.</eo:businessDefinition>
    <eo:businessDomain>Sales Bookings and Revenue Analytics</eo:businessDomain>
    <eo:businessCategory>Sales Performance</eo:businessCategory>
    <eo:sourceGlossary>Outputs/DI Glossary Creator Agent/business_glossary_data_dictionary.md</eo:sourceGlossary>
    <eo:sourceTable>quotetobooking.fact_bookings</eo:sourceTable>
    <eo:metricDefinition>booking_amount_usd: Total booked sales amount in US dollars after pricing and discount adjustments.</eo:metricDefinition>
    <eo:metricDefinition>acv_usd: Annualized contract value of the booking in US dollars.</eo:metricDefinition>
    <eo:metricDefinition>tcv_usd: Total contract value of the booking over the full contract term in US dollars.</eo:metricDefinition>
    <eo:validationWarning>Business Process, Metrics &amp; Relationships document was not available at the specified path; process-derived relationships, rules, and cardinalities could not be validated cross-source.</eo:validationWarning>
  </owl:Class>

