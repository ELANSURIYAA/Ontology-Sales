    <sales:sourceRelationship>fact_bookings.product_key -&gt; dim_product.product_key</sales:sourceRelationship>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.org/ontology/sales#isProductForBooking">
    <rdfs:label>is product for booking</rdfs:label>
    <rdfs:comment>Inverse relationship from product to booking.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology/sales#Product"/>
    <rdfs:range rdf:resource="http://example.org/ontology/sales#Booking"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.org/ontology/sales#hasDate">
    <rdfs:label>has date</rdfs:label>
    <rdfs:comment>Associates a booking with the date dimension referenced by the date key.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology/sales#Booking"/>
