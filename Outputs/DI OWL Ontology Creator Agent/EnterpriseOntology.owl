    <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales-bookings#bookingTransactionProductKey"><rdfs:label>product key on booking transaction</rdfs:label><rdfs:comment>Foreign key linking the booking transaction to the product dimension.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings#BookingTransaction"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/><ex:sourceTable>QuoteToBooking.fact_bookings</ex:sourceTable><ex:sourceColumn>product_key</ex:sourceColumn></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales-bookings#bookingTransactionPartnerKey"><rdfs:label>partner key on booking transaction</rdfs:label><rdfs:comment>Foreign key linking the booking transaction to the partner dimension.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings#BookingTransaction"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/><ex:sourceTable>QuoteToBooking.fact_bookings</ex:sourceTable><ex:sourceColumn>partner_key</ex:sourceColumn></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales-bookings#bookingTransactionGeographyKey"><rdfs:label>geography key on booking transaction</rdfs:label><rdfs:comment>Foreign key linking the booking transaction to the geography dimension.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings#BookingTransaction"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/><ex:sourceTable>QuoteToBooking.fact_bookings</ex:sourceTable><ex:sourceColumn>geography_key</ex:sourceColumn></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://example.org/ontology/sales-bookings#bookingTransactionSalesRepresentativeKey"><rdfs:label>sales representative key on booking transaction</rdfs:label><rdfs:comment>Foreign key linking the booking transaction to the sales representative dimension.</rdfs:comment><rdfs:domain rdf:resource="http://example.org/ontology/sales-bookings#BookingTransaction"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/><ex:sourceTable>QuoteToBooking.fact_bookings</ex:sourceTable><ex:sourceColumn>sales_rep_key</ex:sourceColumn></owl:DatatypeProperty>
