    <owl:Ontology rdf:about="http://example.com/ontology/sales-bookings">
        <rdfs:label xml:lang="en">Sales Bookings and Revenue Analytics Enterprise Ontology</rdfs:label>
        <rdfs:comment xml:lang="en">OWL 2 ontology generated from the OSI Semantic Model for the Sales Bookings and Revenue Analytics domain. The business process document could not be read from the source repository, so ontology semantics, comments, and constraints are derived from the validated OSI Semantic Model only. This ontology is TBox-only and optimized for GraphDB and Protégé import.</rdfs:comment>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <oboInOwl:hasDbXref>Source Semantic Model: Outputs/DI OSI Semantic Creator Agent/OSI Semantic Model.md</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Source Business Process Document: Inputs/QuoteToBooking.docx (readability validation failed: binary DOCX could not be decoded as UTF-8)</oboInOwl:hasDbXref>
        <skos:definition>This ontology represents completed sales booking transactions and their analytical dimensions across customers, products, partners, geographies, sales representatives, contracts, and reporting dates.</skos:definition>
    </owl:Ontology>

