<?xml version="1.0"?>
<rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
    xmlns:skos="http://www.w3.org/2004/02/skos/core#"
    xmlns:oboInOwl="http://www.geneontology.org/formats/oboInOwl#"
    xmlns:dc="http://purl.org/dc/elements/1.1/"
    xmlns:dcterms="http://purl.org/dc/terms/"
    xmlns:ex="http://example.org/ontology/sales#">

  <owl:Ontology rdf:about="http://example.org/ontology/sales">
    <rdfs:label>Enterprise Sales Ontology</rdfs:label>
    <rdfs:comment>OWL 2 ontology generated from the DI Glossary Creator Agent output for the quote-to-booking sales domain. The Business Process, Metrics &amp; Relationships document could not be retrieved from the repository path provided, so the ontology is generated from the authoritative glossary input with validation warnings preserved as annotations.</rdfs:comment>
    <owl:versionInfo>1.0.0</owl:versionInfo>
    <dc:source>Outputs/DI Glossary Creator Agent/business_glossary_data_dictionary.md</dc:source>
    <dc:source>Inputs/Business Process Metrics Relationships.docx</dc:source>
    <dcterms:created>2026-08-24</dcterms:created>
    <dcterms:title>EnterpriseOntology.owl</dcterms:title>
    <dcterms:description>GraphDB-compatible ontology for sales booking analytics with traceability to glossary metadata and documented validation warning for missing process input.</dcterms:description>
    <oboInOwl:hasExactSynonym>Quote-to-Booking Sales Ontology</oboInOwl:hasExactSynonym>
    <skos:note>Validation warning: Business Process, Metrics &amp; Relationships document was not accessible at Inputs/Business Process Metrics Relationships.docx and therefore cross-source validation, process enrichment, relationship cardinalities, and process-derived rules are limited to what can be logically derived from the glossary.</skos:note>
  </owl:Ontology>

  <owl:AnnotationProperty rdf:about="http://example.org/ontology/sales#businessDefinition"/>
  <owl:AnnotationProperty rdf:about="http://example.org/ontology/sales#businessDescription"/>
  <owl:AnnotationProperty rdf:about="http://example.org/ontology/sales#businessDomain"/>
  <owl:AnnotationProperty rdf:about="http://example.org/ontology/sales#sourceGlossary"/>
