    <owl:DatatypeProperty rdf:about="http://example.com/ontology/enterprise-sales-bookings#fiscalYear"><rdfs:label>Fiscal Year</rdfs:label><rdfs:comment>Fiscal year used by the business for financial and performance reporting.</rdfs:comment><rdfs:domain rdf:resource="http://example.com/ontology/enterprise-sales-bookings#Date"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/><sourceTable>QuoteToBooking.dim_date</sourceTable><sourceColumn>fiscal_year</sourceColumn><businessDefinition>Fiscal year used by the business for financial and performance reporting.</businessDefinition></owl:DatatypeProperty>
