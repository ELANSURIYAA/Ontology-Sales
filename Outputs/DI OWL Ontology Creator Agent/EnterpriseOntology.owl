        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.com/ontology/enterprise-sales-bookings#hasBookingDate"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://example.com/ontology/enterprise-sales-bookings#Date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.com/ontology/enterprise-sales-bookings#hasCustomer"/>
                <owl:allValuesFrom rdf:resource="http://example.com/ontology/enterprise-sales-bookings#Customer"/>
