    <owl:ObjectProperty rdf:about="http://example.com/ontology/quotetobooking#hasContractDimension">
        <rdfs:label>has contract dimension</rdfs:label>
        <rdfs:comment>Associates a booking transaction with the contract or commercial agreement used to classify it.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/quotetobooking#BookingFact"/>
        <rdfs:range rdf:resource="http://example.com/ontology/quotetobooking#ContractDimension"/>
        <owl:inverseOf rdf:resource="http://example.com/ontology/quotetobooking#isContractDimensionOf"/>
        <qb:sourceRelationship>REL001</qb:sourceRelationship>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.com/ontology/quotetobooking#isContractDimensionOf">
        <rdfs:label>is contract dimension of</rdfs:label>
        <rdfs:comment>Inverse relation indicating the bookings classified by a contract dimension record.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/quotetobooking#ContractDimension"/>
        <rdfs:range rdf:resource="http://example.com/ontology/quotetobooking#BookingFact"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.com/ontology/quotetobooking#hasCustomerDimension">
        <rdfs:label>has customer dimension</rdfs:label>
        <rdfs:comment>Associates a booking transaction with the customer that placed the order.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/quotetobooking#BookingFact"/>
        <rdfs:range rdf:resource="http://example.com/ontology/quotetobooking#CustomerDimension"/>
        <owl:inverseOf rdf:resource="http://example.com/ontology/quotetobooking#isCustomerDimensionOf"/>
        <qb:sourceRelationship>REL002</qb:sourceRelationship>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.com/ontology/quotetobooking#isCustomerDimensionOf">
        <rdfs:label>is customer dimension of</rdfs:label>
        <rdfs:comment>Inverse relation indicating the bookings associated with a customer dimension record.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/quotetobooking#CustomerDimension"/>
        <rdfs:range rdf:resource="http://example.com/ontology/quotetobooking#BookingFact"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.com/ontology/quotetobooking#hasDateDimension">
        <rdfs:label>has date dimension</rdfs:label>
        <rdfs:comment>Associates a booking transaction with the reporting date on which it was recorded.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/quotetobooking#BookingFact"/>
        <rdfs:range rdf:resource="http://example.com/ontology/quotetobooking#DateDimension"/>
        <owl:inverseOf rdf:resource="http://example.com/ontology/quotetobooking#isDateDimensionOf"/>
        <qb:sourceRelationship>REL003</qb:sourceRelationship>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.com/ontology/quotetobooking#isDateDimensionOf">
        <rdfs:label>is date dimension of</rdfs:label>
        <rdfs:comment>Inverse relation indicating the bookings associated with a date dimension record.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/quotetobooking#DateDimension"/>
        <rdfs:range rdf:resource="http://example.com/ontology/quotetobooking#BookingFact"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.com/ontology/quotetobooking#hasGeographyDimension">
        <rdfs:label>has geography dimension</rdfs:label>
        <rdfs:comment>Associates a booking transaction with the geography used for regional analysis.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/quotetobooking#BookingFact"/>
        <rdfs:range rdf:resource="http://example.com/ontology/quotetobooking#GeographyDimension"/>
        <owl:inverseOf rdf:resource="http://example.com/ontology/quotetobooking#isGeographyDimensionOf"/>
        <qb:sourceRelationship>REL004</qb:sourceRelationship>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.com/ontology/quotetobooking#isGeographyDimensionOf">
        <rdfs:label>is geography dimension of</rdfs:label>
        <rdfs:comment>Inverse relation indicating the bookings associated with a geography dimension record.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/quotetobooking#GeographyDimension"/>
        <rdfs:range rdf:resource="http://example.com/ontology/quotetobooking#BookingFact"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.com/ontology/quotetobooking#hasPartnerDimension">
        <rdfs:label>has partner dimension</rdfs:label>
        <rdfs:comment>Associates a booking transaction with the partner involved in fulfillment or transaction routing.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/quotetobooking#BookingFact"/>
        <rdfs:range rdf:resource="http://example.com/ontology/quotetobooking#PartnerDimension"/>
        <owl:inverseOf rdf:resource="http://example.com/ontology/quotetobooking#isPartnerDimensionOf"/>
        <qb:sourceRelationship>REL005</qb:sourceRelationship>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.com/ontology/quotetobooking#isPartnerDimensionOf">
        <rdfs:label>is partner dimension of</rdfs:label>
        <rdfs:comment>Inverse relation indicating the bookings associated with a partner dimension record.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/quotetobooking#PartnerDimension"/>
        <rdfs:range rdf:resource="http://example.com/ontology/quotetobooking#BookingFact"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.com/ontology/quotetobooking#hasProductDimension">
        <rdfs:label>has product dimension</rdfs:label>
        <rdfs:comment>Associates a booking transaction with the product or offer being booked.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/quotetobooking#BookingFact"/>
        <rdfs:range rdf:resource="http://example.com/ontology/quotetobooking#ProductDimension"/>
        <owl:inverseOf rdf:resource="http://example.com/ontology/quotetobooking#isProductDimensionOf"/>
        <qb:sourceRelationship>REL006</qb:sourceRelationship>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.com/ontology/quotetobooking#isProductDimensionOf">
        <rdfs:label>is product dimension of</rdfs:label>
        <rdfs:comment>Inverse relation indicating the bookings associated with a product dimension record.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/quotetobooking#ProductDimension"/>
        <rdfs:range rdf:resource="http://example.com/ontology/quotetobooking#BookingFact"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.com/ontology/quotetobooking#hasSalesRepresentativeDimension">
        <rdfs:label>has sales representative dimension</rdfs:label>
        <rdfs:comment>Associates a booking transaction with the sales representative responsible for the booking.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/quotetobooking#BookingFact"/>
        <rdfs:range rdf:resource="http://example.com/ontology/quotetobooking#SalesRepresentativeDimension"/>
        <owl:inverseOf rdf:resource="http://example.com/ontology/quotetobooking#isSalesRepresentativeDimensionOf"/>
        <qb:sourceRelationship>REL007</qb:sourceRelationship>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.com/ontology/quotetobooking#isSalesRepresentativeDimensionOf">
        <rdfs:label>is sales representative dimension of</rdfs:label>
        <rdfs:comment>Inverse relation indicating the bookings associated with a sales representative dimension record.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/quotetobooking#SalesRepresentativeDimension"/>
        <rdfs:range rdf:resource="http://example.com/ontology/quotetobooking#BookingFact"/>
    </owl:ObjectProperty>

    <owl:DatatypeProperty rdf:about="http://example.com/ontology/quotetobooking#contractKey">
        <rdfs:label>contract key</rdfs:label>
        <rdfs:comment>Surrogate key that uniquely identifies a contract record in the contract dimension.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/quotetobooking#ContractDimension"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <qb:sourceTable>quotetobooking.dim_contract</qb:sourceTable>
        <qb:sourceColumn>contract_key</qb:sourceColumn>
        <qb:sourceAttribute>ATT001</qb:sourceAttribute>
    </owl:DatatypeProperty>
    <owl:FunctionalProperty rdf:about="http://example.com/ontology/quotetobooking#contractKey"/>

    <owl:DatatypeProperty rdf:about="http://example.com/ontology/quotetobooking#contractType">
        <rdfs:label>contract type</rdfs:label>
        <rdfs:comment>Type of commercial agreement associated with the booking, such as Enterprise Agreement, SaaS Subscription, or support contract.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/quotetobooking#ContractDimension"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <qb:sourceTable>quotetobooking.dim_contract</qb:sourceTable>
        <qb:sourceColumn>contract_type</qb:sourceColumn>
        <qb:sourceAttribute>ATT002</qb:sourceAttribute>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.com/ontology/quotetobooking#termMonths">
        <rdfs:label>contract term months</rdfs:label>
        <rdfs:comment>Number of months covered by the contract or service agreement.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/quotetobooking#ContractDimension"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <qb:sourceTable>quotetobooking.dim_contract</qb:sourceTable>
        <qb:sourceColumn>term_months</qb:sourceColumn>
        <qb:sourceAttribute>ATT003</qb:sourceAttribute>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.com/ontology/quotetobooking#autoRenewFlag">
        <rdfs:label>auto renew flag</rdfs:label>
        <rdfs:comment>Indicator showing whether the contract is configured to renew automatically.</rdfs:comment>
        <rdfs:domain rdf:resource="http://example.com/ontology/quotetobooking#ContractDimension"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <qb:sourceTable>quotetobooking.dim_contract</qb:sourceTable>
        <qb:sourceColumn>auto_renew_flag</qb:sourceColumn>
        <qb:sourceAttribute>ATT004</qb:sourceAttribute>
    </owl:DatatypeProperty>

