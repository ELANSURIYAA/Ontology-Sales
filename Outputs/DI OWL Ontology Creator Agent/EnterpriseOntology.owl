    <owl:NamedIndividual rdf:about="#booking_customer_key"><rdf:type rdf:resource="#Attribute"/><rdfs:label>Customer Key</rdfs:label><rdfs:comment>Foreign key linking the booking transaction to the customer dimension.</rdfs:comment></owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#booking_product_key"><rdf:type rdf:resource="#Attribute"/><rdfs:label>Product Key</rdfs:label><rdfs:comment>Foreign key linking the booking transaction to the product dimension.</rdfs:comment></owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#booking_partner_key"><rdf:type rdf:resource="#Attribute"/><rdfs:label>Partner Key</rdfs:label><rdfs:comment>Foreign key linking the booking transaction to the partner dimension.</rdfs:comment></owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#booking_geography_key"><rdf:type rdf:resource="#Attribute"/><rdfs:label>Geography Key</rdfs:label><rdfs:comment>Foreign key linking the booking transaction to the geography dimension.</rdfs:comment></owl:NamedIndividual>
