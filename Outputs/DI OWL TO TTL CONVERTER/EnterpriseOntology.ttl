@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix qb1: <http://example.com/ontology/quotetobooking#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.com/ontology/quotetobooking> a owl:Ontology ;
    rdfs:label "Enterprise Sales Quote-to-Booking Ontology"@en ;
    qb1:sourceBusinessProcessDocument "Inputs/QuoteToBooking.docx" ;
    qb1:sourceSemanticModel "Outputs/DI OSI Semantic Creator Agent/OSI Semantic Model.md" ;
    qb1:validationWarning "Business Process document readability validation failed: the provided .docx file could not be decoded by the reader tool using UTF-8. Ontology generation therefore uses the validated OSI Semantic Model as the authoritative source and preserves only directly inferable constraints.",
        "No duplicate entities were detected in the OSI Semantic Model.",
        "No duplicate relationships were detected in the OSI Semantic Model.",
        "No invalid semantic references were detected among the declared foreign key relationships." ;
    rdfs:comment "OWL 2 ontology generated from the OSI Semantic Model for the Quote-to-Booking sales domain. The business process document could not be parsed from the provided .docx input, so process-derived enrichments are limited and a validation warning applies. This ontology is designed as a GraphDB-compatible TBox model representing business entities as classes, business relationships as object properties, and business attributes and measures as datatype properties."@en ;
    owl:versionInfo "1.0.0" .

qb1:accountTier a owl:DatatypeProperty ;
    rdfs:label "account tier" ;
    qb1:sourceAttribute "ATT011" ;
    qb1:sourceColumn "account_tier" ;
    qb1:sourceTable "quotetobooking.dim_customer" ;
    rdfs:comment "Strategic importance or tier assigned to the customer account." ;
    rdfs:domain qb1:CustomerDimension ;
    rdfs:range xsd:string .

qb1:acvUSD a owl:DatatypeProperty ;
    rdfs:label "annual contract value USD" ;
    qb1:aggregationType "Sum" ;
    qb1:sourceAttribute "ATT060" ;
    qb1:sourceColumn "acv_usd" ;
    qb1:sourceTable "quotetobooking.fact_bookings" ;
    rdfs:comment "Annualized contract value in U.S. dollars used for recurring revenue analysis." ;
    rdfs:domain qb1:BookingFact ;
    rdfs:range xsd:decimal .

qb1:aggregationType a owl:AnnotationProperty ;
    rdfs:label "aggregation type" .

qb1:autoRenewFlag a owl:DatatypeProperty ;
    rdfs:label "auto renew flag" ;
    qb1:sourceAttribute "ATT004" ;
    qb1:sourceColumn "auto_renew_flag" ;
    qb1:sourceTable "quotetobooking.dim_contract" ;
    rdfs:comment "Indicator showing whether the contract is configured to renew automatically." ;
    rdfs:domain qb1:ContractDimension ;
    rdfs:range xsd:string .

qb1:bookingAmountUSD a owl:DatatypeProperty ;
    rdfs:label "booking amount USD" ;
    qb1:aggregationType "Sum" ;
    qb1:sourceAttribute "ATT059" ;
    qb1:sourceColumn "booking_amount_usd" ;
    qb1:sourceTable "quotetobooking.fact_bookings" ;
    rdfs:comment "Total booked revenue amount in U.S. dollars for the transaction." ;
    rdfs:domain qb1:BookingFact ;
    rdfs:range xsd:decimal .

qb1:bookingContractKey a owl:DatatypeProperty ;
    rdfs:label "booking contract key" ;
    qb1:sourceAttribute "ATT053" ;
    qb1:sourceColumn "contract_key" ;
    qb1:sourceTable "quotetobooking.fact_bookings" ;
    rdfs:comment "Reference to the contract or commercial agreement associated with the booking." ;
