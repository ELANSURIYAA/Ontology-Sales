    rdfs:label "source table" .

qb1:tcvUSD a owl:DatatypeProperty ;
    rdfs:label "total contract value USD" ;
    qb1:aggregationType "Sum" ;
    qb1:sourceAttribute "ATT061" ;
    qb1:sourceColumn "tcv_usd" ;
    qb1:sourceTable "quotetobooking.fact_bookings" ;
    rdfs:comment "Total contract value in U.S. dollars over the full contract term." ;
    rdfs:domain qb1:BookingFact ;
    rdfs:range xsd:decimal .

qb1:technologyDomain a owl:DatatypeProperty ;
    rdfs:label "technology domain" ;
    qb1:sourceAttribute "ATT035" ;
    qb1:sourceColumn "technology_domain" ;
    qb1:sourceTable "quotetobooking.dim_product" ;
    rdfs:comment "Technology area to which the product belongs, such as networking, security, or collaboration." ;
    rdfs:domain qb1:ProductDimension ;
    rdfs:range xsd:string .

qb1:termMonths a owl:DatatypeProperty ;
    rdfs:label "contract term months" ;
    qb1:sourceAttribute "ATT003" ;
    qb1:sourceColumn "term_months" ;
    qb1:sourceTable "quotetobooking.dim_contract" ;
    rdfs:comment "Number of months covered by the contract or service agreement." ;
    rdfs:domain qb1:ContractDimension ;
    rdfs:range xsd:integer .

qb1:theater a owl:DatatypeProperty ;
    rdfs:label "theater" ;
    qb1:sourceAttribute "ATT023" ;
    qb1:sourceColumn "theater" ;
    qb1:sourceTable "quotetobooking.dim_geography" ;
    rdfs:comment "Sales theater or sub-region used for operational reporting within a region." ;
    rdfs:domain qb1:GeographyDimension ;
    rdfs:range xsd:string .

qb1:unitListPriceUSD a owl:DatatypeProperty ;
    rdfs:label "unit list price USD" ;
    qb1:aggregationType "Average" ;
    qb1:sourceAttribute "ATT057" ;
    qb1:sourceColumn "unit_list_price_usd" ;
    qb1:sourceTable "quotetobooking.fact_bookings" ;
    rdfs:comment "Standard list price per unit in U.S. dollars before discounts." ;
    rdfs:domain qb1:BookingFact ;
    rdfs:range xsd:decimal .

qb1:validationWarning a owl:AnnotationProperty ;
    rdfs:label "validation warning" .

qb1:DomainConcept a owl:Class ;
    rdfs:label "Domain Concept" ;
    rdfs:comment "Top-level abstract business concept used to organize the ontology class hierarchy." ;
    rdfs:subClassOf owl:Thing .

qb1:TransactionEntity a owl:Class ;
    rdfs:label "Transaction Entity" ;
    rdfs:comment "Superclass for transactional entities recording business events and related measures." ;
    rdfs:subClassOf qb1:BusinessEntity .

qb1:hasContractDimension a owl:ObjectProperty ;
    rdfs:label "has contract dimension" ;
    qb1:sourceRelationship "REL001" ;
    rdfs:comment "Associates a booking transaction with the contract or commercial agreement used to classify it." ;
    rdfs:domain qb1:BookingFact ;
    rdfs:range qb1:ContractDimension ;
    owl:inverseOf qb1:isContractDimensionOf .

qb1:hasCustomerDimension a owl:ObjectProperty ;
    rdfs:label "has customer dimension" ;
    qb1:sourceRelationship "REL002" ;
    rdfs:comment "Associates a booking transaction with the customer that placed the order." ;
    rdfs:domain qb1:BookingFact ;
    rdfs:range qb1:CustomerDimension ;
    owl:inverseOf qb1:isCustomerDimensionOf .

qb1:hasDateDimension a owl:ObjectProperty ;
    rdfs:label "has date dimension" ;
    qb1:sourceRelationship "REL003" ;
    rdfs:comment "Associates a booking transaction with the reporting date on which it was recorded." ;
    rdfs:domain qb1:BookingFact ;
    rdfs:range qb1:DateDimension ;
    owl:inverseOf qb1:isDateDimensionOf .

qb1:hasGeographyDimension a owl:ObjectProperty ;
    rdfs:label "has geography dimension" ;
    qb1:sourceRelationship "REL004" ;
    rdfs:comment "Associates a booking transaction with the geography used for regional analysis." ;
    rdfs:domain qb1:BookingFact ;
    rdfs:range qb1:GeographyDimension ;
    owl:inverseOf qb1:isGeographyDimensionOf .

qb1:hasPartnerDimension a owl:ObjectProperty ;
    rdfs:label "has partner dimension" ;
    qb1:sourceRelationship "REL005" ;
    rdfs:comment "Associates a booking transaction with the partner involved in fulfillment or transaction routing." ;
    rdfs:domain qb1:BookingFact ;
    rdfs:range qb1:PartnerDimension ;
    owl:inverseOf qb1:isPartnerDimensionOf .

qb1:hasProductDimension a owl:ObjectProperty ;
    rdfs:label "has product dimension" ;
    qb1:sourceRelationship "REL006" ;
    rdfs:comment "Associates a booking transaction with the product or offer being booked." ;
    rdfs:domain qb1:BookingFact ;
    rdfs:range qb1:ProductDimension ;
    owl:inverseOf qb1:isProductDimensionOf .

qb1:hasSalesRepresentativeDimension a owl:ObjectProperty ;
    rdfs:label "has sales representative dimension" ;
    qb1:sourceRelationship "REL007" ;
    rdfs:comment "Associates a booking transaction with the sales representative responsible for the booking." ;
    rdfs:domain qb1:BookingFact ;
    rdfs:range qb1:SalesRepresentativeDimension ;
    owl:inverseOf qb1:isSalesRepresentativeDimensionOf .

qb1:isContractDimensionOf a owl:ObjectProperty ;
    rdfs:label "is contract dimension of" ;
    rdfs:comment "Inverse relation indicating the bookings classified by a contract dimension record." ;
    rdfs:domain qb1:ContractDimension ;
    rdfs:range qb1:BookingFact .

qb1:isCustomerDimensionOf a owl:ObjectProperty ;
    rdfs:label "is customer dimension of" ;
    rdfs:comment "Inverse relation indicating the bookings associated with a customer dimension record." ;
    rdfs:domain qb1:CustomerDimension ;
    rdfs:range qb1:BookingFact .

qb1:isDateDimensionOf a owl:ObjectProperty ;
    rdfs:label "is date dimension of" ;
    rdfs:comment "Inverse relation indicating the bookings associated with a date dimension record." ;
    rdfs:domain qb1:DateDimension ;
    rdfs:range qb1:BookingFact .

qb1:isGeographyDimensionOf a owl:ObjectProperty ;
    rdfs:label "is geography dimension of" ;
    rdfs:comment "Inverse relation indicating the bookings associated with a geography dimension record." ;
    rdfs:domain qb1:GeographyDimension ;
    rdfs:range qb1:BookingFact .

qb1:isPartnerDimensionOf a owl:ObjectProperty ;
    rdfs:label "is partner dimension of" ;
    rdfs:comment "Inverse relation indicating the bookings associated with a partner dimension record." ;
    rdfs:domain qb1:PartnerDimension ;
    rdfs:range qb1:BookingFact .

qb1:isProductDimensionOf a owl:ObjectProperty ;
    rdfs:label "is product dimension of" ;
    rdfs:comment "Inverse relation indicating the bookings associated with a product dimension record." ;
    rdfs:domain qb1:ProductDimension ;
    rdfs:range qb1:BookingFact .

qb1:isSalesRepresentativeDimensionOf a owl:ObjectProperty ;
    rdfs:label "is sales representative dimension of" ;
    rdfs:comment "Inverse relation indicating the bookings associated with a sales representative dimension record." ;
    rdfs:domain qb1:SalesRepresentativeDimension ;
    rdfs:range qb1:BookingFact .

qb1:BusinessEntity a owl:Class ;
    rdfs:label "Business Entity" ;
    rdfs:comment "Abstract superclass for all business entities represented in the semantic model." ;
    rdfs:subClassOf qb1:DomainConcept .

qb1:DimensionEntity a owl:Class ;
    rdfs:label "Dimension Entity" ;
    rdfs:comment "Superclass for dimensional master data entities used to classify and analyze transactions." ;
    rdfs:subClassOf qb1:BusinessEntity .

qb1:GeographyDimension a owl:Class ;
    rdfs:label "Geography Dimension" ;
    qb1:businessDefinition "Stores geographic attributes used to analyze bookings by region, theater, and country." ;
    qb1:businessDomain "Geography" ;
    qb1:sourceEntity "ENT004" ;
    qb1:sourceTable "quotetobooking.dim_geography" ;
    rdfs:comment "Stores geographic attributes used to analyze bookings by region, theater, and country." ;
    rdfs:subClassOf qb1:DimensionEntity .

qb1:ContractDimension a owl:Class ;
    rdfs:label "Contract Dimension" ;
    qb1:businessDefinition "Stores contract and service agreement attributes used to classify bookings by contract type, term, renewal behavior, and coverage level." ;
    qb1:businessDomain "Contract Management" ;
    qb1:sourceEntity "ENT001" ;
    qb1:sourceTable "quotetobooking.dim_contract" ;
    rdfs:comment "Stores contract and service agreement attributes used to classify bookings by contract type, term, renewal behavior, and coverage level." ;
    rdfs:subClassOf qb1:DimensionEntity .

qb1:PartnerDimension a owl:Class ;
    rdfs:label "Partner Dimension" ;
    qb1:businessDefinition "Stores channel partner attributes used to analyze bookings by partner identity, partner type, partner tier, and route to market." ;
    qb1:businessDomain "Partner Management" ;
    qb1:sourceEntity "ENT005" ;
    qb1:sourceTable "quotetobooking.dim_partner" ;
    rdfs:comment "Stores channel partner attributes used to analyze bookings by partner identity, partner type, partner tier, and route to market." ;
    rdfs:subClassOf qb1:DimensionEntity .

qb1:SalesRepresentativeDimension a owl:Class ;
    rdfs:label "Sales Representative Dimension" ;
    qb1:businessDefinition "Stores sales representative attributes used to analyze bookings by sales person, role, team, and market segment coverage." ;
    qb1:businessDomain "Sales Organization" ;
    qb1:sourceEntity "ENT007" ;
    qb1:sourceTable "quotetobooking.dim_sales_rep" ;
    rdfs:comment "Stores sales representative attributes used to analyze bookings by sales person, role, team, and market segment coverage." ;
    rdfs:subClassOf qb1:DimensionEntity .

qb1:DateDimension a owl:Class ;
    rdfs:label "Date Dimension" ;
    qb1:businessDefinition "Stores calendar and fiscal date attributes used to analyze bookings across time periods, fiscal years, quarters, and months." ;
    qb1:businessDomain "Time Management" ;
    qb1:sourceEntity "ENT003" ;
    qb1:sourceTable "quotetobooking.dim_date" ;
    rdfs:comment "Stores calendar and fiscal date attributes used to analyze bookings across time periods, fiscal years, quarters, and months." ;
    rdfs:subClassOf qb1:DimensionEntity .

qb1:ProductDimension a owl:Class ;
    rdfs:label "Product Dimension" ;
    qb1:businessDefinition "Stores product and offer attributes used to analyze bookings by product identity, family, technology domain, offer type, and business entity." ;
    qb1:businessDomain "Product Management" ;
    qb1:sourceEntity "ENT006" ;
    qb1:sourceTable "quotetobooking.dim_product" ;
    rdfs:comment "Stores product and offer attributes used to analyze bookings by product identity, family, technology domain, offer type, and business entity." ;
    rdfs:subClassOf qb1:DimensionEntity .

qb1:CustomerDimension a owl:Class ;
    rdfs:label "Customer Dimension" ;
    qb1:businessDefinition "Stores descriptive customer attributes used to analyze bookings by customer identity, segment, industry, account tier, and headquarters location." ;
    qb1:businessDomain "Customer Management" ;
    qb1:sourceEntity "ENT002" ;
    qb1:sourceTable "quotetobooking.dim_customer" ;
    rdfs:comment "Stores descriptive customer attributes used to analyze bookings by customer identity, segment, industry, account tier, and headquarters location." ;
    rdfs:subClassOf qb1:DimensionEntity .

qb1:BookingFact a owl:Class ;
    rdfs:label "Booking Fact" ;
    qb1:businessDefinition "Stores individual booking transactions and their financial measures for analyzing sales performance across customers, products, partners, geographies, contracts, sales representatives, and time." ;
    qb1:businessDomain "Sales Transactions" ;
    qb1:sourceEntity "ENT008" ;
    qb1:sourceTable "quotetobooking.fact_bookings" ;
    rdfs:comment "Stores individual booking transactions and their financial measures for analyzing sales performance across customers, products, partners, geographies, contracts, sales representatives, and time." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom qb1:CustomerDimension ;
            owl:onProperty qb1:hasCustomerDimension ],
        [ a owl:Restriction ;
            owl:allValuesFrom qb1:SalesRepresentativeDimension ;
            owl:onProperty qb1:hasSalesRepresentativeDimension ],
        [ a owl:Restriction ;
            owl:allValuesFrom qb1:PartnerDimension ;
            owl:onProperty qb1:hasPartnerDimension ],
        [ a owl:Restriction ;
            owl:allValuesFrom qb1:DateDimension ;
            owl:onProperty qb1:hasDateDimension ],
        [ a owl:Restriction ;
            owl:allValuesFrom qb1:ContractDimension ;
            owl:onProperty qb1:hasContractDimension ],
        [ a owl:Restriction ;
            owl:allValuesFrom qb1:GeographyDimension ;
            owl:onProperty qb1:hasGeographyDimension ],
        [ a owl:Restriction ;
            owl:allValuesFrom qb1:ProductDimension ;
            owl:onProperty qb1:hasProductDimension ],
        qb1:TransactionEntity .

[] a owl:AllDisjointClasses ;
    owl:members ( qb1:ContractDimension qb1:CustomerDimension qb1:DateDimension qb1:GeographyDimension qb1:PartnerDimension qb1:ProductDimension qb1:SalesRepresentativeDimension qb1:BookingFact ) .
