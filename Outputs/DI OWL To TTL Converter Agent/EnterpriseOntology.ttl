@prefix eo: <http://example.org/enterprise-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/enterprise-ontology> a owl:Ontology ;
    rdfs:label "Enterprise Sales Booking Ontology"@en ;
    rdfs:comment "OWL 2 ontology generated from the OSI Semantic Model for Sales Bookings and Revenue Analytics. The business process document could not be parsed from the repository input, so ontology content is based only on the readable OSI Semantic Model. Validation warnings implicit in the source include an unreadable business process document and the absence of an explicit semantic relationship from Booking Transaction to Sales Representative in narrative form beyond referential metadata. No individuals were created because none were explicitly provided."@en ;
    owl:versionInfo "1.0.0" .

eo:accountTier a owl:DatatypeProperty ;
    rdfs:label "account tier" ;
    rdfs:comment "Identifies the strategic importance or service tier of the customer account." ;
    rdfs:domain eo:Customer ;
    rdfs:range xsd:string .

eo:acvUSD a owl:DatatypeProperty ;
    rdfs:label "annual contract value USD" ;
    rdfs:comment "Annualized value of the contract associated with the booking in U.S. dollars." ;
    rdfs:domain eo:BookingTransaction ;
    rdfs:range xsd:decimal .

eo:autoRenewFlag a owl:DatatypeProperty ;
    rdfs:label "auto renew indicator" ;
    rdfs:comment "Indicates whether the contract is configured to renew automatically." ;
    rdfs:domain eo:Contract ;
    rdfs:range xsd:string .

eo:bookingAmountUSD a owl:DatatypeProperty ;
    rdfs:label "booking amount USD" ;
    rdfs:comment "Total booked sales value recognized for the transaction in U.S. dollars." ;
    rdfs:domain eo:BookingTransaction ;
    rdfs:range xsd:decimal .

eo:bookingId a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "booking ID" ;
    rdfs:comment "Unique identifier for the booking transaction record." ;
    rdfs:domain eo:BookingTransaction ;
    rdfs:range xsd:integer .

eo:bookingType a owl:DatatypeProperty ;
    rdfs:label "booking type" ;
    rdfs:comment "Indicates whether the booking is a new sale or a renewal." ;
    rdfs:domain eo:BookingTransaction ;
    rdfs:range xsd:string .

eo:businessEntity a owl:DatatypeProperty ;
    rdfs:label "business entity" ;
    rdfs:comment "Identifies the internal business unit or portfolio associated with the product." ;
    rdfs:domain eo:Product ;
    rdfs:range xsd:string .

eo:calendarYear a owl:DatatypeProperty ;
    rdfs:label "calendar year" ;
    rdfs:comment "Four-digit calendar year associated with the date." ;
    rdfs:domain eo:Date ;
    rdfs:range xsd:integer .

eo:contractKey a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "contract key" ;
    rdfs:comment "Surrogate key that uniquely identifies a contract record in the contract dimension." ;
    rdfs:domain eo:Contract ;
    rdfs:range xsd:integer .

eo:contractType a owl:DatatypeProperty ;
    rdfs:label "contract type" ;
    rdfs:comment "Indicates the type of commercial agreement or service contract associated with the booking, such as SaaS Subscription or Enterprise Agreement." ;
    rdfs:domain eo:Contract ;
    rdfs:range xsd:string .

eo:country a owl:DatatypeProperty ;
    rdfs:label "country" ;
    rdfs:comment "Country associated with the geography record for booking analysis." ;
    rdfs:domain eo:Geography ;
    rdfs:range xsd:string .

eo:coverageLevel a owl:DatatypeProperty ;
    rdfs:label "coverage level" ;
    rdfs:comment "Describes the support, service, or entitlement coverage level provided under the contract." ;
    rdfs:domain eo:Contract ;
    rdfs:range xsd:string .

eo:customerId a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "customer ID" ;
    rdfs:comment "Business identifier assigned to the customer account." ;
    rdfs:domain eo:Customer ;
    rdfs:range xsd:string .

eo:customerKey a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "customer key" ;
    rdfs:comment "Surrogate key that uniquely identifies a customer record in the customer dimension." ;
    rdfs:domain eo:Customer ;
    rdfs:range xsd:integer .

eo:customerName a owl:DatatypeProperty ;
    rdfs:label "customer name" ;
    rdfs:comment "Name of the customer organization associated with the booking." ;
    rdfs:domain eo:Customer ;
    rdfs:range xsd:string .

eo:dateKey a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "date key" ;
    rdfs:comment "Encoded key that uniquely identifies a date record in the date dimension." ;
    rdfs:domain eo:Date ;
    rdfs:range xsd:integer .

eo:discountPercentage a owl:DatatypeProperty ;
    rdfs:label "discount percentage" ;
    rdfs:comment "Discount applied to the list price for the booking transaction." ;
    rdfs:domain eo:BookingTransaction ;
    rdfs:range xsd:decimal .

eo:fiscalPeriodSequence a owl:DatatypeProperty ;
    rdfs:label "fiscal period sequence" ;
    rdfs:comment "Sequential number representing the order of the fiscal period in the reporting calendar." ;
    rdfs:domain eo:Date ;
    rdfs:range xsd:integer .

eo:fiscalQuarter a owl:DatatypeProperty ;
    rdfs:label "fiscal quarter" ;
    rdfs:comment "Fiscal quarter used for reporting and period-based business analysis." ;
    rdfs:domain eo:Date ;
    rdfs:range xsd:string .

eo:fiscalYear a owl:DatatypeProperty ;
    rdfs:label "fiscal year" ;
    rdfs:comment "Fiscal year used for business reporting and performance analysis." ;
    rdfs:domain eo:Date ;
    rdfs:range xsd:string .

eo:fullDate a owl:DatatypeProperty ;
    rdfs:label "full date" ;
    rdfs:comment "Calendar date represented by the date dimension record." ;
    rdfs:domain eo:Date ;
    rdfs:range xsd:date .

eo:geographyKey a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "geography key" ;
    rdfs:comment "Surrogate key that uniquely identifies a geography record in the geography dimension." ;
    rdfs:domain eo:Geography ;
    rdfs:range xsd:integer .

eo:headquartersCountry a owl:DatatypeProperty ;
    rdfs:label "headquarters country" ;
    rdfs:comment "Country where the customer’s headquarters is located." ;
    rdfs:domain eo:Customer ;
    rdfs:range xsd:string .

eo:headquartersRegion a owl:DatatypeProperty ;
    rdfs:label "headquarters region" ;
    rdfs:comment "Region where the customer’s headquarters is located, such as Americas, EMEA, or APJC." ;
    rdfs:domain eo:Customer ;
    rdfs:range xsd:string .

eo:industry a owl:DatatypeProperty ;
    rdfs:label "industry" ;
    rdfs:comment "Indicates the customer’s industry classification for business analysis." ;
    rdfs:domain eo:Customer ;
    rdfs:range xsd:string .

eo:isRenewal a owl:DatatypeProperty ;
    rdfs:label "renewal indicator" ;
    rdfs:comment "Indicates whether the booking transaction represents a renewal event." ;
    rdfs:domain eo:BookingTransaction ;
    rdfs:range xsd:integer .

eo:monthName a owl:DatatypeProperty ;
    rdfs:label "month name" ;
    rdfs:comment "Name of the calendar month for the date." ;
    rdfs:domain eo:Date ;
    rdfs:range xsd:string .

eo:offerType a owl:DatatypeProperty ;
    rdfs:label "offer type" ;
    rdfs:comment "Indicates whether the offering is hardware, software subscription, or SaaS subscription." ;
    rdfs:domain eo:Product ;
    rdfs:range xsd:string .

eo:orderLineNumber a owl:DatatypeProperty ;
    rdfs:label "order line number" ;
    rdfs:comment "Line number within the order associated with the booking transaction." ;
    rdfs:domain eo:BookingTransaction ;
    rdfs:range xsd:integer .

eo:orderNumber a owl:DatatypeProperty ;
    rdfs:label "order number" ;
    rdfs:comment "Business order number associated with the booking transaction." ;
    rdfs:domain eo:BookingTransaction ;
    rdfs:range xsd:string .

eo:partnerId a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "partner ID" ;
    rdfs:comment "Business identifier assigned to the partner organization." ;
    rdfs:domain eo:Partner ;
    rdfs:range xsd:string .

eo:partnerKey a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "partner key" ;
    rdfs:comment "Surrogate key that uniquely identifies a partner record in the partner dimension." ;
    rdfs:domain eo:Partner ;
    rdfs:range xsd:integer .

eo:partnerName a owl:DatatypeProperty ;
    rdfs:label "partner name" ;
    rdfs:comment "Name of the partner organization involved in the sale or fulfillment process." ;
    rdfs:domain eo:Partner ;
    rdfs:range xsd:string .

eo:partnerTier a owl:DatatypeProperty ;
    rdfs:label "partner tier" ;
    rdfs:comment "Indicates the partner’s program tier or accreditation level." ;
    rdfs:domain eo:Partner ;
    rdfs:range xsd:string .

eo:partnerType a owl:DatatypeProperty ;
    rdfs:label "partner type" ;
    rdfs:comment "Classifies the partner by business role, such as distributor, reseller, systems integrator, or direct." ;
    rdfs:domain eo:Partner ;
    rdfs:range xsd:string .

eo:productFamily a owl:DatatypeProperty ;
    rdfs:label "product family" ;
    rdfs:comment "Groups related products into a common family for portfolio analysis." ;
    rdfs:domain eo:Product ;
    rdfs:range xsd:string .

eo:productId a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "product ID" ;
    rdfs:comment "Business identifier or SKU assigned to the product or offering." ;
    rdfs:domain eo:Product ;
    rdfs:range xsd:string .

eo:productKey a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "product key" ;
    rdfs:comment "Surrogate key that uniquely identifies a product record in the product dimension." ;
    rdfs:domain eo:Product ;
    rdfs:range xsd:integer .

eo:productName a owl:DatatypeProperty ;
    rdfs:label "product name" ;
    rdfs:comment "Name of the product, solution, or subscription offering." ;
    rdfs:domain eo:Product ;
    rdfs:range xsd:string .

eo:quantity a owl:DatatypeProperty ;
    rdfs:label "quantity sold" ;
    rdfs:comment "Number of units, licenses, or service quantities included in the booking." ;
    rdfs:domain eo:BookingTransaction ;
    rdfs:range xsd:integer .

eo:region a owl:DatatypeProperty ;
    rdfs:label "sales region" ;
    rdfs:comment "High-level geographic region used for business reporting and sales analysis." ;
    rdfs:domain eo:Geography ;
    rdfs:range xsd:string .

eo:repId a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "sales representative ID" ;
    rdfs:comment "Business identifier assigned to the sales representative." ;
    rdfs:domain eo:SalesRepresentative ;
    rdfs:range xsd:string .

eo:repName a owl:DatatypeProperty ;
    rdfs:label "sales representative name" ;
    rdfs:comment "Full name of the sales representative responsible for the customer relationship or sale." ;
    rdfs:domain eo:SalesRepresentative ;
    rdfs:range xsd:string .

eo:routeToMarket a owl:DatatypeProperty ;
    rdfs:label "route to market" ;
    rdfs:comment "Describes the sales channel path through which the offering reaches the customer." ;
    rdfs:domain eo:Partner ;
    rdfs:range xsd:string .

eo:salesRepKey a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "sales representative key" ;
    rdfs:comment "Surrogate key that uniquely identifies a sales representative record in the sales representative dimension." ;
    rdfs:domain eo:SalesRepresentative ;
    rdfs:range xsd:integer .

eo:salesRole a owl:DatatypeProperty ;
    rdfs:label "sales role" ;
    rdfs:comment "Job role or selling responsibility of the sales representative." ;
    rdfs:domain eo:SalesRepresentative ;
    rdfs:range xsd:string .

eo:salesTeam a owl:DatatypeProperty ;
    rdfs:label "sales team" ;
    rdfs:comment "Team or organizational unit to which the sales representative belongs." ;
    rdfs:domain eo:SalesRepresentative ;
    rdfs:range xsd:string .

eo:segment a owl:DatatypeProperty ;
    rdfs:label "customer segment" ;
    rdfs:comment "Classifies the customer into a business segment such as Enterprise, Service Provider, or Public Sector." ;
    rdfs:domain eo:Customer ;
    rdfs:range xsd:string .

eo:segmentCovered a owl:DatatypeProperty ;
    rdfs:label "covered segment" ;
    rdfs:comment "Customer segment for which the sales representative is responsible." ;
    rdfs:domain eo:SalesRepresentative ;
    rdfs:range xsd:string .

eo:tcvUSD a owl:DatatypeProperty ;
    rdfs:label "total contract value USD" ;
    rdfs:comment "Total contract value associated with the booking in U.S. dollars over the contract term." ;
    rdfs:domain eo:BookingTransaction ;
    rdfs:range xsd:decimal .

eo:technologyDomain a owl:DatatypeProperty ;
    rdfs:label "technology domain" ;
    rdfs:comment "Identifies the technology area associated with the product, such as networking, security, or collaboration." ;
    rdfs:domain eo:Product ;
    rdfs:range xsd:string .

eo:termMonths a owl:DatatypeProperty ;
    rdfs:label "contract term months" ;
    rdfs:comment "Specifies the duration of the contract in months." ;
    rdfs:domain eo:Contract ;
    rdfs:range xsd:integer .

eo:theater a owl:DatatypeProperty ;
    rdfs:label "sales theater" ;
    rdfs:comment "Intermediate geographic sales area within a region used for operational reporting." ;
    rdfs:domain eo:Geography ;
    rdfs:range xsd:string .

eo:unitListPriceUSD a owl:DatatypeProperty ;
    rdfs:label "unit list price USD" ;
    rdfs:comment "Standard list price per unit in U.S. dollars before discounts." ;
    rdfs:domain eo:BookingTransaction ;
    rdfs:range xsd:decimal .

skos:definition a owl:AnnotationProperty .

eo:isContractOfBookingTransaction a owl:ObjectProperty ;
    rdfs:label "is contract of booking transaction" ;
    rdfs:domain eo:Contract ;
    rdfs:range eo:BookingTransaction ;
    owl:inverseOf eo:hasContract .

eo:isCustomerOfBookingTransaction a owl:ObjectProperty ;
    rdfs:label "is customer of booking transaction" ;
    rdfs:domain eo:Customer ;
    rdfs:range eo:BookingTransaction ;
    owl:inverseOf eo:hasCustomer .

eo:isDateOfBookingTransaction a owl:ObjectProperty ;
    rdfs:label "is date of booking transaction" ;
    rdfs:domain eo:Date ;
    rdfs:range eo:BookingTransaction ;
    owl:inverseOf eo:hasBookingDate .

eo:isGeographyOfBookingTransaction a owl:ObjectProperty ;
    rdfs:label "is geography of booking transaction" ;
    rdfs:domain eo:Geography ;
    rdfs:range eo:BookingTransaction ;
    owl:inverseOf eo:hasGeography .

eo:isPartnerOfBookingTransaction a owl:ObjectProperty ;
    rdfs:label "is partner of booking transaction" ;
    rdfs:domain eo:Partner ;
    rdfs:range eo:BookingTransaction ;
    owl:inverseOf eo:hasPartner .

eo:isProductOfBookingTransaction a owl:ObjectProperty ;
    rdfs:label "is product of booking transaction" ;
    rdfs:domain eo:Product ;
    rdfs:range eo:BookingTransaction ;
    owl:inverseOf eo:hasProduct .

eo:isSalesRepresentativeOfBookingTransaction a owl:ObjectProperty ;
    rdfs:label "is sales representative of booking transaction" ;
    rdfs:domain eo:SalesRepresentative ;
    rdfs:range eo:BookingTransaction ;
    owl:inverseOf eo:hasSalesRepresentative .

eo:hasBookingDate a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has booking date" ;
    rdfs:comment "Links a booking transaction to its reporting date." ;
    rdfs:domain eo:BookingTransaction ;
    rdfs:range eo:Date ;
    owl:inverseOf eo:isDateOfBookingTransaction .

eo:hasContract a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has contract" ;
    rdfs:comment "Links a booking transaction to the contract dimension record associated with that booking." ;
    rdfs:domain eo:BookingTransaction ;
    rdfs:range eo:Contract ;
    owl:inverseOf eo:isContractOfBookingTransaction .

eo:hasCustomer a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has customer" ;
    rdfs:comment "Links a booking transaction to the customer associated with the booking." ;
    rdfs:domain eo:BookingTransaction ;
    rdfs:range eo:Customer ;
    owl:inverseOf eo:isCustomerOfBookingTransaction .

eo:hasGeography a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has geography" ;
    rdfs:comment "Links a booking transaction to the sales geography used for analysis." ;
    rdfs:domain eo:BookingTransaction ;
    rdfs:range eo:Geography ;
    owl:inverseOf eo:isGeographyOfBookingTransaction .

eo:hasPartner a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has partner" ;
    rdfs:comment "Links a booking transaction to the partner involved in the sale or fulfillment process." ;
    rdfs:domain eo:BookingTransaction ;
    rdfs:range eo:Partner ;
    owl:inverseOf eo:isPartnerOfBookingTransaction .

eo:hasProduct a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has product" ;
    rdfs:comment "Links a booking transaction to the product or offering that was booked." ;
    rdfs:domain eo:BookingTransaction ;
    rdfs:range eo:Product ;
    owl:inverseOf eo:isProductOfBookingTransaction .

eo:hasSalesRepresentative a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has sales representative" ;
    rdfs:comment "Links a booking transaction to the sales representative responsible for the customer relationship or sale." ;
    rdfs:domain eo:BookingTransaction ;
    rdfs:range eo:SalesRepresentative ;
    owl:inverseOf eo:isSalesRepresentativeOfBookingTransaction .

eo:Geography a owl:Class ;
    rdfs:label "Geography" ;
    rdfs:comment "Stores geographic attributes used to analyze bookings across sales regions, theaters, and countries." .

eo:Contract a owl:Class ;
    rdfs:label "Contract" ;
    rdfs:comment "Stores the contractual attributes associated with a booking, including agreement type, duration, renewal behavior, and support or service coverage level." .

eo:Partner a owl:Class ;
    rdfs:label "Partner" ;
    rdfs:comment "Stores partner master data used to analyze indirect and direct sales activity by partner identity, partner type, tier, and route to market." .

eo:SalesRepresentative a owl:Class ;
    rdfs:label "Sales Representative" ;
    rdfs:comment "Stores sales representative attributes used to analyze bookings by individual seller, role, team, and covered segment." .

eo:Date a owl:Class ;
    rdfs:label "Date" ;
    rdfs:comment "Stores calendar and fiscal date attributes used to analyze bookings over time and support period-based reporting." .

eo:Product a owl:Class ;
    rdfs:label "Product" ;
    rdfs:comment "Stores product master data used to analyze bookings by product identity, family, technology domain, offer type, and business entity." .

eo:Customer a owl:Class ;
    rdfs:label "Customer" ;
    rdfs:comment "Stores customer master data used to analyze bookings by customer identity, market segment, industry, account tier, and headquarters location." .

eo:BookingTransaction a owl:Class ;
    rdfs:label "Booking Transaction" ;
    rdfs:comment "Stores individual completed sales booking transactions and their associated financial measures, linked to customer, product, partner, geography, sales representative, contract, and date dimensions." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass eo:Date ;
            owl:onProperty eo:hasBookingDate ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass eo:Product ;
            owl:onProperty eo:hasProduct ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass eo:Contract ;
            owl:onProperty eo:hasContract ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass eo:Partner ;
            owl:onProperty eo:hasPartner ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass eo:Customer ;
            owl:onProperty eo:hasCustomer ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass eo:Geography ;
            owl:onProperty eo:hasGeography ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass eo:SalesRepresentative ;
            owl:onProperty eo:hasSalesRepresentative ] ;
    skos:definition "Stores individual completed sales booking transactions and their associated financial measures, linked to customer, product, partner, geography, sales representative, contract, and date dimensions." .

[] a owl:AllDisjointClasses ;
    owl:members ( eo:Contract eo:Customer eo:Date eo:Geography eo:Partner eo:Product eo:SalesRepresentative eo:BookingTransaction ) .

